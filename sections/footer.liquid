{% comment %}
  Naview commercial footer for Shopify Horizon.
  Replace the contents of sections/footer.liquid with this file.

  This section intentionally keeps Horizon's dynamic footer blocks so the
  existing email signup remains editable. Horizon's separate footer-utilities
  section can continue to handle copyright, policies, social links and payment
  icons without creating duplicates.
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign total_blocks = section.blocks.size
  assign grid_columns = total_blocks | at_most: 4
  assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
  assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1
  assign has_isolated_grid_item_desktop = false
  assign has_isolated_grid_item_tablet = false

  if total_blocks > 4 and last_row_count == 1
    assign has_isolated_grid_item_desktop = true
  endif

  if total_blocks == 5
    assign has_isolated_grid_item_tablet = true
  endif

  assign model_fallback_url = routes.all_products_collection_url
  if model_fallback_url == blank
    assign model_fallback_url = routes.root_url
  endif

  assign support_email = section.settings.contact_email
  if support_email == blank
    assign support_email = shop.email
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<footer
  class="nv-footer section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --nv-footer-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --nv-footer-text: {{ section.settings.text_color }};
    --nv-footer-muted: {{ section.settings.muted_color }};
    --nv-footer-accent: {{ section.settings.accent_color }};
    --nv-footer-border: {{ section.settings.border_color }};
  "
>
  <div
    class="nv-footer__inner spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% if section.settings.show_trust %}
      <div class="nv-footer__trust" role="list" aria-label="Store benefits">
        <div class="nv-footer__trust-item" role="listitem">
          <span class="nv-footer__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 3 4.5 6v5.4c0 4.6 3 7.7 7.5 9.6 4.5-1.9 7.5-5 7.5-9.6V6L12 3Z"/>
              <path d="m8.5 12 2.2 2.2 4.8-5"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_1 | escape }}</span>
        </div>

        <div class="nv-footer__trust-item" role="listitem">
          <span class="nv-footer__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M7 4.5h10v15H7z"/>
              <path d="M9.5 8h5M9.5 11.5h5M9.5 15h3"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_2 | escape }}</span>
        </div>

        <div class="nv-footer__trust-item" role="listitem">
          <span class="nv-footer__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 13v-1a7 7 0 0 1 14 0v1"/>
              <path d="M5 12H3.8A1.8 1.8 0 0 0 2 13.8v2.4A1.8 1.8 0 0 0 3.8 18H6v-6H5ZM19 12h1.2a1.8 1.8 0 0 1 1.8 1.8v2.4a1.8 1.8 0 0 1-1.8 1.8H18v-6h1ZM18 18c-.7 2-2.2 3-4.5 3"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_3 | escape }}</span>
        </div>

        <div class="nv-footer__trust-item" role="listitem">
          <span class="nv-footer__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="4" y="10" width="16" height="11" rx="2"/>
              <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_4 | escape }}</span>
        </div>
      </div>
    {% endif %}

    <div class="nv-footer__main">
      <div class="nv-footer__brand">
        <a class="nv-footer__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 480
              | image_tag:
                class: 'nv-footer__logo',
                loading: 'lazy',
                widths: '120, 180, 240, 360, 480',
                sizes: '(min-width: 990px) 190px, 160px',
                alt: section.settings.brand_name
            }}
          {% else %}
            <span class="nv-footer__wordmark">{{ section.settings.brand_name | escape }}</span>
          {% endif %}
        </a>

        <div class="nv-footer__brand-copy">
          {{ section.settings.brand_text }}
        </div>

        {% if section.settings.cta_label != blank %}
          <a
            class="nv-footer__cta"
            href="{{ section.settings.cta_link | default: model_fallback_url }}"
          >
            <span>{{ section.settings.cta_label | escape }}</span>
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="m7 4 6 6-6 6"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <nav class="nv-footer__column" aria-label="{{ section.settings.models_heading | escape }}">
        <h2 class="nv-footer__heading">{{ section.settings.models_heading | escape }}</h2>
        <ul class="nv-footer__links" role="list">
          <li>
            <a href="{{ section.settings.rav4_link | default: model_fallback_url }}"> Toyota RAV4 </a>
          </li>
          <li>
            <a href="{{ section.settings.crv_link | default: model_fallback_url }}"> Honda CR-V </a>
          </li>
          <li>
            <a href="{{ section.settings.nx_link | default: model_fallback_url }}"> Lexus NX </a>
          </li>
          <li>
            <a href="{{ section.settings.f150_link | default: model_fallback_url }}"> Ford F-150 </a>
          </li>
          <li>
            <a class="nv-footer__view-all" href="{{ section.settings.all_models_link | default: model_fallback_url }}">
              {{ section.settings.all_models_label | escape }}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </nav>

      <nav class="nv-footer__column" aria-label="{{ section.settings.help_heading | escape }}">
        <h2 class="nv-footer__heading">{{ section.settings.help_heading | escape }}</h2>
        <ul class="nv-footer__links" role="list">
          {% if section.settings.help_menu != blank %}
            {% for link in section.settings.help_menu.links %}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {% endfor %}
          {% else %}
            <li>
              <a href="{{ section.settings.cta_link | default: model_fallback_url }}"> Vehicle Compatibility </a>
            </li>

            {% if section.settings.install_link != blank %}
              <li><a href="{{ section.settings.install_link }}">Installation Guide</a></li>
            {% endif %}

            {% if shop.shipping_policy != blank %}
              <li><a href="{{ shop.shipping_policy.url }}">Shipping &amp; Delivery</a></li>
            {% endif %}

            {% if shop.refund_policy != blank %}
              <li><a href="{{ shop.refund_policy.url }}">Returns &amp; Refunds</a></li>
            {% endif %}

            {% if section.settings.warranty_link != blank %}
              <li><a href="{{ section.settings.warranty_link }}">Warranty</a></li>
            {% endif %}

            {% if section.settings.faq_link != blank %}
              <li><a href="{{ section.settings.faq_link }}">FAQ</a></li>
            {% endif %}
          {% endif %}
        </ul>
      </nav>

      <div class="nv-footer__column nv-footer__contact">
        <h2 class="nv-footer__heading">{{ section.settings.contact_heading | escape }}</h2>

        {% if support_email != blank %}
          <a class="nv-footer__contact-row" href="mailto:{{ support_email | escape }}">
            <span class="nv-footer__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="3" y="5" width="18" height="14" rx="2"/>
                <path d="m4 7 8 6 8-6"/>
              </svg>
            </span>
            <span>
              <small>Email support</small>
              <strong>{{ support_email | escape }}</strong>
            </span>
          </a>
        {% endif %}

        {% if section.settings.whatsapp_link != blank %}
          <a
            class="nv-footer__contact-row"
            href="{{ section.settings.whatsapp_link }}"
            target="_blank"
            rel="noopener"
          >
            <span class="nv-footer__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4.1A8 8 0 1 1 20 11.6Z"/>
                <path d="M9 8.5c.4 2.7 1.8 4.1 4.5 5.2M9.2 8.2 8.4 9.4M13.8 13.7l-1.1 1"/>
              </svg>
            </span>
            <span>
              <small>Fast assistance</small>
              <strong>{{ section.settings.whatsapp_label | escape }}</strong>
            </span>
          </a>
        {% endif %}

        {% if section.settings.support_hours != blank %}
          <p class="nv-footer__contact-note">{{ section.settings.support_hours | escape }}</p>
        {% endif %}

        {% if section.settings.shipping_note != blank %}
          <p class="nv-footer__contact-note">{{ section.settings.shipping_note | escape }}</p>
        {% endif %}
      </div>
    </div>

    {% if total_blocks > 0 %}
      <div class="nv-footer__newsletter-wrap">
        <div
          class="
            footer-content
            {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
            {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
          "
          style="
            --footer-gap: {{ section.settings.gap }}px;
            --grid-columns: {{ grid_columns }};
            --last-row-count: {{ last_row_count }};
            --tablet-last-row-count: {{ tablet_last_row_count }};
          "
        >
          {% content_for 'blocks' %}
        </div>
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .nv-footer {
    position: relative;
    background: var(--nv-footer-bg);
    color: var(--nv-footer-text);
  }

  .nv-footer *,
  .nv-footer *::before,
  .nv-footer *::after {
    box-sizing: border-box;
  }

  .nv-footer__inner {
    width: 100%;
  }

  .nv-footer__trust {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--nv-footer-border);
  }

  .nv-footer__trust-item {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 22px;
    color: var(--nv-footer-text);
    font-size: 14px;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-align: left;
  }

  .nv-footer__trust-item + .nv-footer__trust-item {
    border-inline-start: 1px solid var(--nv-footer-border);
  }

  .nv-footer__trust-icon,
  .nv-footer__contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    color: var(--nv-footer-accent);
  }

  .nv-footer__trust-icon {
    width: 30px;
    height: 30px;
  }

  .nv-footer__trust-icon svg,
  .nv-footer__contact-icon svg,
  .nv-footer__cta svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nv-footer__main {
    display: grid;
    grid-template-columns: minmax(250px, 1.35fr) repeat(3, minmax(150px, 0.8fr));
    gap: clamp(32px, 5vw, 76px);
    padding-block: clamp(50px, 6vw, 82px);
  }

  .nv-footer__brand {
    max-width: 360px;
  }

  .nv-footer__brand-link {
    display: inline-flex;
    color: var(--nv-footer-text);
    text-decoration: none;
  }

  .nv-footer__logo {
    display: block;
    width: auto;
    max-width: 190px;
    max-height: 62px;
    object-fit: contain;
    object-position: left center;
  }

  .nv-footer__wordmark {
    font-size: clamp(27px, 2.6vw, 38px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .nv-footer__brand-copy {
    max-width: 330px;
    margin-block-start: 22px;
    color: var(--nv-footer-muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .nv-footer__brand-copy > :first-child {
    margin-block-start: 0;
  }

  .nv-footer__brand-copy > :last-child {
    margin-block-end: 0;
  }

  .nv-footer__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    margin-block-start: 26px;
    padding: 0 20px;
    border: 1px solid var(--nv-footer-accent);
    border-radius: 999px;
    color: var(--nv-footer-accent);
    font-size: 13px;
    font-weight: 750;
    letter-spacing: 0.055em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .nv-footer__cta svg {
    width: 17px;
    height: 17px;
    transition: transform 180ms ease;
  }

  .nv-footer__cta:hover {
    color: #ffffff;
    background: var(--nv-footer-accent);
    transform: translateY(-1px);
  }

  .nv-footer__cta:hover svg {
    transform: translateX(2px);
  }

  .nv-footer__heading {
    margin: 0 0 22px;
    color: var(--nv-footer-text);
    font-size: 14px;
    line-height: 1.3;
    font-weight: 760;
    letter-spacing: 0.085em;
    text-transform: uppercase;
  }

  .nv-footer__links {
    display: grid;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nv-footer__links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--nv-footer-muted);
    font-size: 14px;
    line-height: 1.5;
    text-decoration: none;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .nv-footer__links a:hover {
    color: var(--nv-footer-accent);
    transform: translateX(2px);
  }

  .nv-footer__links .nv-footer__view-all {
    margin-block-start: 5px;
    color: var(--nv-footer-accent);
    font-weight: 700;
  }

  .nv-footer__contact {
    min-width: 0;
  }

  .nv-footer__contact-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-block-end: 18px;
    color: var(--nv-footer-text);
    text-decoration: none;
  }

  .nv-footer__contact-icon {
    width: 22px;
    height: 22px;
    margin-block-start: 2px;
  }

  .nv-footer__contact-row span:last-child {
    min-width: 0;
  }

  .nv-footer__contact-row small,
  .nv-footer__contact-row strong {
    display: block;
  }

  .nv-footer__contact-row small {
    margin-block-end: 3px;
    color: var(--nv-footer-muted);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nv-footer__contact-row strong {
    overflow-wrap: anywhere;
    font-size: 13px;
    line-height: 1.45;
    font-weight: 670;
  }

  .nv-footer__contact-row:hover strong {
    color: var(--nv-footer-accent);
  }

  .nv-footer__contact-note {
    margin: 10px 0 0;
    color: var(--nv-footer-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .nv-footer__newsletter-wrap {
    padding-block: clamp(30px, 4vw, 48px);
    border-block-start: 1px solid var(--nv-footer-border);
  }

  .nv-footer .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: center;
  }

  .nv-footer .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-footer__cta,
    .nv-footer__cta svg,
    .nv-footer__links a {
      transition: none;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .nv-footer__trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nv-footer__trust-item:nth-child(3) {
      border-inline-start: 0;
      border-block-start: 1px solid var(--nv-footer-border);
    }

    .nv-footer__trust-item:nth-child(4) {
      border-block-start: 1px solid var(--nv-footer-border);
    }

    .nv-footer__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nv-footer__brand {
      max-width: 520px;
    }

    .nv-footer .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .nv-footer .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .nv-footer .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .nv-footer .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    .nv-footer .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .nv-footer .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .nv-footer__trust {
      grid-template-columns: 1fr 1fr;
    }

    .nv-footer__trust-item {
      min-height: 70px;
      justify-content: flex-start;
      padding: 14px;
      font-size: 12px;
    }

    .nv-footer__trust-item:nth-child(3) {
      border-inline-start: 0;
      border-block-start: 1px solid var(--nv-footer-border);
    }

    .nv-footer__trust-item:nth-child(4) {
      border-block-start: 1px solid var(--nv-footer-border);
    }

    .nv-footer__trust-icon {
      width: 25px;
      height: 25px;
    }

    .nv-footer__main {
      grid-template-columns: 1fr;
      gap: 38px;
      padding-block: 48px;
    }

    .nv-footer__brand {
      max-width: none;
      padding-block-end: 8px;
    }

    .nv-footer__brand-copy {
      max-width: 500px;
    }

    .nv-footer__heading {
      margin-block-end: 17px;
    }

    .nv-footer__newsletter-wrap {
      padding-block: 30px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Naview footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
