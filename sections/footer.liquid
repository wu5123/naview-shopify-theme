    },
    {
      "type": "header",
      "content": "Shop by model"
    },
    {
      "type": "text",
      "id": "models_heading",
      "label": "Heading",
      "default": "Shop by model"
    },
    {
      "type": "url",
      "id": "rav4_link",
      "label": "Toyota RAV4 link"
    },
    {
      "type": "url",
      "id": "crv_link",
      "label": "Honda CR-V link"
    },
    {
      "type": "url",
      "id": "nx_link",
      "label": "Lexus NX link"
    },
    {
      "type": "url",
      "id": "f150_link",
      "label": "Ford F-150 link"
    },
    {
