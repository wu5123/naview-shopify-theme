      "default": "View all models"
    },
    {
      "type": "url",
      "id": "all_models_link",
      "label": "View all link"
    },
    {
      "type": "header",
      "content": "Customer care"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Heading",
      "default": "Customer care"
    },
    {
      "type": "link_list",
      "id": "help_menu",
      "label": "Customer care menu"
    },
    {
      "type": "url",
      "id": "install_link",
      "label": "Installation guide link"
    },
    {
      "type": "url",
      "id": "warranty_link",
