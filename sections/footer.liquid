{% comment %}
  Naview commercial footer for Shopify Horizon.
  Replace the contents of sections/footer.liquid with this file.

  This section intentionally keeps Horizon's dynamic footer blocks so the
  existing email signup remains editable. Horizon's separate footer-utilities
  section can continue to handle copyright, policies, social links and payment
  icons without creating duplicates.
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign total_blocks = section.blocks.size
  assign grid_columns = total_blocks | at_most: 4
  assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
  assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1
  assign has_isolated_grid_item_desktop = false
  assign has_isolated_grid_item_tablet = false

  if total_blocks > 4 and last_row_count == 1
    assign has_isolated_grid_item_desktop = true
  endif

  if total_blocks == 5
    assign has_isolated_grid_item_tablet = true
  endif

  assign model_fallback_url = routes.all_products_collection_url
  if model_fallback_url == blank
    assign model_fallback_url = routes.root_url
  endif

  assign vehicle_request_url = '/pages/vehicle-request'
  assign model_cards_url = routes.root_url | append: '#naview-models'
  assign whatsapp_url = 'https://wa.me/16137969403'
  assign instagram_url = section.settings.instagram_link | default: settings.social_instagram_link
  assign youtube_url = section.settings.youtube_link | default: settings.social_youtube_link
  assign facebook_url = section.settings.facebook_link | default: settings.social_facebook_link
  assign tiktok_url = section.settings.tiktok_link | default: settings.social_tiktok_link

  assign support_email = section.settings.contact_email
  if support_email == blank
    assign support_email = shop.email
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<footer
  class="nv-footer section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --nv-footer-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --nv-footer-text: {{ section.settings.text_color }};
    --nv-footer-muted: {{ section.settings.muted_color }};
    --nv-footer-accent: {{ section.settings.accent_color }};
    --nv-footer-border: {{ section.settings.border_color }};
  "
>
  <div
    class="nv-footer__inner spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="nv-footer__fitment">
      <span class="nv-footer__fitment-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6.5"/>
          <path d="m16 16 4 4"/>
        </svg>
      </span>

      <div class="nv-footer__fitment-copy">
        <h2 class="nv-footer__fitment-title">Not sure which mirror fits your vehicle?</h2>
        <p class="nv-footer__fitment-text">Tell us your model and we'll help you find the right fit.</p>
      </div>

      <div class="nv-footer__fitment-actions">
        <a class="nv-footer__fitment-request" href="{{ vehicle_request_url }}">
          <span>Can't find your vehicle?</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          class="nv-footer__fitment-whatsapp"
          href="{{ whatsapp_url }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contact us on WhatsApp"
        >
          <svg class="nv-footer__whatsapp-logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          <span>Contact Us</span>
        </a>
      </div>
    </div>

    {% if section.settings.show_trust %}
      <div class="nv-footer__trust" role="list" aria-label="Store benefits">
        <div class="nv-footer__trust-item" role="listitem">
          <span class="nv-footer__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 3 4.5 6v5.4c0 4.6 3 7.7 7.5 9.6 4.5-1.9 7.5-5 7.5-9.6V6L12 3Z"/>
              <path d="m8.5 12 2.2 2.2 4.8-5"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_1 | escape }}</span>
        </div>

        <div class="nv-footer__trust-item" role="listitem">
          <span class="nv-footer__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M7 4.5h10v15H7z"/>
              <path d="M9.5 8h5M9.5 11.5h5M9.5 15h3"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_2 | escape }}</span>
        </div>

        <div class="nv-footer__trust-item" role="listitem">
          <span class="nv-footer__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 13v-1a7 7 0 0 1 14 0v1"/>
              <path d="M5 12H3.8A1.8 1.8 0 0 0 2 13.8v2.4A1.8 1.8 0 0 0 3.8 18H6v-6H5ZM19 12h1.2a1.8 1.8 0 0 1 1.8 1.8v2.4a1.8 1.8 0 0 1-1.8 1.8H18v-6h1ZM18 18c-.7 2-2.2 3-4.5 3"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_3 | escape }}</span>
        </div>

        <div class="nv-footer__trust-item" role="listitem">
          <span class="nv-footer__trust-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="4" y="10" width="16" height="11" rx="2"/>
              <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/>
            </svg>
          </span>
          <span>{{ section.settings.trust_4 | escape }}</span>
        </div>
      </div>
    {% endif %}

    <div class="nv-footer__main">
      <div class="nv-footer__brand">
        <a class="nv-footer__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 480
              | image_tag:
                class: 'nv-footer__logo',
                loading: 'lazy',
                widths: '120, 180, 240, 360, 480',
                sizes: '(min-width: 990px) 190px, 160px',
                alt: section.settings.brand_name
            }}
          {% else %}
            <span class="nv-footer__wordmark">{{ section.settings.brand_name | escape }}</span>
          {% endif %}
        </a>

        <div class="nv-footer__brand-copy">
          {{ section.settings.brand_text }}
        </div>

        <div class="nv-footer__socials" aria-label="Naview social media">
          <a
            class="nv-footer__social-link"
            {% if instagram_url != blank %}
              href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg>
          </a>

          <a
            class="nv-footer__social-link"
            {% if youtube_url != blank %}
              href="{{ youtube_url }}" target="_blank" rel="noopener noreferrer"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            aria-label="YouTube"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>

          <a
            class="nv-footer__social-link"
            {% if facebook_url != blank %}
              href="{{ facebook_url }}" target="_blank" rel="noopener noreferrer"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
          </a>

          <a
            class="nv-footer__social-link"
            {% if tiktok_url != blank %}
              href="{{ tiktok_url }}" target="_blank" rel="noopener noreferrer"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            aria-label="TikTok"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
        </div>
      </div>

      <nav class="nv-footer__column" aria-label="{{ section.settings.models_heading | escape }}">
        <h2 class="nv-footer__heading">{{ section.settings.models_heading | escape }}</h2>
        <ul class="nv-footer__links" role="list">
          <li><a href="{{ section.settings.rav4_link | default: model_fallback_url }}">Toyota RAV4</a></li>
          <li><a href="{{ section.settings.crv_link | default: model_fallback_url }}">Honda CR-V</a></li>
          <li><a href="{{ section.settings.nx_link | default: model_fallback_url }}">Lexus NX</a></li>
          <li><a href="{{ section.settings.f150_link | default: model_fallback_url }}">Ford F-150</a></li>
          <li>
            <a class="nv-footer__view-all" href="{{ model_cards_url }}">
              {{ section.settings.all_models_label | escape }}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </nav>

      <nav class="nv-footer__column" aria-label="Help & Support">
        <h2 class="nv-footer__heading">Help &amp; Support</h2>
        <ul class="nv-footer__links" role="list">
          {% if section.settings.help_menu != blank %}
            {% for link in section.settings.help_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ vehicle_request_url }}">Vehicle Compatibility</a></li>
            {% if section.settings.install_link != blank %}
              <li><a href="{{ section.settings.install_link }}">Installation Guide</a></li>
            {% endif %}
            {% if shop.shipping_policy != blank %}
              <li><a href="{{ shop.shipping_policy.url }}">Shipping &amp; Delivery</a></li>
            {% endif %}
            {% if shop.refund_policy != blank %}
              <li><a href="{{ shop.refund_policy.url }}">Returns &amp; Refunds</a></li>
            {% endif %}
            {% if section.settings.warranty_link != blank %}
              <li><a href="{{ section.settings.warranty_link }}">Warranty</a></li>
            {% endif %}
            {% if section.settings.faq_link != blank %}
              <li><a href="{{ section.settings.faq_link }}">FAQ</a></li>
            {% endif %}
          {% endif %}
        </ul>
      </nav>

      <div class="nv-footer__column nv-footer__loop">
        <h2 class="nv-footer__heading">Stay in the loop</h2>
        <p class="nv-footer__loop-text">
          {{ section.settings.stay_loop_text | default: 'Product updates, installation tips, and new vehicle releases.' | escape }}
        </p>

        {% form 'customer', class: 'nv-footer__signup-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="nv-footer__signup-fields">
            <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
            <input
              id="FooterEmail-{{ section.id }}"
              class="nv-footer__signup-input"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="Email address"
              required
            >
            <button class="nv-footer__signup-button" type="submit">Subscribe</button>
          </div>
          {% if form.posted_successfully? %}
            <p class="nv-footer__form-message" role="status">Thanks for subscribing.</p>
          {% endif %}
          {% if form.errors %}
            <div class="nv-footer__form-message nv-footer__form-message--error">{{ form.errors | default_errors }}</div>
          {% endif %}
        {% endform %}

        {% if support_email != blank %}
          <a class="nv-footer__loop-email" href="mailto:{{ support_email | escape }}">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="m4 7 8 6 8-6"/>
            </svg>
            <span>Email: {{ support_email | escape }}</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}

  .nv-footer {
    position: relative;
    background: #ffffff !important;
    color: #1f1f1f;
    font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
  }

  .nv-footer *,
  .nv-footer *::before,
  .nv-footer *::after {
    box-sizing: border-box;
  }

  .nv-footer__inner {
    width: 100%;
    max-width: 1480px;
    margin: 0 auto;
  }

  .nv-footer__fitment {
    display: grid;
    grid-template-columns: auto minmax(260px, 1fr) auto;
    align-items: center;
    gap: 18px 28px;
    padding: 30px 0;
    border: 0;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .nv-footer__fitment-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 0;
    color: #1f1f1f;
    background: transparent;
  }

  .nv-footer__fitment-icon svg {
    width: 27px;
    height: 27px;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nv-footer__fitment-title {
    margin: 0;
    color: #1f1f1f;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: 0;
  }

  .nv-footer__fitment-text {
    margin: 5px 0 0;
    color: #6b6b6b;
    font-size: 13px;
    line-height: 1.55;
  }

  .nv-footer__fitment-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
  }

  .nv-footer__fitment-request {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    color: #1f1f1f;
    font-size: 13px;
    line-height: 1.35;
    font-weight: 500;
    white-space: nowrap;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 180ms ease;
  }

  .nv-footer__fitment-request:hover {
    color: #6b6b6b;
  }

  .nv-footer__fitment-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-width: 132px;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid #1f1f1f;
    border-radius: 0;
    color: #ffffff;
    background: #1f1f1f;
    box-shadow: none;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease, background-color 180ms ease;
  }

  .nv-footer__fitment-whatsapp:hover {
    border-color: #434343;
    color: #ffffff;
    background: #434343;
    box-shadow: none;
    transform: none;
  }

  .nv-footer__whatsapp-logo {
    width: 19px;
    height: 19px;
    fill: currentColor;
    stroke: none;
    flex: 0 0 auto;
  }

  .nv-footer__trust {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block-start: 0;
    border: 0;
    border-bottom: 1px solid #e5e5e5;
    border-radius: 0;
    overflow: visible;
    background: transparent;
  }

  .nv-footer__trust-item {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    padding: 14px 22px;
    color: #333333;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    text-align: left;
  }

  .nv-footer__trust-item + .nv-footer__trust-item {
    border-inline-start: 1px solid #e5e5e5;
  }

  .nv-footer__trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    flex: 0 0 auto;
    color: #1f1f1f;
  }

  .nv-footer__trust-icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nv-footer__main {
    display: grid;
    grid-template-columns: minmax(220px, 1.35fr) repeat(2, minmax(145px, 0.8fr)) minmax(248px, 1.05fr);
    gap: clamp(32px, 4.6vw, 72px);
    padding-block: clamp(48px, 5vw, 72px);
  }

  .nv-footer__brand {
    max-width: 290px;
  }

  .nv-footer__brand-link {
    display: inline-flex;
    color: #1f1f1f;
    text-decoration: none;
  }

  .nv-footer__logo {
    display: block;
    width: auto;
    max-width: 145px;
    max-height: 42px;
    object-fit: contain;
    object-position: left center;
  }

  .nv-footer__wordmark {
    color: #1f1f1f;
    font-size: 26px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .nv-footer__brand-copy {
    max-width: 280px;
    margin-block-start: 17px;
    color: #6b6b6b;
    font-size: 13px;
    line-height: 1.6;
  }

  .nv-footer__brand-copy > :first-child {
    margin-block-start: 0;
  }

  .nv-footer__brand-copy > :last-child {
    margin-block-end: 0;
  }

  .nv-footer__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 17px;
    margin-block-start: 22px;
  }

  .nv-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 21px;
    height: 21px;
    border: 0;
    border-radius: 0;
    color: #1f1f1f;
    background: transparent;
    text-decoration: none;
    transition: color 170ms ease;
  }

  .nv-footer__social-link svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .nv-footer__social-link[href]:hover {
    color: #777777;
    border-color: transparent;
    background: transparent;
    transform: none;
  }

  .nv-footer__social-link[aria-disabled='true'] {
    cursor: default;
    opacity: 0.4;
  }

  .nv-footer__heading {
    margin: 0 0 18px;
    color: #1f1f1f;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .nv-footer__links {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nv-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #6b6b6b;
    font-size: 13px;
    line-height: 1.45;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .nv-footer__links a:hover {
    color: #1f1f1f;
    transform: none;
  }

  .nv-footer__links .nv-footer__view-all {
    margin-block-start: 4px;
    color: #1f1f1f;
    font-weight: 500;
  }

  .nv-footer__loop {
    min-width: 0;
  }

  .nv-footer__loop-text {
    max-width: 290px;
    margin: -2px 0 16px;
    color: #6b6b6b;
    font-size: 13px;
    line-height: 1.6;
  }

  .nv-footer__signup-form {
    margin: 0;
  }

  .nv-footer__signup-fields {
    display: flex;
    width: 100%;
    min-height: 43px;
    border: 1px solid #a8a8a8;
    border-radius: 0;
    overflow: hidden;
    background: #ffffff;
    transition: border-color 170ms ease;
  }

  .nv-footer__signup-fields:focus-within {
    border-color: #1f1f1f;
    box-shadow: none;
  }

  .nv-footer__signup-input {
    min-width: 0;
    width: 100%;
    min-height: 41px;
    padding: 0 13px;
    border: 0;
    outline: 0;
    color: #1f1f1f;
    background: transparent;
    font: inherit;
    font-size: 13px;
  }

  .nv-footer__signup-input::placeholder {
    color: #8b8b8b;
  }

  .nv-footer__signup-button {
    min-height: 41px;
    padding: 0 16px;
    border: 0;
    color: #ffffff;
    background: #1f1f1f;
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
    transition: background-color 170ms ease;
  }

  .nv-footer__signup-button:hover {
    background: #434343;
  }

  .nv-footer__form-message {
    margin: 9px 0 0;
    color: #6b6b6b;
    font-size: 12px;
    line-height: 1.5;
  }

  .nv-footer__form-message--error {
    color: #b42318;
  }

  .nv-footer__form-message ul {
    margin: 0;
    padding-inline-start: 18px;
  }

  .nv-footer__loop-email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block-start: 17px;
    color: #6b6b6b;
    font-size: 13px;
    line-height: 1.45;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 160ms ease;
  }

  .nv-footer__loop-email svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: #1f1f1f;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nv-footer__loop-email:hover {
    color: #1f1f1f;
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-footer__fitment-request,
    .nv-footer__fitment-whatsapp,
    .nv-footer__social-link,
    .nv-footer__links a,
    .nv-footer__signup-button,
    .nv-footer__loop-email {
      transition: none;
    }
  }

  @media screen and (min-width: 1200px) {
    .nv-footer__fitment {
      grid-template-columns: auto minmax(300px, 1fr) auto;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .nv-footer__fitment {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .nv-footer__fitment-actions {
      grid-column: 2;
      justify-content: flex-start;
    }

    .nv-footer__trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nv-footer__trust-item:nth-child(3) {
      border-inline-start: 0;
      border-block-start: 1px solid #e5e5e5;
    }

    .nv-footer__trust-item:nth-child(4) {
      border-block-start: 1px solid #e5e5e5;
    }

    .nv-footer__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nv-footer__brand {
      max-width: 420px;
    }
  }

  @media screen and (max-width: 749px) {
    .nv-footer__fitment {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 14px;
      padding: 23px 0;
    }

    .nv-footer__fitment-icon {
      width: 30px;
      height: 30px;
    }

    .nv-footer__fitment-icon svg {
      width: 24px;
      height: 24px;
    }

    .nv-footer__fitment-title {
      font-size: 15px;
    }

    .nv-footer__fitment-text {
      font-size: 12px;
    }

    .nv-footer__fitment-actions {
      grid-column: 1 / -1;
      justify-content: space-between;
      gap: 15px;
    }

    .nv-footer__fitment-request {
      min-height: 40px;
      font-size: 12px;
    }

    .nv-footer__fitment-whatsapp {
      min-width: 120px;
      min-height: 40px;
      padding-inline: 14px;
      font-size: 12px;
    }

    .nv-footer__trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nv-footer__trust-item {
      min-height: 64px;
      gap: 8px;
      padding: 12px 8px;
      font-size: 11px;
    }

    .nv-footer__trust-item:nth-child(3) {
      border-inline-start: 0;
      border-block-start: 1px solid #e5e5e5;
    }

    .nv-footer__trust-item:nth-child(4) {
      border-block-start: 1px solid #e5e5e5;
    }

    .nv-footer__trust-icon {
      width: 21px;
      height: 21px;
    }

    .nv-footer__main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 34px 22px;
      padding-block: 42px 46px;
    }

    .nv-footer__brand,
    .nv-footer__loop {
      grid-column: 1 / -1;
      max-width: none;
    }

    .nv-footer__brand-copy,
    .nv-footer__loop-text {
      max-width: 420px;
    }

    .nv-footer__heading {
      margin-block-end: 15px;
      font-size: 13px;
    }

    .nv-footer__links {
      gap: 10px;
    }

    .nv-footer__links a {
      font-size: 12px;
    }

    .nv-footer__signup-fields {
      max-width: 420px;
    }
  }

  @media screen and (max-width: 389px) {
    .nv-footer__fitment-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .nv-footer__fitment-whatsapp {
      width: 100%;
    }
  }

{% endstylesheet %}

