{% liquid
  assign rav4_product = section.settings.rav4_product
  if rav4_product == blank and product != blank
    assign rav4_product = product
  endif
  if rav4_product == blank and collection.products.first != blank
    assign rav4_product = collection.products.first
  endif
  assign standard_variant = rav4_product.variants[0]
  assign install_variant = rav4_product.variants[1] | default: standard_variant
  assign default_vehicle_image = images['toyota-rav4-2026.png']
  assign gallery_1 = section.settings.gallery_1 | default: default_vehicle_image
  assign option_1_image = section.settings.option_image_1 | default: gallery_1
  assign option_2_image = section.settings.option_image_2 | default: gallery_1
%}

<section class="rav4-store" data-rav4="{{ section.id }}">
  <div class="rav4-store__product">
    <div class="rav4-gallery">
      <div class="rav4-media-window">
        <div class="rav4-media-panel is-active" data-media-panel="photos">
          <div class="rav4-gallery__stage">
            {% if gallery_1 != blank %}
              {{ gallery_1 | image_url: width: 1800 | image_tag: class: 'rav4-gallery__hero', loading: 'eager', widths: '720, 1080, 1440, 1800', sizes: '(min-width: 990px) 58vw, 100vw', alt: 'Toyota RAV4 custom-fit digital rear mirror' }}
            {% else %}
              <div class="rav4-gallery__empty"><strong>Toyota RAV4</strong><span>Upload the primary product image</span></div>
            {% endif %}
            <button class="rav4-gallery__arrow rav4-gallery__arrow--prev" type="button" aria-label="Previous photo" data-gallery-prev>‹</button>
            <button class="rav4-gallery__arrow rav4-gallery__arrow--next" type="button" aria-label="Next photo" data-gallery-next>›</button>
            <div class="rav4-gallery__dots" aria-label="Choose product photo">
              {% for i in (1..4) %}
                {% assign key = 'gallery_' | append: i %}
                {% assign gallery_image = section.settings[key] %}
                {% if i == 1 and gallery_image == blank %}{% assign gallery_image = default_vehicle_image %}{% endif %}
                {% if gallery_image != blank %}<button type="button" class="{% if i == 1 %}is-active{% endif %}" data-gallery-dot data-image="{{ gallery_image | image_url: width: 1800 }}" aria-label="Photo {{ i }}"></button>{% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="rav4-media-panel" data-media-panel="video" hidden>
          {% if section.settings.gallery_video != blank %}
            {{ section.settings.gallery_video | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', class: 'rav4-gallery__video' }}
          {% else %}
            <div class="rav4-gallery__video-empty"><span>Product Video</span><small>Upload a product video in the theme editor</small></div>
          {% endif %}
        </div>
      </div>
      <div class="rav4-media-tabs" role="tablist" aria-label="Product media">
        <button class="is-active" type="button" role="tab" aria-selected="true" data-media-tab="photos"><span class="rav4-media-tabs__photo">▣</span> Photos</button>
        <button type="button" role="tab" aria-selected="false" data-media-tab="video"><span class="rav4-media-tabs__play">▶</span> Video</button>
      </div>
    </div>

    <aside class="rav4-buy">
      <div class="rav4-buy__inner">
        <h1>Toyota RAV4</h1>

        <div class="rav4-year">
          <label for="rav4-year-{{ section.id }}">Select Year</label>
          <div class="rav4-select-wrap">
            <select id="rav4-year-{{ section.id }}" data-year>
              <option value="/collections/all?view=rav4">2022–2024</option>
              <option value="{% if section.settings.year_2019_product != blank %}{{ section.settings.year_2019_product.url }}?view=rav4{% else %}/collections/all?view=rav4{% endif %}">2019–2021</option>
              <option value="{% if section.settings.year_2025_product != blank %}{{ section.settings.year_2025_product.url }}?view=rav4{% else %}/collections/all?view=rav4{% endif %}">2025+</option>
            </select>
          </div>
        </div>

        <p class="rav4-price" data-price>CAD $500</p>

        <div class="rav4-info-card">
          <div class="rav4-info-row rav4-info-row--shipping">
            <div class="rav4-info-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32"><path d="M3.5 9.5h15v11h-15zM18.5 13h5.5l4.5 5v2.5h-10z" fill="none"/><circle cx="9" cy="23" r="2.5"/><circle cx="23.5" cy="23" r="2.5"/><path d="M5.5 23h1M11.5 23h9.5M26 23h2"/></svg>
            </div>
            <div class="rav4-info-copy"><p>Free Shipping</p><p>Up to 30-Day Returns</p></div>
            <span class="rav4-info-arrow" aria-hidden="true">›</span>
          </div>
          <div class="rav4-info-divider"></div>
          <div class="rav4-info-row rav4-info-row--specs">
            <div class="rav4-info-icon rav4-info-icon--chip" aria-hidden="true">
              <svg viewBox="0 0 32 32"><rect x="8" y="8" width="16" height="16" rx="1"/><rect x="12" y="12" width="8" height="8" fill="none"/><path d="M11 3v5M16 3v5M21 3v5M11 24v5M16 24v5M21 24v5M3 11h5M3 16h5M3 21h5M24 11h5M24 16h5M24 21h5"/></svg>
            </div>
            <div class="rav4-info-copy rav4-info-copy--specs">
              <p>9.66&quot; IPS Touchscreen With 1920 × 480 Resolution and 1,500-Nit Peak Brightness</p>
              <p>Fully Laminated Display With Touchscreen and Physical Button Controls</p>
              <p>Front 2MP Camera With Automotive-Grade MIS2031 Sensor and 140° Ultra-Wide Lens</p>
              <p>Rear 2MP Camera With Automotive-Grade MIS2031 Sensor and 140° Ultra-Wide Lens</p>
              <p>WDR, 1080P Recording at 25fps, and IP68 Waterproof Protection</p>
            </div>
          </div>
        </div>

        <div class="rav4-options">
          <h2>Select Option</h2>
          <label class="rav4-option is-selected">
            <input type="radio" name="rav4-option-{{ section.id }}" value="{{ standard_variant.id }}" data-option data-price="500" checked>
            <span class="rav4-option__media">{% if option_1_image != blank %}{{ option_1_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '' }}{% else %}<span>Photo</span>{% endif %}</span>
            <span class="rav4-option__copy"><strong>Custom-Fit for Toyota RAV4</strong><b>CAD $500</b><small class="rav4-option__stock">In Stock</small></span>
          </label>
          <label class="rav4-option">
            <input type="radio" name="rav4-option-{{ section.id }}" value="{{ install_variant.id }}" data-option data-price="700">
            <span class="rav4-option__media">{% if option_2_image != blank %}{{ option_2_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '' }}{% else %}<span>Photo</span>{% endif %}</span>
            <span class="rav4-option__copy"><strong>Custom-Fit for Toyota RAV4 + Installation Service</strong><b>CAD $700</b><small class="rav4-option__stock">In Stock</small></span>
          </label>
        </div>
      </div>
    </aside>
  </div>

  <section class="rav4-guide">
    <div class="rav4-content">
      <h2>Installation Guide</h2>
      <div class="rav4-video">
        {% if section.settings.installation_video != blank %}
          {{ section.settings.installation_video | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', class: 'rav4-video__element' }}
          <button class="rav4-video__sound" type="button" hidden data-sound>Turn Sound On</button>
        {% else %}
          <div class="rav4-video__empty"><span>Installation Guide</span><p>Upload your Shopify-hosted installation video in the theme editor.</p></div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="rav4-posters">
    <div class="rav4-content rav4-poster-grid">
      {% for i in (1..6) %}
        {% assign key = 'poster_' | append: i %}
        {% assign poster = section.settings[key] %}
        <div class="rav4-poster rav4-poster--{{ i }}">
          {% if poster != blank %}{{ poster | image_url: width: 1600 | image_tag: loading: 'lazy', alt: 'Toyota RAV4 product feature' }}{% else %}<span>Poster {{ i }}</span>{% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
  <div class="rav4-fixed-buy" data-fixed-buy>
    <div class="rav4-fixed-buy__inner">
      <div class="rav4-fixed-buy__stock">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3.5 9.5h15v11h-15zM18.5 13h5.5l4.5 5v2.5h-10z" fill="none"/><circle cx="9" cy="23" r="2.5"/><circle cx="23.5" cy="23" r="2.5"/><path d="M5.5 23h1M11.5 23h9.5M26 23h2"/></svg>
        <span><strong>In Stock</strong><small>Ready to ship</small></span>
      </div>
      <div class="rav4-fixed-buy__actions">
        <strong data-bar-price>CAD $500</strong>
        <form method="post" action="/cart/add"><input type="hidden" name="id" value="{{ standard_variant.id }}" data-variant><button class="rav4-fixed-buy__cart" type="submit" {% if standard_variant == blank %}disabled{% endif %}>Add to Cart</button></form>
        <form method="post" action="/cart/add"><input type="hidden" name="id" value="{{ standard_variant.id }}" data-variant><input type="hidden" name="return_to" value="/checkout"><button class="rav4-fixed-buy__now" type="submit" {% if standard_variant == blank %}disabled{% endif %}>Buy Now</button></form>
      </div>
    </div>
  </div>
</section>

<style>
  .rav4-store{--ink:#303233;--muted:#6b6f72;--line:#e4e7e9;--soft:#f6f8f9;background:#fff;color:var(--ink);font-family:Arial,"Helvetica Neue",sans-serif}
  .rav4-store *{box-sizing:border-box}
  .rav4-store__product{width:min(1348px,100%);margin:0 auto;display:grid;grid-template-columns:minmax(0,700px) minmax(500px,648px);align-items:start;background:#fff}
  .rav4-gallery{position:sticky;top:0;min-width:0;background:#f4f5f6;height:calc(100vh - 2px);min-height:720px;display:flex;flex-direction:column;justify-content:center;padding:38px 28px 24px}
  .rav4-gallery__stage{position:relative;min-height:0;flex:1;display:grid;place-items:center;overflow:hidden}
  .rav4-gallery__hero{width:100%;height:100%;max-height:690px;object-fit:contain;transition:opacity .2s ease}
  .rav4-gallery__empty{display:flex;flex-direction:column;gap:8px;text-align:center;color:#777}.rav4-gallery__empty strong{font-size:28px;color:#333}
  .rav4-gallery__counter{position:absolute;right:8px;bottom:8px;padding:7px 10px;background:rgba(255,255,255,.88);font-size:12px}
  .rav4-gallery__thumbs{height:82px;display:flex;justify-content:center;gap:10px;margin-top:16px}
  .rav4-gallery__thumb{width:76px;height:76px;border:1px solid transparent;background:#fff;padding:4px;cursor:pointer}.rav4-gallery__thumb.is-active{border:2px solid #0060ef}.rav4-gallery__thumb img{width:100%;height:100%;object-fit:contain}
  .rav4-buy{min-width:0;padding:54px 74px 80px}.rav4-buy__inner{width:500px;max-width:100%}
  .rav4-buy h1{font-size:32px;font-weight:600;line-height:36px;letter-spacing:-.5px;margin:0 0 28px;color:#333}
  .rav4-year label{display:block;margin:0 0 9px;font-size:14px;font-weight:600}
  .rav4-select-wrap{position:relative}.rav4-select-wrap:after{content:"⌄";position:absolute;right:16px;top:50%;transform:translateY(-57%);pointer-events:none}
  .rav4-year select{appearance:none;width:100%;height:50px;border:1px solid #cfd3d5;border-radius:2px;background:#fff;padding:0 44px 0 16px;color:#333;font-size:15px}
  .rav4-price{font-size:26px;line-height:32px;font-weight:600;margin:26px 0 20px}
  .rav4-benefits{height:124px;background:var(--soft);padding:16px;display:grid;grid-template-columns:1fr 1fr;gap:14px 22px;font-size:14px;line-height:20px;margin-bottom:8px}
  .rav4-benefits>div{display:flex;align-items:flex-start;gap:8px}.rav4-benefits__icon{color:#0060ef;font-size:17px;line-height:20px}
  .rav4-specs{background:var(--soft);padding:8px 16px 10px}
  .rav4-specs>div{display:grid;grid-template-columns:28px 1fr;gap:8px;padding:10px 0;border-bottom:1px solid #e2e5e7}.rav4-specs>div:last-child{border:0}
  .rav4-specs span{font-size:11px;color:#85898c;padding-top:3px}.rav4-specs p{font-size:14px;line-height:20px;margin:0;color:#3b3e40}
  .rav4-options{margin-top:32px}.rav4-options h2{font-size:20px;line-height:24px;font-weight:600;margin:0 0 16px}
  .rav4-option{position:relative;min-height:120px;border:1px solid #cfd3d5;padding:20px;display:grid;grid-template-columns:20px 1fr auto;align-items:center;gap:12px;margin:0 0 12px;cursor:pointer;background:#fff}.rav4-option.is-selected{border:2px solid #0060ef;padding:19px}
  .rav4-option input{position:absolute;opacity:0;pointer-events:none}.rav4-option__radio{width:18px;height:18px;border:1px solid #aeb4b8;border-radius:50%;position:relative}.rav4-option.is-selected .rav4-option__radio{border-color:#0060ef}.rav4-option.is-selected .rav4-option__radio:after{content:"";position:absolute;inset:4px;border-radius:50%;background:#0060ef}
  .rav4-option__copy{min-width:0}.rav4-option__copy strong{display:block;font-size:15px;line-height:21px;font-weight:600}.rav4-option__copy small{display:block;color:#74787b;font-size:13px;line-height:18px;margin-top:7px}.rav4-option>b{font-size:15px;white-space:nowrap}
  .rav4-cart{margin-top:20px}.rav4-cart button{width:100%;height:56px;border:0;border-radius:2px;background:#0060ef;color:#fff;font-size:16px;font-weight:600;cursor:pointer}.rav4-cart button:hover{background:#0055d4}.rav4-cart button:disabled{opacity:.45;cursor:not-allowed}
  .rav4-content{width:min(1348px,calc(100% - 48px));margin:0 auto}.rav4-guide{padding:86px 0 28px;background:#fff}.rav4-guide h2{font-size:32px;line-height:40px;text-align:center;margin:0 0 32px;font-weight:600}.rav4-video{position:relative;aspect-ratio:16/7;background:#0a0a0a;overflow:hidden}.rav4-video__element{width:100%;height:100%;object-fit:cover}.rav4-video__empty{height:100%;display:grid;place-content:center;text-align:center;color:#fff}.rav4-video__empty span{font-size:28px;font-weight:600}.rav4-video__empty p{color:#aaa;margin:12px 0 0}.rav4-video__sound{position:absolute;right:20px;bottom:20px;border:0;background:#fff;color:#111;padding:11px 16px;font-weight:600}
  .rav4-posters{padding:0 0 90px;background:#fff}.rav4-poster-grid{height:720px;display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:1fr 1fr;gap:12px}.rav4-poster{background:#f2f4f5;overflow:hidden;display:grid;place-items:center;color:#9a9da0;font-size:14px}.rav4-poster img{width:100%;height:100%;object-fit:cover}.rav4-poster--1{grid-column:span 5;grid-row:span 2}.rav4-poster--2{grid-column:span 4}.rav4-poster--3{grid-column:span 3}.rav4-poster--4{grid-column:span 3}.rav4-poster--5{grid-column:span 2}.rav4-poster--6{grid-column:span 2}
  @media(max-width:989px){.rav4-store__product{display:block}.rav4-gallery{position:relative;height:auto;min-height:520px;padding:24px 16px}.rav4-gallery__stage{height:420px;flex:none}.rav4-buy{padding:34px 24px 64px}.rav4-buy__inner{width:100%}.rav4-content{width:calc(100% - 32px)}.rav4-poster-grid{height:auto;grid-template-columns:1fr 1fr;grid-template-rows:240px 240px 240px}.rav4-poster--1{grid-row:1/3}.rav4-poster--4{grid-column:auto}.rav4-poster--6{display:grid}}
  @media(max-width:560px){.rav4-gallery{min-height:430px}.rav4-gallery__stage{height:330px}.rav4-buy{padding:28px 18px 52px}.rav4-buy h1{font-size:28px;line-height:34px}.rav4-benefits{height:auto;grid-template-columns:1fr}.rav4-option{grid-template-columns:20px 1fr}.rav4-option>b{grid-column:2}.rav4-guide{padding-top:56px}.rav4-guide h2{font-size:27px}.rav4-video{aspect-ratio:16/10}.rav4-poster-grid{grid-template-columns:1fr;grid-template-rows:repeat(6,260px)}.rav4-poster--1{grid-row:auto}.rav4-poster--6{display:grid}}

  .rav4-store{padding-bottom:104px}
  .rav4-gallery{padding:0 28px 20px;background:#fff;justify-content:flex-start}
  .rav4-media-window{flex:1;min-height:0;background:#f4f5f6;display:grid}
  .rav4-media-panel{min-height:0;height:100%}.rav4-media-panel[hidden]{display:none}.rav4-media-panel.is-active{display:block}
  .rav4-gallery__stage{height:100%;min-height:620px;background:#f4f5f6}
  .rav4-gallery__hero{max-height:none;padding:48px;object-fit:contain}
  .rav4-gallery__arrow{position:absolute;top:50%;transform:translateY(-50%);width:54px;height:54px;border:0;border-radius:50%;background:rgba(67,71,82,.48);color:#fff;font-size:38px;line-height:48px;cursor:pointer;z-index:2}.rav4-gallery__arrow--prev{left:24px}.rav4-gallery__arrow--next{right:24px}
  .rav4-gallery__dots{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);display:flex;gap:10px}.rav4-gallery__dots button{width:10px;height:10px;border:0;border-radius:50%;padding:0;background:#c9ccd0}.rav4-gallery__dots button.is-active{background:#25272a}
  .rav4-gallery__thumbs,.rav4-gallery__counter{display:none}
  .rav4-gallery__video,.rav4-gallery__video-empty{width:100%;height:100%;min-height:620px;object-fit:contain;background:#0b0c0d}.rav4-gallery__video-empty{display:grid;place-content:center;text-align:center;color:#fff;gap:9px}.rav4-gallery__video-empty span{font-size:24px}.rav4-gallery__video-empty small{color:#a9adb0}
  .rav4-media-tabs{height:74px;display:flex;align-items:center;justify-content:center;gap:18px;background:#fff}.rav4-media-tabs button{height:46px;border:0;border-radius:25px;background:transparent;color:#3a3d40;padding:0 22px;font-size:17px;display:flex;align-items:center;gap:9px;cursor:pointer}.rav4-media-tabs button.is-active{background:#242628;color:#fff}.rav4-media-tabs__play{font-size:14px}
  .rav4-benefits,.rav4-specs{display:none}
  .rav4-info-card{background:#f4f6f7;border-radius:12px;overflow:hidden;margin-top:8px}
  .rav4-info-row{display:grid;grid-template-columns:34px 1fr 18px;gap:12px;padding:20px 26px}.rav4-info-row--specs{grid-template-columns:34px 1fr;padding-top:22px;padding-bottom:24px}
  .rav4-info-icon{width:28px;height:28px;color:#626669}.rav4-info-icon svg{width:100%;height:100%;stroke:currentColor;stroke-width:1.9;fill:currentColor;stroke-linecap:round;stroke-linejoin:round}.rav4-info-icon--chip svg{stroke-width:1.7}
  .rav4-info-copy p{font-size:15px;line-height:22px;margin:0 0 6px}.rav4-info-copy p:last-child{margin-bottom:0}.rav4-info-copy--specs p{margin-bottom:9px}.rav4-info-arrow{font-size:30px;color:#555;align-self:center}.rav4-info-divider{height:1px;background:#dfe2e4}
  .rav4-options{margin-top:34px}.rav4-options h2{font-size:24px;line-height:30px;margin-bottom:22px}
  .rav4-option,.rav4-option.is-selected{min-height:158px;border:1px solid #d4d7d9;border-radius:10px;padding:20px 22px;display:grid;grid-template-columns:120px 1fr;gap:20px;align-items:center;margin-bottom:12px;background:#fff}
  .rav4-option.is-selected{border:2px solid #006eff;padding:19px 21px}.rav4-option input{position:absolute;opacity:0}.rav4-option__radio{display:none}
  .rav4-option__media{width:112px;height:112px;display:grid;place-items:center;background:#f7f8f9;overflow:hidden;color:#999;font-size:12px}.rav4-option__media img{width:100%;height:100%;object-fit:contain}
  .rav4-option__copy{align-self:stretch;display:flex;flex-direction:column;justify-content:center}.rav4-option__copy strong{font-size:18px;line-height:25px}.rav4-option__copy b{display:block;font-size:17px;line-height:23px;margin-top:8px;font-weight:500}.rav4-option__copy small.rav4-option__stock{display:block;margin-top:auto;padding-top:10px;font-size:14px;line-height:18px;color:#167b42;font-weight:600}
  .rav4-cart{display:none!important}
  .rav4-fixed-buy{position:fixed;left:0;right:0;bottom:0;height:104px;background:#fff;border-top:1px solid #e3e5e7;box-shadow:0 -6px 22px rgba(0,0,0,.07);z-index:1000}
  .rav4-fixed-buy__inner{width:min(1348px,calc(100% - 48px));height:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.rav4-fixed-buy__stock{display:flex;align-items:center;gap:14px}.rav4-fixed-buy__stock svg{width:30px;height:30px;stroke:#626669;stroke-width:1.8;fill:#626669}.rav4-fixed-buy__stock span{display:flex;flex-direction:column;gap:5px}.rav4-fixed-buy__stock strong{font-size:16px}.rav4-fixed-buy__stock small{font-size:13px;color:#6c7073}
