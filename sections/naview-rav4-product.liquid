<script>
  (() => {
    const root = document.querySelector('[data-rav4="{{ section.id }}"]');
    if (!root) return;
    const hero = root.querySelector('.rav4-gallery__hero');
    const dots = [...root.querySelectorAll('[data-gallery-dot]')];
    let photoIndex = 0;
    const showPhoto = (index) => {
      if (!dots.length || !hero) return;
      photoIndex = (index + dots.length) % dots.length;
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === photoIndex));
      hero.style.opacity = '0';
      setTimeout(() => { hero.src = dots[photoIndex].dataset.image; hero.srcset = ''; hero.style.opacity = '1'; }, 130);
    };
    dots.forEach((dot, i) => dot.addEventListener('click', () => showPhoto(i)));
    root.querySelector('[data-gallery-prev]')?.addEventListener('click', () => showPhoto(photoIndex - 1));
    root.querySelector('[data-gallery-next]')?.addEventListener('click', () => showPhoto(photoIndex + 1));
    root.querySelectorAll('[data-media-tab]').forEach((tab) => tab.addEventListener('click', () => {
      const mode = tab.dataset.mediaTab;
      root.querySelectorAll('[data-media-tab]').forEach((item) => { item.classList.toggle('is-active', item === tab); item.setAttribute('aria-selected', item === tab ? 'true' : 'false'); });
      root.querySelectorAll('[data-media-panel]').forEach((panel) => { const active = panel.dataset.mediaPanel === mode; panel.hidden = !active; panel.classList.toggle('is-active', active); });
      const galleryVideo = root.querySelector('.rav4-gallery__video');
      if (galleryVideo) { if (mode === 'video') galleryVideo.play().catch(() => {}); else galleryVideo.pause(); }
    }));
    root.querySelector('[data-year]')?.addEventListener('change', (event) => { window.location.href = event.target.value; });
    root.querySelectorAll('[data-option]').forEach((input) => input.addEventListener('change', () => {
      root.querySelectorAll('.rav4-option').forEach((card) => card.classList.remove('is-selected'));
      input.closest('.rav4-option').classList.add('is-selected');
      root.querySelector('[data-price]').textContent = 'CAD 

