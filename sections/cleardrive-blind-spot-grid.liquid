{% comment %}Cleardrive five-tile comparison and product poster grid.{% endcomment %}

{% assign section_dom_id = 'cleardrive-blind-spot-grid-' | append: section.id %}

<section id="{{ section_dom_id }}" class="cleardrive-blind-spot-grid" aria-label="Cleardrive comparison and product posters">
  <div class="cleardrive-blind-spot-grid__items">
    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-1">
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="{{ 'cleardrive-blind-spot-comparison-mobile.png' | asset_url }}"
          width="1122"
          height="1402"
        >
        <img
          class="cleardrive-blind-spot-grid__image"
          src="{{ 'cleardrive-blind-spot-comparison.png' | asset_url }}"
          alt="A conventional rear-view mirror obstructed by headrests compared with a Cleardrive digital mirror showing a left-rear vehicle"
          width="1254"
          height="1254"
          loading="lazy"
        >
      </picture>

      <div class="cleardrive-blind-spot-grid__blind-copy">
        <h2 class="cleardrive-blind-spot-grid__blind-title">{{ section.settings.blind_poster_title | escape }}</h2>
        <p class="cleardrive-blind-spot-grid__blind-text">{{ section.settings.blind_poster_text | escape | newline_to_br }}</p>
      </div>
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-2">
      <img
        class="cleardrive-blind-spot-grid__image"
        src="{{ 'cleardrive-vehicle-coverage-blueprint.png' | asset_url }}"
        alt="Blueprint-style vehicle coverage illustration for Cleardrive digital rear-view mirrors"
        width="1786"
        height="881"
        loading="lazy"
      >

      <div class="cleardrive-blind-spot-grid__blueprint-copy">
        <h2 class="cleardrive-blind-spot-grid__blueprint-title">{{ section.settings.blueprint_poster_title | escape }}</h2>
        <p class="cleardrive-blind-spot-grid__blueprint-text">{{ section.settings.blueprint_poster_text | escape | newline_to_br }}</p>
      </div>
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-3">
      <img
        class="cleardrive-blind-spot-grid__image"
        src="{{ 'cleardrive-night-split-view-comparison.png' | asset_url }}"
        alt="A conventional rear-view mirror overwhelmed by night glare compared with a clear Cleardrive split-screen display"
        width="1254"
        height="1254"
        loading="lazy"
      >

      <h2 class="cleardrive-blind-spot-grid__night-title">{{ section.settings.night_poster_title | escape }}</h2>
      <div class="cleardrive-blind-spot-grid__night-tags">
        <div>
          <strong>{{ section.settings.night_tag_1_title | escape }}</strong>
          <span>{{ section.settings.night_tag_1_text | escape }}</span>
        </div>
        <div>
          <strong>{{ section.settings.night_tag_2_title | escape }}</strong>
          <span>{{ section.settings.night_tag_2_text | escape }}</span>
        </div>
      </div>
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-4">
      <img
        class="cleardrive-blind-spot-grid__image"
        src="{{ 'cleardrive-rainy-visibility-comparison.png' | asset_url }}"
        alt="Rain-covered conventional side mirror compared with a Cleardrive digital rear-view display in rainy conditions"
        width="1254"
        height="1254"
        loading="lazy"
      >

      <div class="cleardrive-blind-spot-grid__copy">
        <h2 class="cleardrive-blind-spot-grid__title">{{ section.settings.rain_poster_title | escape }}</h2>
        <p class="cleardrive-blind-spot-grid__text">{{ section.settings.rain_poster_text | escape | newline_to_br }}</p>
      </div>
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-5">
      <img
        class="cleardrive-blind-spot-grid__image"
        src="{{ 'cleardrive-anti-glare-product.png' | asset_url }}"
        alt="Cleardrive digital rear-view mirror anti-glare product detail"
        width="1254"
        height="1254"
        loading="lazy"
      >

      <div class="cleardrive-blind-spot-grid__anti-glare-copy">
        <h2 class="cleardrive-blind-spot-grid__anti-glare-title">{{ section.settings.anti_glare_poster_title | escape }}</h2>
        <p class="cleardrive-blind-spot-grid__anti-glare-text">{{ section.settings.anti_glare_poster_text | escape | newline_to_br }}</p>
      </div>
    </article>
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    width: 100%;
    padding: 0;
    background: #ffffff;
  }

  #{{ section_dom_id }} *,
  #{{ section_dom_id }} *::before,
  #{{ section_dom_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__items {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 16px;
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    aspect-ratio: 100 / 33;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 0;
    background: #f3f3f3;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-1 {
    position: relative;
    grid-column: 3;
    grid-row: 2;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-1::after {
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: 0;
    left: 0;
    height: 72%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.72));
    content: "";
    pointer-events: none;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__blind-copy {
    position: absolute;
    z-index: 1;
    right: 12px;
    bottom: 12px;
    left: 12px;
    color: #ffffff;
    text-align: left;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.82);
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__blind-title {
    margin: 0;
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__blind-text {
    margin: 7px 0 0;
    font-size: clamp(10px, 0.75vw, 11px);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-2 {
    position: relative;
    grid-column: 3 / span 2;
    grid-row: 1;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__blueprint-copy {
    position: absolute;
    z-index: 1;
    inset: 0;
    color: #ffffff;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.78);
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__blueprint-title {
    position: absolute;
    top: clamp(14px, 1.3vw, 20px);
    right: clamp(16px, 1.8vw, 26px);
    left: clamp(16px, 1.8vw, 26px);
    margin: 0;
    font-size: clamp(15px, 1.45vw, 20px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__blueprint-text {
    position: absolute;
    right: clamp(16px, 1.8vw, 26px);
    bottom: clamp(14px, 1.5vw, 22px);
    left: clamp(16px, 1.8vw, 26px);
    margin: 0;
    font-size: clamp(11px, 0.85vw, 13px);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-3 {
    position: relative;
    grid-column: 5 / span 2;
    grid-row: 1 / span 2;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__night-title {
    position: absolute;
    z-index: 1;
    top: clamp(16px, 1.8vw, 26px);
    right: clamp(18px, 2vw, 30px);
    left: clamp(18px, 2vw, 30px);
    margin: 0;
    color: #ffffff;
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.055em;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.82);
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__night-tags {
    position: absolute;
    z-index: 1;
    right: clamp(14px, 1.6vw, 22px);
    bottom: clamp(12px, 1.4vw, 18px);
    left: clamp(14px, 1.6vw, 22px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.82);
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__night-tags strong,
  #{{ section_dom_id }} .cleardrive-blind-spot-grid__night-tags span {
    display: block;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__night-tags strong {
    font-size: clamp(9px, 0.8vw, 11px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__night-tags span {
    margin-top: 3px;
    font-size: clamp(8px, 0.7vw, 10px);
    font-weight: 400;
    line-height: 1.15;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-4 {
    position: relative;
    grid-column: 1 / span 2;
    grid-row: 1 / span 2;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__copy {
    position: absolute;
    z-index: 1;
    top: clamp(18px, 2vw, 30px);
    left: clamp(18px, 2vw, 30px);
    width: calc(100% - 36px);
    color: #ffffff;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.72);
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__title {
    margin: 0;
    font-size: clamp(20px, 1.8vw, 30px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__text {
    margin: 12px 0 0;
    font-size: clamp(12px, 0.95vw, 15px);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-5 {
    position: relative;
    grid-column: 4;
    grid-row: 2;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__anti-glare-copy {
    position: absolute;
    z-index: 1;
    top: 8px;
    right: 10px;
    left: 10px;
    color: #ffffff;
    text-align: left;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.82);
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__anti-glare-title {
    margin: 0;
    font-size: clamp(11px, 0.9vw, 13px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__anti-glare-text {
    margin: 4px 0 0;
    font-size: clamp(9px, 0.65vw, 10px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  #{{ section_dom_id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 767px) {
    #{{ section_dom_id }} {
      padding: 0;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__items {
      display: block;
      width: min(1200px, calc(100% - 48px));
      aspect-ratio: auto;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-1 {
      aspect-ratio: 4 / 5;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__blind-copy {
      right: 20px;
      bottom: 24px;
      left: 20px;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__blind-title {
      font-size: clamp(24px, 7vw, 32px);
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__blind-text {
      margin-top: 12px;
      font-size: 14px;
      line-height: 1.4;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__card:not(.cleardrive-blind-spot-grid__card--tile-1) {
      display: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Cleardrive blind spot",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "rain_poster_title",
      "label": "Rain poster title",
      "default": "CLEAR BEHIND. WHATEVER THE WEATHER."
    },
    {
      "type": "textarea",
      "id": "rain_poster_text",
      "label": "Rain poster description",
      "default": "Rain or snow, keep a clear view of the road behind you."
    },
    {
      "type": "text",
      "id": "blueprint_poster_title",
      "label": "Blueprint poster title",
      "default": "CLEAN INSTALL. ZERO COMPROMISE."
    },
    {
      "type": "textarea",
      "id": "blueprint_poster_text",
      "label": "Blueprint poster description",
      "default": "Hidden wiring. No drilling. No cutting factory wiring. No damage to your vehicle."
    },
    {
      "type": "text",
      "id": "blind_poster_title",
      "label": "Blind spot poster title",
      "default": "SEE MORE. CHANGE LANES WITH CONFIDENCE."
    },
    {
      "type": "textarea",
      "id": "blind_poster_text",
      "label": "Blind spot poster description",
      "default": "An ultra-wide rear view helps you spot vehicles beyond the reach of a traditional mirror."
    },
    {
      "type": "text",
      "id": "anti_glare_poster_title",
      "label": "Anti-glare poster title",
      "default": "REAL-TIME VIEW."
    },
    {
      "type": "textarea",
      "id": "anti_glare_poster_text",
      "label": "Anti-glare poster description",
      "default": "Under 0.05s latency with automatic brightness that adapts to your surroundings."
    },
    {
      "type": "text",
      "id": "night_poster_title",
      "label": "Night poster title",
      "default": "LESS GLARE. MORE AWARENESS."
    },
    {
      "type": "text",
      "id": "night_tag_1_title",
      "label": "Night tag 1 title",
      "default": "ANTI-GLARE NIGHT VIEW"
    },
    {
      "type": "text",
      "id": "night_tag_1_text",
      "label": "Night tag 1 description",
      "default": "Clearer visibility behind."
    },
    {
      "type": "text",
      "id": "night_tag_2_title",
      "label": "Night tag 2 title",
      "default": "FRONT + REAR CAMERA"
    },
    {
      "type": "text",
      "id": "night_tag_2_text",
      "label": "Night tag 2 description",
      "default": "Both directions in view."
    }
  ],
  "presets": [
    { "name": "Cleardrive blind spot" }
  ]
}
{% endschema %}
