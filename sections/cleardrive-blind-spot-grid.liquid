{% comment %}Cleardrive five-tile comparison and product poster grid.{% endcomment %}

{% assign section_dom_id = 'cleardrive-blind-spot-grid-' | append: section.id %}

<section id="{{ section_dom_id }}" class="cleardrive-blind-spot-grid" aria-label="Cleardrive comparison and product posters">
  <div class="cleardrive-blind-spot-grid__items">
    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-1">
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="{{ 'cleardrive-blind-spot-comparison-mobile.png' | asset_url }}"
          width="1122"
          height="1402"
        >
        <img
          class="cleardrive-blind-spot-grid__image"
          src="{{ 'cleardrive-blind-spot-comparison.png' | asset_url }}"
          alt="A conventional rear-view mirror obstructed by headrests compared with a Cleardrive digital mirror showing a left-rear vehicle"
          width="1254"
          height="1254"
          loading="lazy"
        >
      </picture>
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-2">
      <img
        class="cleardrive-blind-spot-grid__image"
        src="{{ 'cleardrive-vehicle-coverage-blueprint.png' | asset_url }}"
        alt="Blueprint-style vehicle coverage illustration for Cleardrive digital rear-view mirrors"
        width="1786"
        height="881"
        loading="lazy"
      >
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-3">
      <img
        class="cleardrive-blind-spot-grid__image"
        src="{{ 'cleardrive-night-split-view-comparison.png' | asset_url }}"
        alt="A conventional rear-view mirror overwhelmed by night glare compared with a clear Cleardrive split-screen display"
        width="1254"
        height="1254"
        loading="lazy"
      >
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-4">
      <img
        class="cleardrive-blind-spot-grid__image"
        src="{{ 'cleardrive-rainy-visibility-comparison.png' | asset_url }}"
        alt="Rain-covered conventional side mirror compared with a Cleardrive digital rear-view display in rainy conditions"
        width="1254"
        height="1254"
        loading="lazy"
      >

      <div class="cleardrive-blind-spot-grid__copy">
        <h2 class="cleardrive-blind-spot-grid__title">{{ section.settings.rain_poster_title | escape }}</h2>
        <p class="cleardrive-blind-spot-grid__text">{{ section.settings.rain_poster_text | escape | newline_to_br }}</p>
      </div>
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--tile-5">
      <img
        class="cleardrive-blind-spot-grid__image"
        src="{{ 'cleardrive-anti-glare-product.png' | asset_url }}"
        alt="Cleardrive digital rear-view mirror anti-glare product detail"
        width="1254"
        height="1254"
        loading="lazy"
      >
    </article>
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    width: 100%;
    padding: 0;
    background: #ffffff;
  }

  #{{ section_dom_id }} *,
  #{{ section_dom_id }} *::before,
  #{{ section_dom_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__items {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 16px;
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    aspect-ratio: 100 / 33;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 0;
    background: #f3f3f3;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-1 {
    grid-column: 3;
    grid-row: 2;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-2 {
    grid-column: 3 / span 2;
    grid-row: 1;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-3 {
    grid-column: 5 / span 2;
    grid-row: 1 / span 2;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-4 {
    position: relative;
    grid-column: 1 / span 2;
    grid-row: 1 / span 2;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__copy {
    position: absolute;
    z-index: 1;
    top: clamp(18px, 2vw, 30px);
    left: clamp(18px, 2vw, 30px);
    width: calc(100% - 36px);
    color: #ffffff;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.72);
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__title {
    margin: 0;
    font-size: clamp(20px, 1.8vw, 30px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__text {
    margin: 12px 0 0;
    font-size: clamp(12px, 0.95vw, 15px);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-5 {
    grid-column: 4;
    grid-row: 2;
  }

  #{{ section_dom_id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 767px) {
    #{{ section_dom_id }} {
      padding: 0;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__items {
      display: block;
      width: min(1200px, calc(100% - 48px));
      aspect-ratio: auto;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--tile-1 {
      aspect-ratio: 4 / 5;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__card:not(.cleardrive-blind-spot-grid__card--tile-1) {
      display: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Cleardrive blind spot",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "rain_poster_title",
      "label": "Rain poster title",
      "default": "CLEAR BEHIND. WHATEVER THE WEATHER."
    },
    {
      "type": "textarea",
      "id": "rain_poster_text",
      "label": "Rain poster description",
      "default": "Rain or snow, keep a clear view of the road behind you."
    }
  ],
  "presets": [
    { "name": "Cleardrive blind spot" }
  ]
}
{% endschema %}
