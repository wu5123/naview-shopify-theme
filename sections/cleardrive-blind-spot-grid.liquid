{% comment %}Cleardrive blind-spot poster plus two editor-managed desktop poster slots.{% endcomment %}

{% assign section_dom_id = 'cleardrive-blind-spot-grid-' | append: section.id %}

<section id="{{ section_dom_id }}" class="cleardrive-blind-spot-grid" aria-label="Cleardrive blind-spot comparison posters">
  <div class="cleardrive-blind-spot-grid__items">
    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--comparison">
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="{{ 'cleardrive-blind-spot-comparison-mobile.png' | asset_url }}"
          width="1122"
          height="1402"
        >
        <img
          class="cleardrive-blind-spot-grid__image"
          src="{{ 'cleardrive-blind-spot-comparison.png' | asset_url }}"
          alt="A conventional rear-view mirror obstructed by headrests compared with a Cleardrive digital mirror showing a left-rear vehicle"
          width="1254"
          height="1254"
          loading="lazy"
        >
      </picture>
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--optional">
      {% if section.settings.poster_2_image != blank %}
        {{
          section.settings.poster_2_image
          | image_url: width: 1600
          | image_tag:
            widths: '480, 640, 800, 1000, 1200, 1600',
            sizes: '(min-width: 768px) calc((100vw - 8px) / 3), calc(100vw - 24px)',
            loading: 'lazy',
            class: 'cleardrive-blind-spot-grid__image',
            alt: 'Cleardrive feature poster'
        }}
      {% else %}
        <img
          class="cleardrive-blind-spot-grid__image"
          src="{{ 'cleardrive-rainy-visibility-comparison.png' | asset_url }}"
          alt="Rain-covered conventional side mirror compared with a Cleardrive digital rear-view display in rainy conditions"
          width="1254"
          height="1254"
          loading="lazy"
        >
      {% endif %}
    </article>

    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--optional">
      {% if section.settings.poster_3_image != blank %}
        {{
          section.settings.poster_3_image
          | image_url: width: 1600
          | image_tag:
            widths: '480, 640, 800, 1000, 1200, 1600',
            sizes: '(min-width: 768px) calc((100vw - 8px) / 3), calc(100vw - 24px)',
            loading: 'lazy',
            class: 'cleardrive-blind-spot-grid__image',
            alt: 'Cleardrive feature poster'
        }}
      {% else %}
        <img
          class="cleardrive-blind-spot-grid__image"
          src="{{ 'cleardrive-night-split-view-comparison.png' | asset_url }}"
          alt="A conventional rear-view mirror overwhelmed by night glare compared with a clear Cleardrive split-screen display"
          width="1254"
          height="1254"
          loading="lazy"
        >
      {% endif %}
    </article>
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    width: 100%;
    padding: 0 0 4px;
    background: #ffffff;
  }

  #{{ section_dom_id }} *,
  #{{ section_dom_id }} *::before,
  #{{ section_dom_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    width: 100%;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card {
    min-width: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0;
    background: #f3f3f3;
  }

  #{{ section_dom_id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: #949494;
    background: #f3f3f3;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__placeholder svg {
    width: 56px;
    height: 56px;
  }

  @media screen and (max-width: 767px) {
    #{{ section_dom_id }} {
      padding: 0 12px 12px;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__items {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__card {
      aspect-ratio: 4 / 5;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__card--optional {
      display: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Cleardrive blind spot",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "poster_2_image",
      "label": "Poster 2 image"
    },
    {
      "type": "image_picker",
      "id": "poster_3_image",
      "label": "Poster 3 image"
    }
  ],
  "presets": [
    { "name": "Cleardrive blind spot" }
  ]
}
{% endschema %}
