{% comment %}
  Cleardrive blind-spot poster group.
  The first card is the built-in camera-view comparison. Two optional cards keep
  the desktop layout ready for later Shopify uploads without showing placeholders.
{% endcomment %}

{% assign section_dom_id = 'cleardrive-blind-spot-grid-' | append: section.id %}

<section id="{{ section_dom_id }}" class="cleardrive-blind-spot-grid" aria-label="Cleardrive blind-spot comparison posters">
  <div class="cleardrive-blind-spot-grid__items">
    <article class="cleardrive-blind-spot-grid__card cleardrive-blind-spot-grid__card--comparison">
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="{{ 'cleardrive-blind-spot-comparison-mobile.png' | asset_url }}"
          width="1122"
          height="1402"
        >
        <img
          class="cleardrive-blind-spot-grid__image"
          src="{{ 'cleardrive-blind-spot-comparison.png' | asset_url }}"
          alt="A conventional rear-view mirror obstructed by headrests compared with a Cleardrive digital mirror showing a left-rear vehicle"
          width="1254"
          height="1254"
          loading="lazy"
        >
      </picture>
    </article>

    {% for block in section.blocks %}
      {% assign poster_image = block.settings.poster_image %}
      {% if poster_image != blank %}
        <article class="cleardrive-blind-spot-grid__card" {{ block.shopify_attributes }}>
          {{
            poster_image
            | image_url: width: 1600
            | image_tag:
              widths: '480, 640, 800, 1000, 1200, 1600',
              sizes: '(min-width: 768px) calc((100vw - 48px) / 3), calc(100vw - 24px)',
              loading: 'lazy',
              class: 'cleardrive-blind-spot-grid__image',
              alt: block.settings.alt_text
          }}
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    width: 100%;
    padding: 0 12px 16px;
    background: #ffffff;
  }

  #{{ section_dom_id }} *,
  #{{ section_dom_id }} *::before,
  #{{ section_dom_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__card {
    min-width: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px;
    background: #f3f3f3;
  }

  #{{ section_dom_id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_dom_id }} .cleardrive-blind-spot-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 767px) {
    #{{ section_dom_id }} {
      padding: 0 12px 12px;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__items {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    #{{ section_dom_id }} .cleardrive-blind-spot-grid__card {
      aspect-ratio: 4 / 5;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Cleardrive blind spot",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "poster",
      "name": "Optional poster card",
      "settings": [
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Poster image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image description",
          "default": "Cleardrive feature poster"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cleardrive blind spot",
      "blocks": [
        { "type": "poster" },
        { "type": "poster" }
      ]
    }
  ]
}
{% endschema %}
