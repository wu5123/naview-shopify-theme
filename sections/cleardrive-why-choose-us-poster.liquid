{% comment %}Cleardrive vehicle-fit feature poster.{% endcomment %}

{% assign section_dom_id = 'cleardrive-why-choose-us-poster-' | append: section.id %}

<section id="{{ section_dom_id }}" class="cleardrive-why-choose-us-poster" aria-label="Why choose Cleardrive">
  <div class="cleardrive-why-choose-us-poster__media">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="{{ 'cleardrive-why-choose-us-poster-mobile.png' | asset_url }}"
        width="1122"
        height="1402"
      >
      <img
        class="cleardrive-why-choose-us-poster__image"
        src="{{ 'cleardrive-why-choose-us-poster.png' | asset_url }}"
        alt="Vehicle-specific rear camera integration designed to blend with the original vehicle finish"
        width="1672"
        height="941"
        loading="lazy"
      >
    </picture>

    <div class="cleardrive-why-choose-us-poster__copy">
      <h2 class="cleardrive-why-choose-us-poster__title">{{ section.settings.poster_title | escape }}</h2>
      <p class="cleardrive-why-choose-us-poster__text">{{ section.settings.poster_text | escape | newline_to_br }}</p>
    </div>
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    width: 100%;
    margin: 0 0 16px;
    overflow: hidden;
    background: #ffffff;
  }

  #{{ section_dom_id }} *,
  #{{ section_dom_id }} *::before,
  #{{ section_dom_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__media {
    position: relative;
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    aspect-ratio: 3 / 1;
    overflow: hidden;
    background: #050505;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  #{{ section_dom_id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__copy {
    position: absolute;
    z-index: 1;
    top: clamp(20px, 2.8vw, 42px);
    left: clamp(20px, 3vw, 42px);
    width: min(44%, 500px);
    color: #ffffff;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.72);
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__title {
    margin: 0;
    font-size: clamp(24px, 2.35vw, 38px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__text {
    margin: 14px 0 0;
    font-size: clamp(13px, 1.1vw, 17px);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  @media screen and (max-width: 767px) {
    #{{ section_dom_id }} .cleardrive-why-choose-us-poster__media {
      aspect-ratio: 4 / 5;
    }

    #{{ section_dom_id }} .cleardrive-why-choose-us-poster__copy {
      top: 24px;
      right: 20px;
      left: 20px;
      width: auto;
    }

    #{{ section_dom_id }} .cleardrive-why-choose-us-poster__title {
      font-size: clamp(21px, 6vw, 26px);
      line-height: 0.98;
    }

    #{{ section_dom_id }} .cleardrive-why-choose-us-poster__text {
      margin-top: 10px;
      font-size: 13px;
      line-height: 1.3;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Why choose us poster",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "poster_title",
      "label": "Poster title",
      "default": "OEM STYLE. LOOKS FACTORY"
    },
    {
      "type": "textarea",
      "id": "poster_text",
      "label": "Poster description",
      "default": "Vehicle-specific integration designed to blend seamlessly with your vehicle’s original styling."
    }
  ],
  "presets": [
    {
      "name": "Why choose us poster"
    }
  ]
}
{% endschema %}
