{% comment %}Cleardrive vehicle-fit feature poster.{% endcomment %}

{% assign section_dom_id = 'cleardrive-why-choose-us-poster-' | append: section.id %}

<section id="{{ section_dom_id }}" class="cleardrive-why-choose-us-poster" aria-label="Why choose Cleardrive">
  <div class="cleardrive-why-choose-us-poster__header">
    <div class="cleardrive-why-choose-us-poster__container">
      <h2 class="cleardrive-why-choose-us-poster__heading">Why choose us</h2>
    </div>
  </div>

  <div class="cleardrive-why-choose-us-poster__media">
    <img
      class="cleardrive-why-choose-us-poster__image"
      src="{{ 'cleardrive-why-choose-us-poster.png' | asset_url }}"
      alt="Vehicle-specific rear camera integration designed to blend with the original vehicle finish"
      width="1672"
      height="941"
      loading="lazy"
    >
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    width: 100%;
    margin: 0;
    overflow: hidden;
    background: #f7faff;
    font-family:
      "Open Sans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Arial,
      sans-serif;
  }

  #{{ section_dom_id }} *,
  #{{ section_dom_id }} *::before,
  #{{ section_dom_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__header {
    padding: 48px 24px 32px;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__container {
    width: min(1480px, 100%);
    margin: 0 auto;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__heading {
    margin: 0;
    color: #071b3e;
    font-size: clamp(34px, 3vw, 40px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
    text-align: left;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__media {
    width: 100%;
    aspect-ratio: 3 / 1;
    overflow: hidden;
    background: #050505;
  }

  #{{ section_dom_id }} .cleardrive-why-choose-us-poster__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  @media screen and (max-width: 767px) {
    #{{ section_dom_id }} .cleardrive-why-choose-us-poster__header {
      padding: 40px 20px 24px;
    }

    #{{ section_dom_id }} .cleardrive-why-choose-us-poster__heading {
      font-size: 30px;
    }

    #{{ section_dom_id }} .cleardrive-why-choose-us-poster__media {
      aspect-ratio: 4 / 5;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Why choose us poster",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [],
  "presets": [
    {
      "name": "Why choose us poster"
    }
  ]
}
{% endschema %}
