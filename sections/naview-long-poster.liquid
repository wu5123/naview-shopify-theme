{% comment %}
  Naview — Eight-tile Bento Poster
  Eight independently uploadable images combine into one rectangular poster.
{% endcomment %}

{% liquid
  assign section_dom_id = 'naview-bento-poster-' | append: section.id
%}

<section
  id="{{ section_dom_id }}"
  class="naview-bento"
  style="
    --bento-background: {{ section.settings.background }};
    --bento-tile-background: {{ section.settings.tile_background }};
    --bento-width: {{ section.settings.max_width }}px;
    --bento-gap: {{ section.settings.gap }}px;
    --bento-radius: {{ section.settings.corner_radius }}px;
    --bento-padding-top: {{ section.settings.padding_top }}px;
    --bento-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="naview-bento__container">
    <div class="naview-bento__grid" role="list" aria-label="Naview poster gallery">
      {% for index in (1..8) %}
        {% assign image_key = 'tile_' | append: index | append: '_image' %}
        {% assign tile_image = section.settings[image_key] %}
        {% assign tile_alt = 'Naview poster image ' | append: index %}

        <div class="naview-bento__tile naview-bento__tile--{{ index }}" role="listitem">
          {% if tile_image != blank %}
            {{
              tile_image
              | image_url: width: 1800
              | image_tag:
                widths: '320, 480, 640, 800, 1000, 1200, 1500, 1800',
                sizes: '(min-width: 1200px) 34vw, (min-width: 750px) 40vw, 100vw',
                loading: 'lazy',
                class: 'naview-bento__image',
                alt: tile_alt
            }}
          {% else %}
            <div class="naview-bento__placeholder" aria-label="Upload poster image {{ index }}">
              {{ 'image' | placeholder_svg_tag: 'naview-bento__placeholder-svg' }}
              <span>Image {{ index }}</span>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    padding: var(--bento-padding-top) 20px var(--bento-padding-bottom);
    background: var(--bento-background);
  }

  #{{ section_dom_id }} * {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .naview-bento__container {
    width: min(var(--bento-width), 100%);
    margin: 0 auto;
  }

  #{{ section_dom_id }} .naview-bento__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(4, minmax(0, 1fr));
    gap: var(--bento-gap);
    width: 100%;
    aspect-ratio: 3 / 2;
  }

  #{{ section_dom_id }} .naview-bento__tile {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--bento-radius);
    background: var(--bento-tile-background);
    isolation: isolate;
  }

  #{{ section_dom_id }} .naview-bento__tile--1 {
    grid-column: 1 / span 2;
    grid-row: 1 / span 2;
  }

  #{{ section_dom_id }} .naview-bento__tile--2 {
    grid-column: 3 / span 2;
    grid-row: 1;
  }

  #{{ section_dom_id }} .naview-bento__tile--3 {
    grid-column: 5 / span 2;
    grid-row: 1 / span 2;
  }

  #{{ section_dom_id }} .naview-bento__tile--4 {
    grid-column: 3;
    grid-row: 2;
  }

  #{{ section_dom_id }} .naview-bento__tile--5 {
    grid-column: 4;
    grid-row: 2;
  }

  #{{ section_dom_id }} .naview-bento__tile--6 {
    grid-column: 1 / span 3;
    grid-row: 3 / span 2;
  }

  #{{ section_dom_id }} .naview-bento__tile--7 {
    grid-column: 4 / span 2;
    grid-row: 3 / span 2;
  }

  #{{ section_dom_id }} .naview-bento__tile--8 {
    grid-column: 6;
    grid-row: 3 / span 2;
  }

  #{{ section_dom_id }} .naview-bento__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    #{{ section_dom_id }} .naview-bento__tile:hover .naview-bento__image {
      transform: scale(1.025);
    }
  }

  #{{ section_dom_id }} .naview-bento__placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 80px;
    place-items: center;
    align-content: center;
    gap: 8px;
    padding: 14px;
    color: #6E7781;
    background: var(--bento-tile-background);
    font: 600 12px/1.2 -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ section_dom_id }} .naview-bento__placeholder-svg {
    width: min(72px, 45%);
    height: auto;
    opacity: 0.5;
  }

  @media screen and (max-width: 749px) {
    #{{ section_dom_id }} {
      padding-right: 12px;
      padding-left: 12px;
    }

    #{{ section_dom_id }} .naview-bento__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-flow: dense;
      grid-auto-rows: clamp(92px, 25vw, 140px);
      aspect-ratio: auto;
    }

    #{{ section_dom_id }} .naview-bento__tile--1 {
      grid-column: 1 / -1;
      grid-row: span 2;
    }

    #{{ section_dom_id }} .naview-bento__tile--2 {
      grid-column: span 1;
      grid-row: span 1;
    }

    #{{ section_dom_id }} .naview-bento__tile--3 {
      grid-column: span 1;
      grid-row: span 2;
    }

    #{{ section_dom_id }} .naview-bento__tile--4 {
      grid-column: span 1;
      grid-row: span 1;
    }

    #{{ section_dom_id }} .naview-bento__tile--5 {
      grid-column: 1 / -1;
      grid-row: span 1;
    }

    #{{ section_dom_id }} .naview-bento__tile--6 {
      grid-column: 1 / -1;
      grid-row: span 2;
    }

    #{{ section_dom_id }} .naview-bento__tile--7,
    #{{ section_dom_id }} .naview-bento__tile--8 {
      grid-column: span 1;
      grid-row: span 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_dom_id }} .naview-bento__image {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Naview bento poster",
  "tag": "section",
  "class": "section-naview-bento-poster",
  "settings": [
    {
      "type": "header",
      "content": "Poster images"
    },
    {
      "type": "image_picker",
      "id": "tile_1_image",
      "label": "Image 1 — large square"
    },
    {
      "type": "image_picker",
      "id": "tile_2_image",
      "label": "Image 2 — wide"
    },
    {
      "type": "image_picker",
      "id": "tile_3_image",
      "label": "Image 3 — large square"
    },
    {
      "type": "image_picker",
      "id": "tile_4_image",
      "label": "Image 4 — small square"
    },
    {
      "type": "image_picker",
      "id": "tile_5_image",
      "label": "Image 5 — small square"
    },
    {
      "type": "image_picker",
      "id": "tile_6_image",
      "label": "Image 6 — extra wide"
    },
    {
      "type": "image_picker",
      "id": "tile_7_image",
      "label": "Image 7 — large square"
    },
    {
      "type": "image_picker",
      "id": "tile_8_image",
      "label": "Image 8 — tall"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tile_background",
      "label": "Empty tile background",
      "default": "#F3F3F3"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Space between images",
      "default": 10
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "Maximum poster width",
      "default": 1500
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Naview bento poster"
    }
  ]
}
{% endschema %}
