{% comment %}
  Naview — Long Feature Poster
  Add this file to: Online Store > Themes > Edit code > Sections
{% endcomment %}

{% liquid
  assign section_dom_id = 'naview-poster-' | append: section.id
  assign poster_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign poster_alt = section.settings.image_alt | default: section.settings.heading | escape
%}

<section
  id="{{ section_dom_id }}"
  class="naview-poster"
  style="
    --poster-bg: {{ section.settings.background }};
    --poster-heading: {{ section.settings.heading_color }};
    --poster-accent: {{ section.settings.accent_color }};
    --poster-width: {{ section.settings.max_width }}px;
    --poster-radius: {{ section.settings.border_radius }}px;
    --poster-padding-top: {{ section.settings.padding_top }}px;
    --poster-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="naview-poster__container">
    {% if section.settings.heading != blank %}
      <div class="naview-poster__heading-row">
        <span class="naview-poster__line" aria-hidden="true"></span>
        <h2 class="naview-poster__heading">{{ section.settings.heading | escape }}</h2>
        <span class="naview-poster__line" aria-hidden="true"></span>
      </div>
    {% endif %}

    <div class="naview-poster__frame{% if section.settings.enable_shadow %} naview-poster__frame--shadow{% endif %}">
      {% if section.settings.link != blank %}
        <a class="naview-poster__link" href="{{ section.settings.link }}">
      {% endif %}

      {% if poster_image != blank %}
        <picture class="naview-poster__picture">
          {% if mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 500 }} 500w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1000 }} 1000w,
                {{ mobile_image | image_url: width: 1400 }} 1400w
              "
              sizes="100vw"
            >
          {% endif %}

          {{
            poster_image
            | image_url: width: 3200
            | image_tag:
              widths: '600, 900, 1200, 1600, 2000, 2400, 2800, 3200',
              sizes: '(min-width: 1600px) 1500px, 100vw',
              loading: 'lazy',
              class: 'naview-poster__image',
              alt: poster_alt
          }}
        </picture>
      {% else %}
        <div class="naview-poster__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'naview-poster__placeholder-image' }}
          <p>Upload your long feature poster in this section's settings.</p>
        </div>
      {% endif %}

      {% if section.settings.link != blank %}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    padding: var(--poster-padding-top) 20px var(--poster-padding-bottom);
    background: #FFFFFF !important;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  #{{ section_dom_id }} * {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .naview-poster__container {
    width: min(var(--poster-width), 100%);
    margin: 0 auto;
  }

  #{{ section_dom_id }} .naview-poster__heading-row {
    display: grid;
    grid-template-columns: minmax(40px, 190px) auto minmax(40px, 190px);
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-bottom: 28px;
  }

  #{{ section_dom_id }} .naview-poster__line {
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--poster-accent) 45%, transparent)
    );
  }

  #{{ section_dom_id }} .naview-poster__line:last-child {
    transform: scaleX(-1);
  }

  #{{ section_dom_id }} .naview-poster__heading {
    margin: 0;
    color: var(--poster-heading);
    font-size: clamp(22px, 2.1vw, 34px);
    font-weight: 760;
    line-height: 1.15;
    letter-spacing: 0.045em;
    text-align: center;
    text-transform: uppercase;
  }

  #{{ section_dom_id }} .naview-poster__frame {
    overflow: hidden;
    border-radius: var(--poster-radius);
    background: #FFFFFF;
  }

  #{{ section_dom_id }} .naview-poster__frame--shadow {
    box-shadow:
      0 24px 60px rgba(7, 31, 72, 0.12),
      0 4px 14px rgba(7, 31, 72, 0.06);
  }

  #{{ section_dom_id }} .naview-poster__link,
  #{{ section_dom_id }} .naview-poster__picture,
  #{{ section_dom_id }} .naview-poster__image {
    display: block;
    width: 100%;
  }

  #{{ section_dom_id }} .naview-poster__link {
    color: inherit;
    text-decoration: none;
  }

  #{{ section_dom_id }} .naview-poster__image {
    height: auto;
    object-fit: contain;
  }

  #{{ section_dom_id }} .naview-poster__placeholder {
    display: grid;
    min-height: 640px;
    place-items: center;
    padding: 40px;
    color: #536176;
    background: #F7FAFF;
    text-align: center;
  }

  #{{ section_dom_id }} .naview-poster__placeholder-image {
    width: min(760px, 100%);
    height: auto;
  }

  #{{ section_dom_id }} .naview-poster__placeholder p {
    margin: 20px 0 0;
    font-size: 15px;
  }

  @media screen and (max-width: 749px) {
    #{{ section_dom_id }} {
      padding-right: 0;
      padding-left: 0;
    }

    #{{ section_dom_id }} .naview-poster__heading-row {
      grid-template-columns: minmax(24px, 60px) auto minmax(24px, 60px);
      gap: 12px;
      padding: 0 20px;
      margin-bottom: 20px;
    }

    #{{ section_dom_id }} .naview-poster__heading {
      font-size: 21px;
    }

    #{{ section_dom_id }} .naview-poster__frame {
      border-radius: min(var(--poster-radius), 14px);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Naview long poster",
  "tag": "section",
  "class": "section-naview-poster",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop long poster"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile poster (optional)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Poster alt text",
      "default": "Naview digital rearview mirror features"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Poster link (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#071B3E"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#1769E0"
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Show poster shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 18
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "Maximum poster width",
      "default": 1500
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Naview long poster"
    }
  ]
}
{% endschema %}

