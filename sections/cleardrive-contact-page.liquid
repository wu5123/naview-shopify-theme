{% liquid
  assign form_id = 'ClearDriveContact-' | append: section.id
  assign contact_email = section.settings.email | strip
%}

<section class="cd-contact" aria-labelledby="ContactHeading-{{ section.id }}">
  <header class="cd-contact__header">
    <h1 id="ContactHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.subtitle | escape }}</p>
  </header>

  <div class="cd-contact__columns">
    <div class="cd-contact__details">
      <h2>{{ section.settings.contact_heading | escape }}</h2>
      {% if contact_email != blank %}
        <a class="cd-contact__email" href="mailto:{{ contact_email | escape }}">
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
            <rect x="3" y="6" width="26" height="20" rx="2"/>
            <path d="m4 8 12 9L28 8"/>
          </svg>
          <span>{{ contact_email | escape }}</span>
        </a>
      {% endif %}
      {% if section.settings.whatsapp_link != blank %}
        <a class="cd-contact__whatsapp" href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          <span>{{ section.settings.whatsapp_label | escape }} <span aria-hidden="true">↗</span></span>
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      {% endif %}
    </div>

    {% form 'contact', id: form_id, class: 'cd-contact__form' %}
      {% if form.posted_successfully? %}
        <div class="cd-contact__feedback cd-contact__feedback--success" role="status" tabindex="-1" autofocus>
          {{ 'blocks.contact_form.post_success' | t }}
        </div>
      {% elsif form.errors %}
        <div id="{{ form_id }}-errors" class="cd-contact__feedback cd-contact__feedback--error" role="alert" tabindex="-1" autofocus>
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="cd-contact__field">
        <label for="{{ form_id }}-first-name">First Name</label>
        <input id="{{ form_id }}-first-name" type="text" name="contact[First Name]" autocomplete="given-name" value="{{ form['First Name'] | default: customer.first_name | escape }}">
      </div>
      <div class="cd-contact__field">
        <label for="{{ form_id }}-last-name">Last Name</label>
        <input id="{{ form_id }}-last-name" type="text" name="contact[Last Name]" autocomplete="family-name" value="{{ form['Last Name'] | default: customer.last_name | escape }}">
      </div>
      <div class="cd-contact__field">
        <label for="{{ form_id }}-email">Email <span aria-hidden="true">*</span></label>
        <input id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required value="{{ form.email | default: customer.email | escape }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %}>
      </div>
      <div class="cd-contact__field">
        <label for="{{ form_id }}-message">Message <span aria-hidden="true">*</span></label>
        <textarea id="{{ form_id }}-message" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea>
      </div>
      <button type="submit" class="cd-contact__submit">
        {{ section.settings.submit_label | escape }}
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
      </button>
      <p class="cd-contact__note">{{ section.settings.form_note | escape }}</p>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .cd-contact {
    max-width: 1380px;
    margin: 0 auto;
    padding: 52px 56px 96px;
    color: #080d15;
    background: #fff;
  }
  .cd-contact__header { text-align: center; margin-bottom: 72px; }
  .cd-contact__header h1 { margin: 0; font-size: clamp(36px, 4.2vw, 60px); line-height: 1.12; letter-spacing: -0.035em; font-weight: 700; }
  .cd-contact__header p { margin: 14px 0 0; font-size: clamp(18px, 1.9vw, 25px); line-height: 1.5; color: #586579; }
  .cd-contact__columns { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 72px; align-items: start; }
  .cd-contact__details h2 { margin: 0 0 30px; font-size: clamp(28px, 3vw, 40px); line-height: 1.2; letter-spacing: -0.025em; font-weight: 700; }
  .cd-contact__details a { display: flex; align-items: center; gap: 24px; min-height: 48px; width: fit-content; max-width: 100%; line-height: 1.5; }
  .cd-contact__details a > span { min-width: 0; overflow-wrap: anywhere; }
  .cd-contact__email { color: #111b34; font-size: clamp(18px, 2vw, 27px); text-decoration: none; }
  .cd-contact__email svg { width: 42px; height: 42px; flex: 0 0 auto; stroke: #080d15; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cd-contact__email:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .cd-contact__whatsapp { margin-top: 42px; color: #005bea; font-size: clamp(18px, 1.8vw, 23px); text-decoration: none; }
  .cd-contact__whatsapp > span:not(.visually-hidden) { text-decoration: underline; text-underline-offset: 4px; }
  .cd-contact__whatsapp svg { width: 44px; height: 44px; flex: 0 0 auto; fill: #25c45a; }
  .cd-contact__form { min-width: 0; display: flex; flex-direction: column; gap: 20px; margin: 0; }
  .cd-contact__field { display: flex; flex-direction: column; gap: 8px; }
  .cd-contact__field label { font-size: 18px; line-height: 1.4; font-weight: 500; }
  .cd-contact__field :is(input, textarea) { box-sizing: border-box; width: 100%; min-width: 0; min-height: 50px; margin: 0; padding: 12px 14px; background: #fff; color: #080d15; border: 1px solid #c8ced8; border-radius: 6px; font: inherit; font-size: 16px; line-height: 1.5; box-shadow: 0 0 0 1px #eff1f5; }
  .cd-contact__field textarea { resize: vertical; min-height: 148px; }
  .cd-contact :is(input, textarea, a, button):focus-visible { outline: 2px solid #005bea; outline-offset: 3px; }
  .cd-contact__submit { display: inline-flex; align-items: center; justify-content: center; align-self: flex-start; gap: 18px; min-height: 60px; padding: 14px 36px; margin-top: 6px; border: 1px solid #005bea; border-radius: 6px; background: #005bea; color: #fff; font: inherit; font-size: 19px; font-weight: 600; cursor: pointer; }
  .cd-contact__submit:hover { background: #004bc2; border-color: #004bc2; }
  .cd-contact__submit svg { width: 24px; height: 24px; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .cd-contact__note { margin: -4px 0 0; color: #586579; font-size: 15px; line-height: 1.5; }
  .cd-contact__feedback { padding: 16px; border: 1px solid; border-radius: 6px; font-size: 16px; line-height: 1.5; }
  .cd-contact__feedback--success { color: #17623b; background: #f0faf4; }
  .cd-contact__feedback--error { color: #9d241c; background: #fff5f4; }
  .cd-contact__feedback ul { padding-left: 20px; margin: 0; }
  @media (max-width: 989px) {
    .cd-contact { padding-inline: 28px; }
    .cd-contact__columns { gap: 36px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
    .cd-contact__details a { gap: 14px; }
  }
  @media (max-width: 749px) {
    .cd-contact { padding: 36px 20px 60px; }
    .cd-contact__header { margin-bottom: 38px; }
    .cd-contact__header h1 { font-size: 38px; }
    .cd-contact__header p { font-size: 18px; }
    .cd-contact__columns { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .cd-contact__details h2 { font-size: 28px; margin-bottom: 18px; }
    .cd-contact__email { font-size: 20px; }
    .cd-contact__email svg { width: 32px; height: 32px; }
    .cd-contact__whatsapp { margin-top: 16px; font-size: 18px; }
    .cd-contact__whatsapp svg { width: 34px; height: 34px; }
    .cd-contact__field label { font-size: 16px; }
    .cd-contact__submit { width: 100%; min-height: 54px; font-size: 18px; }
    .cd-contact__note { font-size: 14px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ClearDrive contact page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Questions about your mirror? We’re here to help." },
    { "type": "text", "id": "contact_heading", "label": "Contact details heading", "default": "Get in touch" },
    { "type": "text", "id": "email", "label": "Display email address", "default": "cleardriveca@gmail.com", "info": "This is the displayed email link. Form messages use the store's Shopify sender email setting." },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "Contact us on WhatsApp" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send message" },
    { "type": "text", "id": "form_note", "label": "Form note", "default": "We’ll reply to the email address you provide." }
  ],
  "presets": [{ "name": "ClearDrive contact page" }]
}
{% endschema %}
