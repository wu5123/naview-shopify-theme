{% liquid
  assign hero_video = section.settings.hero_video
  assign poster_image = section.settings.poster_image
  assign overlay_opacity = section.settings.video_overlay | times: 0.01
  assign primary_url = section.settings.primary_link | default: '#naview-models'
  assign secondary_url = section.settings.secondary_link | default: 'https://wa.me/16137969403'
%}

<section
  id="NaviewVideoHero-{{ section.id }}"
  class="naview-video-hero"
  style="
    --nv-hero-height: {{ section.settings.hero_desktop_height }}px;
    --nv-mobile-height: {{ section.settings.hero_mobile_height }}px;
    --nv-text-color: {{ section.settings.hero_text_color }};
    --nv-overlay-opacity: {{ overlay_opacity }};
  "
  data-naview-video-hero
>
  <div class="naview-video-hero__media" aria-hidden="true">
    {% if hero_video != blank %}
      {{
        hero_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          image_size: '2400x',
          class: 'naview-video-hero__video'
      }}
    {% elsif poster_image != blank %}
      {{
        poster_image
        | image_url: width: 3000
        | image_tag:
          class: 'naview-video-hero__poster',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2500, 3000',
          sizes: '100vw',
          alt: ''
      }}
    {% else %}
      <div class="naview-video-hero__empty">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'naview-video-hero__placeholder' }}
      </div>
    {% endif %}
  </div>

  <div class="naview-video-hero__overlay" aria-hidden="true"></div>

  <div class="naview-video-hero__content">
    <div class="naview-video-hero__copy">
      <p
        class="naview-video-hero__line naview-video-hero__line--one"
        aria-label="clearview"
      >
        <span
          class="naview-video-hero__typed"
          data-typewriter
          data-text="clearview"
          data-speed="72"
          aria-hidden="true"
        >clearview</span>
      </p>

      <h1
        class="naview-video-hero__line naview-video-hero__line--two"
        aria-label="DIGITAL REAR MIRROR"
      >
        <span
          class="naview-video-hero__typed"
          data-typewriter
          data-text="DIGITAL REAR MIRROR"
          data-speed="46"
          aria-hidden="true"
        >DIGITAL REAR MIRROR</span>
      </h1>

      <p
        class="naview-video-hero__line naview-video-hero__line--three"
        aria-label="HD View, Day or Night, Rain or Snow"
      >
        <span
          class="naview-video-hero__typed"
          data-typewriter
          data-text="HD View  Day or Night  Rain or Snow"
          data-speed="34"
          aria-hidden="true"
        >HD View  Day or Night  Rain or Snow</span>
      </p>

      <div class="naview-video-hero__actions">
        <a class="naview-video-hero__button naview-video-hero__button--primary" href="{{ primary_url }}">
          Find my vehicle
        </a>

        <a class="naview-video-hero__button naview-video-hero__button--secondary" href="{{ secondary_url }}">
          Contact us
        </a>
      </div>
    </div>
  </div>
</section>

<noscript>
  <style>
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__typed,
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions {
      visibility: visible !important;
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

{% style %}
  #NaviewVideoHero-{{ section.id }} {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: var(--nv-hero-height);
    min-height: 520px;
    overflow: hidden;
    background: #05080d;
    color: var(--nv-text-color);
    font-family:
      "Open Sans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      "Helvetica Neue",
      Arial,
      sans-serif;
  }

  #NaviewVideoHero-{{ section.id }} *,
  #NaviewVideoHero-{{ section.id }} *::before,
  #NaviewVideoHero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__media,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__overlay,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__video,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__poster,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__media {
    z-index: 0;
    overflow: hidden;
    background: #05080d;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__video,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__poster {
    display: block;
    border: 0;
    object-fit: cover;
    object-position: {{ section.settings.video_position }};
    pointer-events: none;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__video {
    background: #05080d;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__empty {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #07111f 0%, #17375e 48%, #07111f 100%);
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.22;
    object-fit: cover;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__overlay {
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, calc(var(--nv-overlay-opacity) + 0.20)) 0%,
        rgba(0, 0, 0, var(--nv-overlay-opacity)) 38%,
        rgba(0, 0, 0, calc(var(--nv-overlay-opacity) * 0.45)) 68%,
        rgba(0, 0, 0, calc(var(--nv-overlay-opacity) * 0.18)) 100%
      );
    pointer-events: none;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 0 32px;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__copy {
    width: min(100%, 1120px);
    color: var(--nv-text-color);
    text-align: left;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__line {
    width: fit-content;
    max-width: 100%;
    margin: 0;
    color: inherit;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__typed {
    position: relative;
    display: inline;
    visibility: hidden;
    white-space: pre-wrap;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__typed.is-typing::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 0.82em;
    margin-left: 0.08em;
    background: currentColor;
    vertical-align: -0.03em;
    animation: naview-caret-blink 700ms steps(1, end) infinite;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--one {
    min-height: 24px;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: 0;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--two {
    min-height: 72px;
    margin-top: 16px;
    font-size: 64px;
    font-weight: 600;
    line-height: 72px;
    letter-spacing: -1.28px;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--three {
    min-height: 32px;
    max-width: 900px;
    margin-top: 24px;
    font-size: 28px;
    font-weight: 400;
    line-height: 32px;
    letter-spacing: -0.56px;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
    visibility: hidden;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 600ms ease,
      transform 600ms ease;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions.is-visible {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 32px;
    border: 0;
    border-radius: 100px;
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: -0.32px;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 300ms ease,
      background-color 300ms ease,
      border-color 300ms ease,
      transform 300ms ease;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--primary {
    color: #3b3e40;
    background: #ffffff;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--secondary {
    padding: 0 31px;
    border: 1px solid rgba(255, 255, 255, 0.82);
    color: #ffffff;
    background: rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button:hover {
    transform: translateY(-2px);
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--primary:hover {
    color: #111820;
    background: #f0f1f2;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--secondary:hover {
    border-color: #ffffff;
    color: #3b3e40;
    background: #ffffff;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  @keyframes naview-caret-blink {
    0%,
    48% {
      opacity: 1;
    }

    49%,
    100% {
      opacity: 0;
    }
  }

  @media screen and (min-width: 1600px) {
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__content {
      padding-right: 48px;
      padding-left: 48px;
    }
  }

  @media screen and (max-width: 989px) {
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--two {
      font-size: clamp(48px, 7vw, 60px);
      line-height: 1.12;
      letter-spacing: -0.025em;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--three {
      font-size: clamp(22px, 3vw, 26px);
      line-height: 1.2;
    }
  }

  @media screen and (max-width: 767px) {
    #NaviewVideoHero-{{ section.id }} {
      height: var(--nv-mobile-height);
      min-height: 600px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__video,
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__poster {
      object-position: {{ section.settings.mobile_video_position }};
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(0, 0, 0, calc(var(--nv-overlay-opacity) * 0.40)) 0%,
          rgba(0, 0, 0, calc(var(--nv-overlay-opacity) * 0.72)) 36%,
          rgba(0, 0, 0, calc(var(--nv-overlay-opacity) + 0.22)) 100%
        );
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__content {
      align-items: flex-end;
     justify-content: center;
      padding: 80px 20px 48px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__copy {
      width: 100%;
      text-align: center;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line {
      width: 100%;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--one {
      min-height: 20px;
      font-size: 14px;
      line-height: 20px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--two {
      min-height: 0;
      margin-top: 12px;
      font-size: clamp(34px, 10vw, 46px);
      line-height: 1.06;
      letter-spacing: -0.035em;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--three {
      min-height: 0;
      margin-top: 18px;
      font-size: clamp(17px, 4.7vw, 21px);
      line-height: 1.35;
      letter-spacing: -0.02em;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions {
      justify-content: center;
      gap: 10px;
      margin-top: 32px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__button {
      min-height: 46px;
      padding: 0 24px;
      font-size: 15px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--secondary {
      padding: 0 23px;
    }
  }

  @media screen and (max-width: 370px) {
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__typed,
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: none;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__typed::after {
      display: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('NaviewVideoHero-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;

    root.dataset.initialized = 'true';

    const video = root.querySelector('video');
    if (video) {
      video.muted = true;
      video.defaultMuted = true;
      video.loop = true;
      video.playsInline = true;
      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(() => {});
      }
    }

    const typedElements = [...root.querySelectorAll('[data-typewriter]')];
    const actions = root.querySelector('.naview-video-hero__actions');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      typedElements.forEach((element) => {
        element.textContent = element.dataset.text || '';
        element.style.visibility = 'visible';
      });
      actions?.classList.add('is-visible');
      return;
    }

    const wait = (duration) => new Promise((resolve) => window.setTimeout(resolve, duration));

    const typeLine = async (element) => {
      const text = element.dataset.text || '';
      const speed = Number(element.dataset.speed) || 42;

      element.textContent = '';
      element.style.visibility = 'visible';
      element.classList.add('is-typing');

      for (const character of text) {
        element.textContent += character;
        await wait(character === ' ' ? Math.max(18, speed * 0.45) : speed);
      }

      element.classList.remove('is_typing');
    };

    const runTypewriter = async () => {
      await wait(180);

      for (let index = 0; index < typedElements.length; index += 1) {
        await typeLine(typedElements[index]);
        await wait(index === 0 ? 150 : 220);
      }

      actions?.classList.add('is-visible');
    };

    runTypewriter();
  })();
</script>

{% schema %}
{
  "name": "Premium mirror hero",
  "tag": "section",
  "class": "section-premium-mirror-hero",
  "settings": [
    {
      "type": "video",
      "id": "hero_video",
      "label": "Background video"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Fallback image",
      "info": "Displayed before the video loads or when no video is selected."
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Desktop video position",
      "default": "50% 50%",
      "options": [
        {
          "value": "25% 50%",
          "label": "Left"
        },
        {
          "value": "50% 50%",
          "label": "Center"
        },
        {
          "value": "75% 50%",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_video_position",
      "label": "Mobile video position",
      "default": "50% 50%",
      "options": [
        {
          "value": "25% 50%",
          "label": "Left"
        },
        {
          "value": "50% 50%",
          "label": "Center"
        },
        {
          "value": "75% 50%",
          "label": "Right"
        }
      ]
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Find my vehicle link",
      "info": "Defaults to #naview-models when left blank."
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Contact us link",
      "info": "Defaults to your WhatsApp link when left blank."
    },
    {
      "type": "range",
      "id": "hero_desktop_height",
      "min": 520,
      "max": 760,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 640
    },
    {
      "type": "range",
      "id": "hero_mobile_height",
      "min": 600,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Mobile height",
      "default": 680
    },
    {
      "type": "range",
      "id": "video_overlay",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Video dark overlay",
      "default": 20
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Premium mirror hero"
    }
  ]
}
{% endschema %}
