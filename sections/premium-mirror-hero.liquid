{% liquid
  assign enable_slideshow = section.settings.enable_slideshow
  assign hero_video = section.settings.hero_video
  assign poster_image = section.settings.poster_image
  assign overlay_opacity = section.settings.video_overlay | times: 0.01
  assign primary_url = section.settings.primary_link | default: '#cleardrive-models'
  assign contact_page_url = routes.root_url | append: 'pages/contact'
  assign secondary_url = section.settings.secondary_link | default: contact_page_url
%}

<section
  id="NaviewVideoHero-{{ section.id }}"
  class="naview-video-hero{% if enable_slideshow %} naview-video-hero--slideshow{% endif %}"
  style="
    --nv-hero-height: {{ section.settings.hero_desktop_height }}px;
    --nv-mobile-height: {{ section.settings.hero_mobile_height }}px;
    --nv-text-color: {{ section.settings.hero_text_color }};
    --nv-overlay-opacity: {{ overlay_opacity }};
  "
  {% if enable_slideshow %}data-cleardrive-slideshow data-active-slide="1" tabindex="0" aria-roledescription="carousel" aria-label="ClearDrive vehicle-specific digital rear mirrors"{% endif %}
  data-naview-video-hero
>
  <div class="naview-video-hero__media" aria-hidden="true">
    {% if enable_slideshow %}
      {% assign slide_names = 'cleardrive-home-extended-01-20260909.webp,cleardrive-home-extended-02-20260909.webp,cleardrive-home-extended-03-20260909.webp' | split: ',' %}
      <div class="naview-video-hero__track" data-carousel-track>
      {% for slide_name in slide_names %}
        <div class="naview-video-hero__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
          <img src="{{ slide_name | asset_url }}" width="2172" height="1086" alt="" draggable="false" {% if forloop.first %}fetchpriority="high"{% endif %} loading="eager" decoding="async">
        </div>
      {% endfor %}
      </div>
    {% elsif hero_video != blank %}
      {{
        hero_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          image_size: '2400x',
          class: 'naview-video-hero__video'
      }}
    {% elsif poster_image != blank %}
      {{
        poster_image
        | image_url: width: 3000
        | image_tag:
          class: 'naview-video-hero__poster',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2500, 3000',
          sizes: '100vw',
          alt: ''
      }}
    {% else %}
      <div class="naview-video-hero__empty">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'naview-video-hero__placeholder' }}
      </div>
    {% endif %}
  </div>

  <div class="naview-video-hero__overlay" aria-hidden="true"></div>

  <div class="naview-video-hero__content">
    <div class="naview-video-hero__copy">
      <p
        class="naview-video-hero__line naview-video-hero__line--one"
        aria-hidden="true"
      >
        <span class="naview-video-hero__brand-wordmark" aria-hidden="true">
          <span>Cleardrive</span>
        </span>
      </p>

      <h1
        class="naview-video-hero__line naview-video-hero__line--two"
      >
        DIGITAL REAR MIRROR
      </h1>

      <p
        class="naview-video-hero__line naview-video-hero__line--three"
      >
        HD View&nbsp;&nbsp;Day or Night&nbsp;&nbsp;Rain or Snow
      </p>

      <div class="naview-video-hero__actions">
        <a class="naview-video-hero__button naview-video-hero__button--primary" href="{{ primary_url }}">
          Find my vehicle
        </a>

        <a class="naview-video-hero__button naview-video-hero__button--secondary" href="{{ secondary_url }}">
          Contact us
        </a>
      </div>
    </div>
  </div>
  {% if enable_slideshow %}
    <button type="button" class="naview-video-hero__arrow naview-video-hero__arrow--previous" data-slide-previous aria-label="Previous banner"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
    <button type="button" class="naview-video-hero__arrow naview-video-hero__arrow--next" data-slide-next aria-label="Next banner"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
    <div class="naview-video-hero__slideshow-controls" role="group" aria-label="Banner slideshow controls">
      {% for number in (1..3) %}
        <button type="button" class="naview-video-hero__slide-dot" data-slide-to="{{ forloop.index0 }}" aria-label="Show banner {{ number }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
      {% endfor %}
      <button type="button" class="naview-video-hero__pause" data-slideshow-pause data-paused="false" aria-label="Pause slideshow" aria-pressed="false"><span class="pause-icon" aria-hidden="true">Ⅱ</span><span class="play-icon" aria-hidden="true">▶</span></button>
    </div>
  {% endif %}
</section>
{% if enable_slideshow %}<script src="{{ 'cleardrive-home-carousel.js' | asset_url }}" defer></script>{% endif %}

{% style %}
  #NaviewVideoHero-{{ section.id }} {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: var(--nv-hero-height);
    min-height: 360px;
    overflow: hidden;
    background: #05080d;
    color: var(--nv-text-color);
    font-family:
      "Open Sans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      "Helvetica Neue",
      Arial,
      sans-serif;
  }

  #NaviewVideoHero-{{ section.id }} *,
  #NaviewVideoHero-{{ section.id }} *::before,
  #NaviewVideoHero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__media,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__overlay,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__video,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__poster,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__media {
    z-index: 0;
    overflow: hidden;
    background: #05080d;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__video,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__poster {
    display: block;
    border: 0;
    object-fit: cover;
    object-position: {{ section.settings.video_position }};
    pointer-events: none;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__video {
    background: #05080d;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__empty {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #07111f 0%, #17375e 48%, #07111f 100%);
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.22;
    object-fit: cover;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__overlay {
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, calc(var(--nv-overlay-opacity) + 0.20)) 0%,
        rgba(0, 0, 0, var(--nv-overlay-opacity)) 38%,
        rgba(0, 0, 0, calc(var(--nv-overlay-opacity) * 0.45)) 68%,
        rgba(0, 0, 0, calc(var(--nv-overlay-opacity) * 0.18)) 100%
      );
    pointer-events: none;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    padding: 42px 32px 28px;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__copy {
    width: min(100%, 1120px);
    color: var(--nv-text-color);
    text-align: left;
    animation: naview-hero-copy-enter 520ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__line {
    width: fit-content;
    max-width: 100%;
    margin: 0;
    color: inherit;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__brand-wordmark {
    display: inline-block;
    font-family:
      "Arial Black",
      "Helvetica Neue",
      "Segoe UI",
      Arial,
      sans-serif;
    font-size: 30px;
    font-weight: 900;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.075em;
    transform: scaleX(1.04);
    transform-origin: left center;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--one {
    min-height: 30px;
    font-size: 30px;
    font-weight: 900;
    line-height: 30px;
    letter-spacing: 0;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--two {
    min-height: 72px;
    margin-top: 16px;
    font-size: 64px;
    font-weight: 600;
    line-height: 72px;
    letter-spacing: -1.28px;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--three {
    min-height: 32px;
    max-width: 900px;
    margin-top: 24px;
    font-size: 28px;
    font-weight: 400;
    line-height: 32px;
    letter-spacing: -0.56px;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 32px;
    border: 0;
    border-radius: 100px;
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: -0.32px;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 300ms ease,
      background-color 300ms ease,
      border-color 300ms ease,
      transform 300ms ease;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--primary {
    color: #3b3e40;
    background: #ffffff;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--secondary {
    padding: 0 31px;
    border: 1px solid rgba(255, 255, 255, 0.82);
    color: #ffffff;
    background: rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button:hover {
    transform: translateY(-2px);
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--primary:hover {
    color: #111820;
    background: #f0f1f2;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--secondary:hover {
    border-color: #ffffff;
    color: #3b3e40;
    background: #ffffff;
  }

  #NaviewVideoHero-{{ section.id }} .naview-video-hero__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  @keyframes naview-hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(2px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @media screen and (min-width: 1600px) {
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__content {
      padding-right: 48px;
      padding-left: 48px;
    }
  }

  @media screen and (max-width: 989px) {
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--two {
      font-size: clamp(48px, 7vw, 60px);
      line-height: 1.12;
      letter-spacing: -0.025em;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--three {
      font-size: clamp(22px, 3vw, 26px);
      line-height: 1.2;
    }
  }

  @media screen and (max-width: 989px) {
    #NaviewVideoHero-{{ section.id }} {
      height: var(--nv-mobile-height);
      min-height: 400px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__video,
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__poster {
      object-position: {{ section.settings.mobile_video_position }};
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(0, 0, 0, calc(var(--nv-overlay-opacity) * 0.40)) 0%,
          rgba(0, 0, 0, calc(var(--nv-overlay-opacity) * 0.72)) 36%,
          rgba(0, 0, 0, calc(var(--nv-overlay-opacity) + 0.22)) 100%
        );
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__content {
      display: block;
      padding: 0;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__copy {
      position: relative;
      width: 100%;
      height: 100%;
      text-align: left;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line {
      position: absolute;
      width: auto;
      margin: 0;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--one {
      top: 24px;
      left: 20px;
      min-height: 24px;
      font-size: 24px;
      line-height: 24px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__brand-wordmark {
      font-size: 24px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--two {
      top: 60px;
      right: 20px;
      left: 20px;
      min-height: 0;
      max-width: none;
      font-size: clamp(22px, 6.75vw, 28px);
      line-height: 1;
      letter-spacing: -0.05em;
      white-space: nowrap;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--three {
      right: 20px;
      bottom: 86px;
      left: 20px;
      min-height: 0;
      max-width: none;
      font-size: clamp(14px, 4vw, 16px);
      line-height: 1.25;
      letter-spacing: -0.02em;
      text-align: center;
      white-space: nowrap;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions {
      position: absolute;
      right: 20px;
      bottom: 24px;
      left: 20px;
      justify-content: center;
      flex-wrap: nowrap;
      gap: 10px;
      margin: 0;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__button {
      min-height: 46px;
      padding: 0 18px;
      font-size: 15px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--secondary {
      padding: 0 17px;
    }
  }

  @media screen and (max-width: 370px) {
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__actions {
      flex-direction: row;
      align-items: center;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__button {
      width: auto;
      padding: 0 15px;
      font-size: 14px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__button--secondary {
      padding: 0 14px;
    }

    #NaviewVideoHero-{{ section.id }} .naview-video-hero__line--three {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__copy {
      animation: none;
      transform: none;
    }
  }

  /* The background includes its own copy and a photographic area for the CTAs. */
  #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow {
    height: auto;
    min-height: 0;
    aspect-ratio: 2 / 1;
    touch-action: pan-y;
  }
  #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__line,
  #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__overlay { display: none; }
  #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__media { position: absolute; inset: 0; height: 100%; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__track { display: flex; width: 100%; height: 100%; will-change: transform; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__slide { flex: 0 0 100%; width: 100%; height: 100%; position: relative; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__slide img { display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; pointer-events: none; }
  #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__content { position: absolute; inset: 0; height: 100%; padding: 0; pointer-events: none; }
  #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__copy { width: 100%; height: 100%; animation: none; }
  #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__actions { position: absolute; left: 32px; right: auto; bottom: 28px; margin: 0; pointer-events: auto; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__slideshow-controls { position: absolute; z-index: 3; right: 28px; bottom: 28px; display: flex; align-items: center; gap: 4px; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__slideshow-controls button { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; color: #fff; background: rgba(5, 8, 13, .22); cursor: pointer; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__slide-dot::after { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #ffffff80; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__slide-dot[aria-current="true"]::after { background: #fff; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__pause .play-icon,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__pause[data-paused="true"] .pause-icon { display: none; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__pause[data-paused="true"] .play-icon { display: inline; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__arrow { position: absolute; z-index: 3; top: 50%; transform: translateY(-50%); display: grid; place-items: center; width: 36px; height: 44px; padding: 8px; border: 1px solid #ffffff55; border-radius: 10px; background: rgba(5, 8, 13, .36); color: #fff; cursor: pointer; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__arrow--previous { left: 8px; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__arrow--next { right: 8px; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__arrow svg { width: 100%; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__arrow:focus-visible,
  #NaviewVideoHero-{{ section.id }} .naview-video-hero__slideshow-controls button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media screen and (min-width: 1600px) {
    #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__actions { left: 48px; }
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__slideshow-controls { right: 48px; }
  }
  @media screen and (max-width: 989px) {
    #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__actions { left: 20px; right: 20px; bottom: 12px; justify-content: center; }
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__slideshow-controls { top: 8px; right: 8px; bottom: auto; }
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__slideshow-controls .naview-video-hero__slide-dot,
    #NaviewVideoHero-{{ section.id }} .naview-video-hero__arrow { display: none; }
  }
  @media screen and (max-width: 370px) {
    #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__actions { bottom: 10px; }
    #NaviewVideoHero-{{ section.id }}.naview-video-hero--slideshow .naview-video-hero__button { min-height: 40px; }
  }

{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('NaviewVideoHero-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;

    root.dataset.initialized = 'true';

    const video = root.querySelector('video');
    if (video) {
      video.muted = true;
      video.defaultMuted = true;
      video.loop = true;
      video.playsInline = true;
      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(() => {});
      }
    }

  })();
</script>

{% schema %}
{
  "name": "Premium mirror hero",
  "tag": "section",
  "class": "section-premium-mirror-hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_slideshow",
      "label": "Show the three image banners",
      "default": false,
      "info": "Displays the three extended banners with overlaid buttons and slides horizontally every 4 seconds."
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Background video"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Fallback image",
      "info": "Displayed before the video loads or when no video is selected."
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Desktop video position",
      "default": "50% 50%",
      "options": [
        {
          "value": "25% 50%",
          "label": "Left"
        },
        {
          "value": "50% 50%",
          "label": "Center"
        },
        {
          "value": "75% 50%",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_video_position",
      "label": "Mobile video position",
      "default": "50% 50%",
      "options": [
        {
          "value": "25% 50%",
          "label": "Left"
        },
        {
          "value": "50% 50%",
          "label": "Center"
        },
        {
          "value": "75% 50%",
          "label": "Right"
        }
      ]
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Find my vehicle link",
      "info": "Defaults to #cleardrive-models when left blank."
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Contact us link",
      "info": "Defaults to your WhatsApp link when left blank."
    },
    {
      "type": "range",
      "id": "hero_desktop_height",
      "min": 360,
      "max": 760,
      "step": 4,
      "unit": "px",
      "label": "Desktop height",
      "default": 384
    },
    {
      "type": "range",
      "id": "hero_mobile_height",
      "min": 400,
      "max": 800,
      "step": 4,
