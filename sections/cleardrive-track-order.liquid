{{ 'cleardrive-track-order.css' | asset_url | stylesheet_tag }}
<section class="cd-track-entry" aria-labelledby="cd-track-entry-title">
  <h1 id="cd-track-entry-title">{{ section.settings.heading | escape }}</h1>
  <p>{{ section.settings.introduction | escape }}</p>
  <p><a href="/apps/track123">Open order tracking</a></p>
</section>
{% unless request.design_mode %}
  <script>window.location.replace('/apps/track123');</script>
{% endunless %}
{% schema %}
{
  "name": "ClearDrive order lookup",
  "tag": "div",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your order" },
    { "type": "text", "id": "introduction", "label": "Introduction", "default": "Enter your order number and the email address used at checkout. No account required." }
  ]
}
{% endschema %}
