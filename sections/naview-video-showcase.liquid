{% comment %}
  Naview — DJI-style Video Product Feature
  Add this file to: Online Store > Themes > Edit code > Sections
{% endcomment %}

{% liquid
  assign section_dom_id = 'naview-video-' | append: section.id
  assign video_url = section.settings.video_url
  assign buy_now_url = section.settings.buy_now_link | default: '#naview-models'
%}

<section
  id="{{ section_dom_id }}"
  class="naview-video"
  style="
    --video-bg: {{ section.settings.background }};
    --video-heading: {{ section.settings.heading_color }};
    --video-text: {{ section.settings.text_color }};
    --video-accent: {{ section.settings.accent_color }};
    --video-width: {{ section.settings.max_width }}px;
    --video-padding-top: {{ section.settings.padding_top }}px;
    --video-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="naview-video__container">
    <div class="naview-video__feature">
      <div class="naview-video__frame">
        {% if video_url != blank %}
          <iframe
            class="naview-video__iframe"
            src="https://www.youtube-nocookie.com/embed/{{ video_url.id }}?rel=0&playsinline=1&controls=1&autoplay=0&mute=0"
            title="{{ section.settings.video_title | escape }}"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        {% else %}
          <div class="naview-video__placeholder">
            <span class="naview-video__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="m9 7 8 5-8 5V7Z" fill="currentColor"/>
              </svg>
            </span>
            <p>Paste a YouTube link in this section's settings.</p>
          </div>
        {% endif %}
      </div>

      <div class="naview-video__product-copy">
        <h2 class="naview-video__product-title">Tailored to Fit Your Vehicle</h2>
        <p class="naview-video__price">from CAD 999</p>
        <a class="naview-video__buy-button" href="{{ buy_now_url }}">Buy Now</a>
      </div>
    </div>
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    padding: var(--video-padding-top) 24px var(--video-padding-bottom);
    background: #f5f5f5;
    font-family:
      "Open Sans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Arial,
      sans-serif;
  }

  #{{ section_dom_id }} *,
  #{{ section_dom_id }} *::before,
  #{{ section_dom_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .naview-video__container {
    width: min(var(--video-width), 100%);
    margin: 0 auto;
  }

  #{{ section_dom_id }} .naview-video__feature {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: #050505;
  }

  #{{ section_dom_id }} .naview-video__feature::after {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    height: 44%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
    content: "";
  }

  #{{ section_dom_id }} .naview-video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #050505;
  }

  #{{ section_dom_id }} .naview-video__iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  #{{ section_dom_id }} .naview-video__product-copy {
    position: absolute;
    z-index: 2;
    inset: 46px 24px auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #ffffff;
    text-align: center;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  #{{ section_dom_id }} .naview-video__product-title {
    max-width: 900px;
    margin: 0;
    color: inherit;
    font-size: clamp(30px, 3.1vw, 46px);
    font-weight: 600;
    line-height: 1.13;
    letter-spacing: -0.035em;
  }

  #{{ section_dom_id }} .naview-video__price {
    margin: 12px 0 0;
    color: inherit;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  #{{ section_dom_id }} .naview-video__buy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 108px;
    min-height: 42px;
    margin-top: 18px;
    padding: 0 24px;
    border: 1px solid #ffffff;
    border-radius: 100px;
    color: #111111;
    background: #ffffff;
    font-size: 15px;
    font-weight: 500;
    line-height: 20px;
    text-decoration: none;
    text-shadow: none;
    pointer-events: auto;
    transition:
      color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }

  #{{ section_dom_id }} .naview-video__buy-button:hover {
    color: #ffffff;
    background: #111111;
    transform: translateY(-1px);
  }

  #{{ section_dom_id }} .naview-video__buy-button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  #{{ section_dom_id }} .naview-video__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    height: 100%;
    padding: 24px;
    color: #ffffff;
    background: linear-gradient(135deg, #101010, #252525);
    text-align: center;
  }

  #{{ section_dom_id }} .naview-video__placeholder p {
    margin: 0;
    font-size: 15px;
    opacity: 0.76;
  }

  #{{ section_dom_id }} .naview-video__play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
    color: #111111;
    background: #ffffff;
  }

  #{{ section_dom_id }} .naview-video__play svg {
    width: 28px;
    height: 28px;
    margin-left: 3px;
  }

  @media screen and (max-width: 749px) {
    #{{ section_dom_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    #{{ section_dom_id }} .naview-video__feature {
      border-radius: 3px;
    }

    #{{ section_dom_id }} .naview-video__product-copy {
      inset: 22px 14px auto;
    }

    #{{ section_dom_id }} .naview-video__product-title {
      font-size: clamp(22px, 6.5vw, 30px);
      line-height: 1.12;
    }

    #{{ section_dom_id }} .naview-video__price {
      margin-top: 7px;
      font-size: 13px;
    }

    #{{ section_dom_id }} .naview-video__buy-button {
      min-width: 90px;
      min-height: 36px;
      margin-top: 11px;
      padding: 0 18px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 430px) {
    #{{ section_dom_id }} .naview-video__product-copy {
      inset: 15px 10px auto;
    }

    #{{ section_dom_id }} .naview-video__product-title {
      font-size: 19px;
    }

    #{{ section_dom_id }} .naview-video__price {
      margin-top: 4px;
      font-size: 11px;
    }

    #{{ section_dom_id }} .naview-video__buy-button {
      min-width: 78px;
      min-height: 32px;
      margin-top: 8px;
      padding: 0 14px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_dom_id }} .naview-video__buy-button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Naview video feature",
  "tag": "section",
  "class": "section-naview-video",
  "settings": [
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube"],
      "label": "YouTube video link"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video accessibility title",
      "default": "Naview digital rearview mirror demonstration"
    },
    {
      "type": "url",
      "id": "buy_now_link",
      "label": "Buy Now link",
      "info": "Defaults to the vehicle model section when left blank."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#F7FAFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#071B3E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description colour",
      "default": "#536176"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#1769E0"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "label": "Maximum video width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Naview video feature"
    }
  ]
}
{% endschema %}
