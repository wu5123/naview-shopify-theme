{% comment %}
  Cleardrive — full-width Shopify video product feature
  Upload the video directly in the Shopify theme editor.
{% endcomment %}

{% liquid
  assign section_dom_id = 'naview-video-' | append: section.id
  assign showcase_video = section.settings.showcase_video
  assign buy_now_url = section.settings.buy_now_link | default: '#cleardrive-models'
%}

<section
  id="{{ section_dom_id }}"
  class="naview-video"
  style="
    --video-desktop-height: {{ section.settings.desktop_height }}px;
    --video-mobile-height: {{ section.settings.mobile_height }}px;
  "
  data-naview-video-feature
>
  <div class="naview-video__section-header">
    <div class="naview-video__section-header-inner">
      <h2 class="naview-video__section-heading">See it in action</h2>
    </div>
  </div>

  <div class="naview-video__feature">
    <div class="naview-video__media" aria-hidden="true">
      {% if showcase_video != blank %}
        {{
          showcase_video
          | video_tag:
            autoplay: false,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            image_size: '2400x',
            class: 'naview-video__video'
        }}
      {% else %}
        <div class="naview-video__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'naview-video__placeholder-image' }}
          <p>Upload a Shopify-hosted video in this section's settings.</p>
        </div>
      {% endif %}
    </div>

    <div class="naview-video__shade" aria-hidden="true"></div>

    <div class="naview-video__product-copy">
      <h2 class="naview-video__product-title">Tailored to Fit Your Vehicle</h2>
      <p class="naview-video__price">from CAD 999</p>
      <a class="naview-video__buy-button" href="{{ buy_now_url }}">Buy Now</a>
    </div>

    {% if showcase_video != blank %}
      <button
        class="naview-video__sound-button"
        type="button"
        aria-label="Turn sound on"
        aria-pressed="false"
        data-sound-toggle
      >
        <svg class="naview-video__sound-icon naview-video__sound-icon--off" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 9.5v5h3.5l4.5 3.5V6L7.5 9.5H4Z" fill="currentColor"/>
          <path d="m16 9 5 5m0-5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <svg class="naview-video__sound-icon naview-video__sound-icon--on" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 9.5v5h3.5l4.5 3.5V6L7.5 9.5H4Z" fill="currentColor"/>
          <path d="M15.5 9.2a4 4 0 0 1 0 5.6M18 6.8a7.2 7.2 0 0 1 0 10.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    {% endif %}
  </div>
</section>

{% style %}
  #{{ section_dom_id }} {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #050505;
    font-family:
      "Open Sans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Arial,
      sans-serif;
  }

  #{{ section_dom_id }} *,
  #{{ section_dom_id }} *::before,
  #{{ section_dom_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_dom_id }} .naview-video__feature {
    position: relative;
    width: 100%;
    height: var(--video-desktop-height);
    min-height: 520px;
    overflow: hidden;
    background: #050505;
  }

  #{{ section_dom_id }} .naview-video__section-header {
    padding: 56px 24px 32px;
    color: #071b3e;
    background: #f7faff;
  }

  #{{ section_dom_id }} .naview-video__section-header-inner {
    width: min(1480px, 100%);
    margin: 0 auto;
  }

  #{{ section_dom_id }} .naview-video__section-heading {
    margin: 0;
    color: inherit;
    font-size: clamp(34px, 3vw, 40px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
    text-align: left;
  }

  #{{ section_dom_id }} .naview-video__media,
  #{{ section_dom_id }} .naview-video__shade,
  #{{ section_dom_id }} .naview-video__video,
  #{{ section_dom_id }} .naview-video__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #{{ section_dom_id }} .naview-video__media {
    z-index: 0;
  }

  #{{ section_dom_id }} .naview-video__video {
    display: block;
    border: 0;
    object-fit: cover;
    object-position: {{ section.settings.video_position }};
    background: #050505;
  }

  #{{ section_dom_id }} .naview-video__shade {
    z-index: 1;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.62) 0%,
        rgba(0, 0, 0, 0.34) 34%,
        rgba(0, 0, 0, 0.08) 62%,
        rgba(0, 0, 0, 0) 100%
      );
    pointer-events: none;
  }

  #{{ section_dom_id }} .naview-video__product-copy {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: clamp(32px, 4vw, 64px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(560px, calc(100% - 64px));
    color: #ffffff;
    text-align: left;
    transform: translateY(-50%);
  }

  #{{ section_dom_id }} .naview-video__product-title {
    max-width: 540px;
    margin: 0;
    color: inherit;
    font-size: clamp(38px, 4vw, 56px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  #{{ section_dom_id }} .naview-video__price {
    margin: 20px 0 0;
    color: inherit;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  #{{ section_dom_id }} .naview-video__buy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    min-height: 44px;
    margin-top: 20px;
    padding: 0 26px;
    border: 1px solid #ffffff;
    border-radius: 100px;
    color: #111111;
    background: #ffffff;
    font-size: 15px;
    font-weight: 500;
    line-height: 20px;
    text-decoration: none;
    transition:
      color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }

  #{{ section_dom_id }} .naview-video__buy-button:hover {
    color: #ffffff;
    background: #111111;
    transform: translateY(-1px);
  }

  #{{ section_dom_id }} .naview-video__buy-button:focus-visible,
  #{{ section_dom_id }} .naview-video__sound-button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  #{{ section_dom_id }} .naview-video__sound-button {
    position: absolute;
    z-index: 3;
    right: clamp(20px, 3vw, 44px);
    bottom: clamp(20px, 3vw, 38px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.74);
    border-radius: 50%;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.30);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  #{{ section_dom_id }} .naview-video__sound-button:hover {
    color: #111111;
    background: #ffffff;
    transform: scale(1.04);
  }

  #{{ section_dom_id }} .naview-video__sound-icon {
    width: 21px;
    height: 21px;
  }

  #{{ section_dom_id }} .naview-video__sound-icon--on {
    display: none;
  }

  #{{ section_dom_id }} .naview-video__sound-button[aria-pressed="true"] .naview-video__sound-icon--off {
    display: none;
  }

  #{{ section_dom_id }} .naview-video__sound-button[aria-pressed="true"] .naview-video__sound-icon--on {
    display: block;
  }

  #{{ section_dom_id }} .naview-video__placeholder {
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #ffffff;
    background: linear-gradient(135deg, #111111, #282828);
  }

  #{{ section_dom_id }} .naview-video__placeholder-image {
    width: 100%;
    height: 100%;
    opacity: 0.20;
    object-fit: cover;
  }

  #{{ section_dom_id }} .naview-video__placeholder p {
    position: absolute;
    margin: 0;
    padding: 20px;
    font-size: 15px;
    text-align: center;
  }

  @media screen and (min-width: 1600px) {
    #{{ section_dom_id }} .naview-video__product-copy {
      left: 48px;
    }
  }

  @media screen and (max-width: 767px) {
    #{{ section_dom_id }} .naview-video__section-header {
      padding: 40px 20px 24px;
    }

    #{{ section_dom_id }} .naview-video__section-heading {
      font-size: 30px;
    }

    #{{ section_dom_id }} .naview-video__feature {
      height: var(--video-mobile-height);
      min-height: 460px;
    }

    #{{ section_dom_id }} .naview-video__video {
      object-position: {{ section.settings.mobile_video_position }};
    }

    #{{ section_dom_id }} .naview-video__shade {
      background:
        linear-gradient(
          180deg,
          rgba(0, 0, 0, 0.64) 0%,
          rgba(0, 0, 0, 0.26) 50%,
          rgba(0, 0, 0, 0.12) 100%
        );
    }

    #{{ section_dom_id }} .naview-video__product-copy {
      top: 48px;
      left: 20px;
      width: calc(100% - 40px);
      transform: none;
    }

    #{{ section_dom_id }} .naview-video__product-title {
      max-width: 420px;
      font-size: clamp(30px, 9vw, 42px);
      line-height: 1.08;
    }

    #{{ section_dom_id }} .naview-video__price {
      margin-top: 13px;
      font-size: 15px;
    }

    #{{ section_dom_id }} .naview-video__buy-button {
      min-width: 98px;
      min-height: 40px;
      margin-top: 15px;
      padding: 0 22px;
      font-size: 14px;
    }

    #{{ section_dom_id }} .naview-video__sound-button {
      right: 18px;
      bottom: 18px;
      width: 42px;
      height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_dom_id }} .naview-video__buy-button,
    #{{ section_dom_id }} .naview-video__sound-button {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('{{ section_dom_id }}');
    if (!root || root.dataset.videoInitialized === 'true') return;

    const video = root.querySelector('video');
    if (!video) return;

    root.dataset.videoInitialized = 'true';
    video.muted = true;
    video.defaultMuted = true;
    video.loop = true;
    video.playsInline = true;

    const soundButton = root.querySelector('[data-sound-toggle]');
    const setSoundState = (soundOn) => {
      video.muted = !soundOn;
      soundButton?.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
      soundButton?.setAttribute('aria-label', soundOn ? 'Mute video' : 'Turn sound on');
    };

    soundButton?.addEventListener('click', () => {
      const soundOn = video.muted;
      setSoundState(soundOn);
      if (soundOn) {
        video.volume = 1;
        const playPromise = video.play();
        if (playPromise && typeof playPromise.catch === 'function') {
          playPromise.catch(() => {});
        }
      }
    });

    const playVideo = () => {
      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(() => {});
      }
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.35) {
            playVideo();
          } else {
            video.pause();
          }
        });
      }, { threshold: [0, 0.35, 0.75] });

      observer.observe(root);
    } else {
      playVideo();
    }
  })();
</script>

{% schema %}
{
  "name": "Cleardrive video feature",
  "tag": "section",
  "class": "section-naview-video",
  "settings": [
    {
      "type": "video",
      "id": "showcase_video",
      "label": "Showcase video",
      "info": "Upload a Shopify-hosted video. It starts automatically, muted, when this section enters the screen. Visitors can turn sound on."
    },
    {
      "type": "url",
      "id": "buy_now_link",
      "label": "Buy Now link",
      "info": "Defaults to the vehicle model section when left blank."
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Desktop video position",
      "default": "50% 50%",
      "options": [
        { "value": "25% 50%", "label": "Left" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "75% 50%", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_video_position",
      "label": "Mobile video position",
      "default": "50% 50%",
      "options": [
        { "value": "25% 50%", "label": "Left" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "75% 50%", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 520,
      "max": 760,
      "step": 20,
      "unit": "px",
      "label": "Desktop height",
      "default": 640
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 460,
      "max": 720,
      "step": 20,
      "unit": "px",
      "label": "Mobile height",
      "default": 560
    }
  ],
  "presets": [
    {
      "name": "Cleardrive video feature"
    }
  ]
}
{% endschema %}
