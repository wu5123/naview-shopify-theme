<script>
  (() => {
    const root = document.querySelector('[data-vehicle="{{ section.id }}"]');
    if (!root) return;
    const hero = root.querySelector('.vehicle-gallery__hero');
    const galleryStage = root.querySelector('.vehicle-gallery__stage');
    const galleryEmpty = root.querySelector('[data-gallery-empty]');
    const galleryVideoWrap = root.querySelector('[data-gallery-video]');
    const galleryVideo = root.querySelector('.vehicle-gallery__video');
    const allMediaItems = [...root.querySelectorAll('[data-gallery-item]')];
    const mainPrevious = root.querySelector('[data-gallery-main-previous]');
    const mainNext = root.querySelector('[data-gallery-main-next]');
    const thumbnailRail = root.querySelector('.vehicle-gallery__thumbnails');
    const thumbnailPrevious = root.querySelector('[data-gallery-scroll-previous]');
    const thumbnailNext = root.querySelector('[data-gallery-scroll-next]');
    let mediaItems = [];
    let activeMediaIndex = 0;
    let mediaTransitionTimer;
    const updateThumbnailNavigation = () => {
      if (!thumbnailRail) return;
      if (thumbnailPrevious) thumbnailPrevious.disabled = thumbnailRail.scrollLeft <= 4;
      if (thumbnailNext) thumbnailNext.disabled = thumbnailRail.scrollLeft + thumbnailRail.clientWidth >= thumbnailRail.scrollWidth - 4;
    };
    const updateMainNavigation = () => {
      const disabled = mediaItems.length < 2;
      if (mainPrevious) mainPrevious.disabled = disabled;
      if (mainNext) mainNext.disabled = disabled;
    };
    const showMedia = (item, immediate = false) => {
      if (!item || item.hidden) return;
      activeMediaIndex = mediaItems.indexOf(item);
      const isVideo = item.dataset.mediaType === 'video';
      galleryStage?.classList.toggle('is-option-main', item.dataset.optionMain === 'true');
      allMediaItems.forEach((mediaItem) => {
        const isActive = mediaItem === item;
        mediaItem.classList.toggle('is-active', isActive);
        mediaItem.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      window.clearTimeout(mediaTransitionTimer);
      if (isVideo) {
        hero?.setAttribute('hidden', '');
        galleryEmpty?.setAttribute('hidden', '');
        if (galleryVideoWrap) {
          galleryVideoWrap.removeAttribute('hidden');
          galleryVideo.play().catch(() => {});
        }
        updateMainNavigation();
        return;
      }
      if (hero && item.dataset.image) {
        const updateHero = () => {
          hero.src = item.dataset.image;
          hero.srcset = '';
          hero.removeAttribute('hidden');
          hero.style.opacity = '1';
        };
        if (immediate) {
          updateHero();
        } else {
          hero.style.opacity = '0';
          mediaTransitionTimer = window.setTimeout(updateHero, 130);
        }
      }
      galleryEmpty?.setAttribute('hidden', '');
      if (galleryVideoWrap) {
        galleryVideo.pause();
        galleryVideoWrap.setAttribute('hidden', '');
      }
      updateMainNavigation();
    };
    const showGalleryGroup = (galleryGroup, immediate = false) => {
      allMediaItems.forEach((item) => {
        const isVisible = item.dataset.galleryGroup === galleryGroup || item.dataset.galleryGroup === 'shared';
        item.hidden = !isVisible;
        if (!isVisible) {
          item.classList.remove('is-active');
          item.setAttribute('aria-selected', 'false');
        }
      });
      mediaItems = allMediaItems.filter((item) => !item.hidden);
      activeMediaIndex = 0;
      thumbnailRail?.scrollTo({ left: 0, behavior: 'auto' });
      showMedia(mediaItems[0], immediate);
      requestAnimationFrame(updateThumbnailNavigation);
    };
    allMediaItems.forEach((item) => item.addEventListener('click', () => showMedia(item)));
    mainPrevious?.addEventListener('click', () => {
      if (mediaItems.length < 2) return;
      showMedia(mediaItems[(activeMediaIndex - 1 + mediaItems.length) % mediaItems.length]);
    });
    mainNext?.addEventListener('click', () => {
      if (mediaItems.length < 2) return;
      showMedia(mediaItems[(activeMediaIndex + 1) % mediaItems.length]);
    });
    const thumbnailScrollStep = () => Math.max(thumbnailRail.clientWidth * .72, 220);
    thumbnailPrevious?.addEventListener('click', () => {
      if (!thumbnailRail) return;
      if (thumbnailRail.scrollLeft <= thumbnailScrollStep() + 4) {
        thumbnailRail.scrollTo({ left: 0, behavior: 'smooth' });
        return;
      }
      thumbnailRail.scrollBy({ left: -thumbnailScrollStep(), behavior: 'smooth' });
    });
    thumbnailNext?.addEventListener('click', () => {
      if (!thumbnailRail) return;
      thumbnailRail.scrollBy({ left: thumbnailScrollStep(), behavior: 'smooth' });
    });
    thumbnailRail?.addEventListener('scroll', updateThumbnailNavigation, { passive: true });
    window.addEventListener('resize', updateThumbnailNavigation);
    showGalleryGroup(root.querySelector('[data-option]:checked')?.dataset.galleryGroup || 'core', true);
    root.querySelector('[data-year]')?.addEventListener('change', (event) => { window.location.href = event.target.value; });
    const installationService = root.querySelector('[data-installation-service]');
    const addToCartButtons = [...root.querySelectorAll('[data-purchase-action="cart"]')];
    const buyNowLink = root.querySelector('[data-purchase-action="checkout"]');
    const cartRootUrl = {{ routes.root_url | append: 'cart' | json }};
    const currencyCode = root.dataset.currencyCode || 'CAD';
    const currencyFormatter = new Intl.NumberFormat('en-CA', {
      style: 'currency',
      currency: currencyCode,
      currencyDisplay: 'narrowSymbol'
    });
    const formatPrice = (cents) => `${currencyFormatter.format(cents / 100)} ${currencyCode}`;
    const updateBuyNowHref = () => {
      if (!buyNowLink) return;
      const selectedOption = root.querySelector('[data-option]:checked');
      if (!selectedOption || selectedOption.dataset.available !== 'true') {
        buyNowLink.removeAttribute('href');
        buyNowLink.setAttribute('aria-disabled', 'true');
        return;
      }
      const quantity = Math.max(1, Number.parseInt(buyNowLink.dataset.quantity || '1', 10) || 1);
      const checkoutItems = [`${selectedOption.value}:${quantity}`];
      if (installationService?.checked && installationService.dataset.available === 'true') {
        checkoutItems.push(`${installationService.dataset.variantId}:${quantity}`);
      }
      buyNowLink.href = `${cartRootUrl}/${checkoutItems.join(',')}`;
      buyNowLink.removeAttribute('aria-disabled');
    };
    const updateLivePrice = () => {
      const selectedOption = root.querySelector('[data-option]:checked');
      if (!selectedOption) return;
      const productPrice = Number.parseInt(selectedOption.dataset.priceCents || '0', 10) || 0;
      const installationPrice = installationService?.checked
        ? Number.parseInt(installationService.dataset.priceCents || '0', 10) || 0
        : 0;
      root.querySelector('[data-bar-price]').textContent = formatPrice(productPrice + installationPrice);
      updateBuyNowHref();
    };
    installationService?.addEventListener('change', updateLivePrice);
    updateLivePrice();
    root.querySelectorAll('[data-option]').forEach((input) => input.addEventListener('change', () => {
      root.querySelectorAll('.vehicle-option').forEach((card) => card.classList.remove('is-selected'));
      input.closest('.vehicle-option').classList.add('is-selected');
      const available = input.dataset.available === 'true';
      root.querySelector('[data-price]').textContent = input.dataset.price;
      root.querySelector('[data-bar-stock]').textContent = available ? 'In Stock' : 'Out of Stock';
      root.querySelector('[data-bar-stock-detail]').textContent = available ? 'Ready to ship' : 'Currently unavailable';
      root.querySelectorAll('[data-variant]').forEach((field) => {
        field.value = input.value;
        field.setAttribute('value', input.value);
      });
      root.querySelectorAll('.vehicle-fixed-buy__actions button').forEach((button) => { button.disabled = !available; });
      updateLivePrice();
      if (input.dataset.galleryGroup) showGalleryGroup(input.dataset.galleryGroup);
    }));
    addToCartButtons.forEach((button) => button.addEventListener('click', async () => {
      const selectedOption = root.querySelector('[data-option]:checked');
      if (!selectedOption || selectedOption.dataset.available !== 'true') return;
      const includeService = Boolean(installationService?.checked && installationService.dataset.available === 'true');
      const quantity = Math.max(1, Number.parseInt(button.dataset.quantity || '1', 10) || 1);
      const selectedVariantId = selectedOption.value;
      const installationVariantId = includeService ? installationService.dataset.variantId : '';

      const bundleId = includeService
        ? `cleardrive-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
        : '';
      const items = [{
        id: Number(selectedVariantId),
        quantity,
        ...(bundleId ? { properties: { _cleardrive_bundle: bundleId, _cleardrive_role: 'product' } } : {})
      }];
      if (installationVariantId) {
        items.push({
          id: Number(installationVariantId),
          quantity,
          properties: { _cleardrive_bundle: bundleId, _cleardrive_role: 'service' }
        });
      }
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(`${cartRootUrl}/add.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ items })
        });
        const responseData = await response.json();
        if (!response.ok) throw new Error(responseData.description || 'Unable to add the selected items.');
        window.location.assign(cartRootUrl);
      } catch (error) {
        console.error('Cleardrive cart error:', error);
        window.alert(error.message || 'Unable to add the selected items. Please try again.');
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    }));
    const guideVideo = root.querySelector('.vehicle-video__element');
    const sound = root.querySelector('[data-sound]');
    if (guideVideo) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) { guideVideo.pause(); return; }
        guideVideo.muted = false;
        guideVideo.play().catch(() => { guideVideo.muted = true; guideVideo.play(); if (sound) sound.hidden = false; });
      }), { threshold: .45 });
      observer.observe(guideVideo);
      sound?.addEventListener('click', () => { guideVideo.muted = false; guideVideo.play(); sound.hidden = true; });
    }
  })();
</script>

