{% liquid
  assign vehicle_product = product
  assign standard_variant = vehicle_product.variants[0]
  assign install_variant = vehicle_product.variants[1] | default: standard_variant
  assign standard_price = standard_variant.price | money_with_currency
  assign install_price = install_variant.price | money_with_currency
  assign default_vehicle_image = product.featured_image | default: section.settings.fallback_image
  assign gallery_1 = section.settings.gallery_1 | default: default_vehicle_image
  assign option_1_image = section.settings.option_image_1 | default: gallery_1
  assign option_2_image = section.settings.option_image_2 | default: gallery_1
  assign vehicle_page_url = vehicle_product.url
  assign product_image_alt = vehicle_product.title | append: ' custom-fit digital rear mirror'
  assign feature_image_alt = vehicle_product.title | append: ' product feature'
%}

<section class="vehicle-store" data-vehicle="{{ section.id }}">
  <div class="vehicle-store__product">
    <div class="vehicle-gallery">
      <div class="vehicle-media-window">
        <div class="vehicle-gallery__stage">
          {% if gallery_1 != blank %}
            {{ gallery_1 | image_url: width: 1800 | image_tag: class: 'vehicle-gallery__hero', loading: 'eager', widths: '720, 1080, 1440, 1800', sizes: '(min-width: 990px) 58vw, 100vw', alt: product_image_alt }}
          {% else %}
            <div class="vehicle-gallery__empty" data-gallery-empty><strong>{{ vehicle_product.title | escape }}</strong><span>Upload the primary product image</span></div>
          {% endif %}
          {% if section.settings.gallery_video != blank %}
            <div class="vehicle-gallery__video-wrap" data-gallery-video hidden>
              {{ section.settings.gallery_video | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', class: 'vehicle-gallery__video' }}
            </div>
          {% endif %}
          <button class="vehicle-gallery__stage-arrow vehicle-gallery__stage-arrow--previous" type="button" aria-label="Previous product media" data-gallery-main-previous>‹</button>
          <button class="vehicle-gallery__stage-arrow vehicle-gallery__stage-arrow--next" type="button" aria-label="Next product media" data-gallery-main-next>›</button>
        </div>
      </div>
      <div class="vehicle-gallery__thumbnail-rail">
        <button class="vehicle-gallery__thumbnail-previous" type="button" aria-label="Show previous product media" data-gallery-scroll-previous>‹</button>
        <div class="vehicle-gallery__thumbnails" role="tablist" aria-label="Choose product media">
          {% for i in (1..4) %}
            {% assign key = 'gallery_' | append: i %}
            {% assign gallery_image = section.settings[key] %}
            {% if i == 1 and gallery_image == blank %}{% assign gallery_image = default_vehicle_image %}{% endif %}
            {% if gallery_image != blank %}
              <button type="button" class="vehicle-gallery__thumbnail{% if i == 1 %} is-active{% endif %}" role="tab" aria-selected="{% if i == 1 %}true{% else %}false{% endif %}" data-gallery-item data-media-type="image" data-image="{{ gallery_image | image_url: width: 1800 }}" aria-label="View photo {{ i }}">
                {{ gallery_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '140px', alt: product_image_alt }}
              </button>
            {% endif %}
          {% endfor %}
          {% if section.settings.gallery_video != blank %}
            <button type="button" class="vehicle-gallery__thumbnail vehicle-gallery__thumbnail--video" role="tab" aria-selected="false" data-gallery-item data-media-type="video" aria-label="Play product video">
              {% if section.settings.gallery_video.preview_image != blank %}
                {{ section.settings.gallery_video.preview_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '140px', alt: product_image_alt }}
              {% else %}
                <span>Product video</span>
              {% endif %}
              <span class="vehicle-gallery__play" aria-hidden="true">▶</span>
            </button>
          {% endif %}
        </div>
        <button class="vehicle-gallery__thumbnail-next" type="button" aria-label="Show more product media" data-gallery-scroll-next>›</button>
      </div>
    </div>

    <aside class="vehicle-buy">
      <div class="vehicle-buy__inner">
        <h1>{{ vehicle_product.title | escape }}</h1>

        <div class="vehicle-year">
          <label for="vehicle-year-{{ section.id }}">Select Year</label>
          <div class="vehicle-select-wrap">
            <select id="vehicle-year-{{ section.id }}" data-year>
              <option value="{{ vehicle_page_url }}">2022–2024</option>
              <option value="{% if section.settings.year_2019_product != blank %}{{ section.settings.year_2019_product.url }}{% else %}{{ vehicle_page_url }}{% endif %}">2019–2021</option>
              <option value="{% if section.settings.year_2025_product != blank %}{{ section.settings.year_2025_product.url }}{% else %}{{ vehicle_page_url }}{% endif %}">2025+</option>
            </select>
          </div>
        </div>

        <p class="vehicle-price" data-price>{{ standard_price }}</p>

        <div class="vehicle-info-card">
          <div class="vehicle-info-row vehicle-info-row--shipping">
            <div class="vehicle-info-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32"><path d="M3.5 9.5h15v11h-15zM18.5 13h5.5l4.5 5v2.5h-10z" fill="none"/><circle cx="9" cy="23" r="2.5"/><circle cx="23.5" cy="23" r="2.5"/><path d="M5.5 23h1M11.5 23h9.5M26 23h2"/></svg>
            </div>
            <div class="vehicle-info-copy"><p>Free Shipping</p><p>Up to 30-Day Returns</p></div>
            <span class="vehicle-info-arrow" aria-hidden="true">›</span>
          </div>
        </div>

        {% if section.blocks.size > 0 %}
          <section class="vehicle-features-card" aria-labelledby="vehicle-features-heading-{{ section.id }}">
            <h2 id="vehicle-features-heading-{{ section.id }}" class="vehicle-features-card__heading">{{ section.settings.features_heading | default: 'Key Features' | escape }}</h2>
            <div class="vehicle-features-card__list">
              {% for block in section.blocks %}
                <div class="vehicle-feature" {{ block.shopify_attributes }}>
                  <div class="vehicle-feature__icon" aria-hidden="true">
                    {% case block.settings.icon %}
                      {% when 'display' %}
                        <svg viewBox="0 0 32 32"><rect x="5" y="6" width="22" height="16" rx="1"/><path d="M16 22v4M10 27h12"/></svg>
                      {% when 'touch' %}
                        <svg viewBox="0 0 32 32"><path d="M14 28V15.5a2 2 0 0 1 4 0v5.2l1.1-1.1a2 2 0 0 1 2.8 0l.4.4.7-.7a2 2 0 0 1 2.8 0l.8.8.4-.4a2 2 0 0 1 2.8 0l.2.2c.8.8 1.2 1.9 1.1 3L29.7 28"/><path d="M14 18.5l-2.2-2.2a2 2 0 0 0-2.8 0l-.2.2a2 2 0 0 0 0 2.8l5.2 5.2"/><path d="M7 6h8M7 10h5"/></svg>
                      {% when 'shield' %}
                        <svg viewBox="0 0 32 32"><path d="M16 3.8 26 7.6v7.2c0 6.1-4.2 10.9-10 13.4-5.8-2.5-10-7.3-10-13.4V7.6L16 3.8Z"/><path d="m11.5 15.8 3 3 6-6"/></svg>
                      {% else %}
                        <svg viewBox="0 0 32 32"><path d="M5 10h6l1.6-2.5h6.8L21 10h6v16H5Z"/><circle cx="16" cy="18" r="4.2"/></svg>
                    {% endcase %}
                  </div>
                  <p>{{ block.settings.text | escape | newline_to_br }}</p>
                </div>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <div class="vehicle-options">
          <h2>Select Option</h2>
          <label class="vehicle-option is-selected">
            <input type="radio" name="vehicle-option-{{ section.id }}" value="{{ standard_variant.id }}" data-option data-price="{{ standard_price | escape }}" data-available="{{ standard_variant.available }}" checked>
            <span class="vehicle-option__media">{% if option_1_image != blank %}{{ option_1_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '' }}{% else %}<span>Photo</span>{% endif %}</span>
            <span class="vehicle-option__copy"><strong>{{ standard_variant.title | escape }}</strong><b>{{ standard_price }}</b><small class="vehicle-option__stock">{% if standard_variant.available %}In Stock{% else %}Out of Stock{% endif %}</small></span>
          </label>
          <label class="vehicle-option">
            <input type="radio" name="vehicle-option-{{ section.id }}" value="{{ install_variant.id }}" data-option data-price="{{ install_price | escape }}" data-available="{{ install_variant.available }}">
            <span class="vehicle-option__media">{% if option_2_image != blank %}{{ option_2_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '' }}{% else %}<span>Photo</span>{% endif %}</span>
            <span class="vehicle-option__copy"><strong>{{ install_variant.title | escape }}</strong><b>{{ install_price }}</b><small class="vehicle-option__stock">{% if install_variant.available %}In Stock{% else %}Out of Stock{% endif %}</small></span>
          </label>
        </div>
      </div>
    </aside>
  </div>

  <section class="vehicle-guide">
    <div class="vehicle-content">
      <h2>Installation Guide</h2>
      <div class="vehicle-video">
        {% if section.settings.installation_video != blank %}
          {{ section.settings.installation_video | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', class: 'vehicle-video__element' }}
          <button class="vehicle-video__sound" type="button" hidden data-sound>Turn Sound On</button>
        {% else %}
          <div class="vehicle-video__empty"><span>Installation Guide</span><p>Upload your Shopify-hosted installation video in the theme editor.</p></div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="vehicle-posters">
    <div class="vehicle-content vehicle-poster-grid">
      {% for i in (1..6) %}
        {% assign key = 'poster_' | append: i %}
        {% assign poster = section.settings[key] %}
        <div class="vehicle-poster vehicle-poster--{{ i }}">
          {% if poster != blank %}{{ poster | image_url: width: 1600 | image_tag: loading: 'lazy', alt: feature_image_alt }}{% else %}<span>Poster {{ i }}</span>{% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
  <div class="vehicle-fixed-buy" data-fixed-buy>
    <div class="vehicle-fixed-buy__inner">
      <div class="vehicle-fixed-buy__stock">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3.5 9.5h15v11h-15zM18.5 13h5.5l4.5 5v2.5h-10z" fill="none"/><circle cx="9" cy="23" r="2.5"/><circle cx="23.5" cy="23" r="2.5"/><path d="M5.5 23h1M11.5 23h9.5M26 23h2"/></svg>
        <span><strong data-bar-stock>{% if standard_variant.available %}In Stock{% else %}Out of Stock{% endif %}</strong><small data-bar-stock-detail>{% if standard_variant.available %}Ready to ship{% else %}Currently unavailable{% endif %}</small></span>
      </div>
      <div class="vehicle-fixed-buy__actions">
        <strong data-bar-price>{{ standard_price }}</strong>
        <form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ standard_variant.id }}" data-variant><button class="vehicle-fixed-buy__cart" type="submit" {% unless standard_variant.available %}disabled{% endunless %}>Add to Cart</button></form>
        <form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ standard_variant.id }}" data-variant><input type="hidden" name="return_to" value="/checkout"><button class="vehicle-fixed-buy__now" type="submit" {% unless standard_variant.available %}disabled{% endunless %}>Buy Now</button></form>
      </div>
    </div>
  </div>
</section>

<style>
  .vehicle-store{--blue:#0060ef;--ink:#303233;--muted:#6b6f72;--line:#dfe2e4;--soft:#f4f6f7;background:#fff;color:var(--ink);font-family:Arial,"Helvetica Neue",sans-serif;padding-bottom:104px}
  .vehicle-store *{box-sizing:border-box}
  .vehicle-store__product{width:min(1348px,100%);margin:0 auto;display:grid;grid-template-columns:minmax(0,700px) minmax(500px,648px);align-items:start}
  .vehicle-gallery{position:sticky;top:0;height:calc(100vh - 172px);min-height:0;padding:0 28px 20px;background:#fff;display:grid;grid-template-rows:minmax(0,1fr) 108px;gap:14px}
  .vehicle-media-window{min-height:0;background:#fff;display:grid}
  .vehicle-gallery__stage{position:relative;width:100%;height:100%;min-height:0;display:grid;place-items:center;overflow:hidden;background:#fff}
  .vehicle-gallery__hero{width:100%;height:100%;padding:48px;object-fit:contain;transition:opacity .2s ease}
