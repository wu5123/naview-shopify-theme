  .vehicle-gallery__stage-arrow{position:absolute;top:50%;z-index:2;display:grid;place-items:center;width:48px;height:48px;transform:translateY(-50%);padding:0;border:0;border-radius:50%;background:rgba(35,38,42,.78);color:#fff;font-size:34px;line-height:1;cursor:pointer;transition:opacity .2s ease}.vehicle-gallery__stage-arrow--previous{left:18px}.vehicle-gallery__stage-arrow--next{right:18px}.vehicle-gallery__stage-arrow:disabled{opacity:.28;cursor:default}
  .vehicle-gallery__video-wrap{position:absolute;inset:0;background:#0b0c0d}.vehicle-gallery__video-wrap[hidden]{display:none}.vehicle-gallery__video{width:100%;height:100%;object-fit:contain;background:#0b0c0d}
  .vehicle-gallery__thumbnail-rail{position:relative;overflow:hidden;isolation:isolate}.vehicle-gallery__thumbnail-rail:before,.vehicle-gallery__thumbnail-rail:after{content:"";position:absolute;top:0;bottom:0;z-index:2;width:58px;background:#fff;pointer-events:none}.vehicle-gallery__thumbnail-rail:before{left:0}.vehicle-gallery__thumbnail-rail:after{right:0}.vehicle-gallery__thumbnails{position:relative;z-index:1;display:flex;gap:12px;overflow-x:auto;padding:0 54px 4px;scroll-snap-type:x proximity;scrollbar-width:thin;scrollbar-color:#c8cbcf transparent}
  .vehicle-gallery__thumbnail{position:relative;flex:0 0 140px;height:104px;padding:0;border:2px solid transparent;border-radius:10px;overflow:hidden;background:#f4f5f6;cursor:pointer;scroll-snap-align:start}.vehicle-gallery__thumbnail.is-active{border-color:#25272a}.vehicle-gallery__thumbnail img{display:block;width:100%;height:100%;object-fit:cover}.vehicle-gallery__thumbnail--video{display:grid;place-items:center;color:#fff;background:#0b0c0d;font-size:13px}.vehicle-gallery__thumbnail--video img{opacity:.75}.vehicle-gallery__play{position:absolute;left:50%;top:50%;display:grid;place-items:center;width:38px;height:38px;transform:translate(-50%,-50%);border-radius:50%;background:rgba(22,24,27,.84);color:#fff;font-size:14px;text-indent:2px}
  .vehicle-gallery__thumbnail-previous,.vehicle-gallery__thumbnail-next{position:absolute;top:50%;z-index:3;width:42px;height:52px;transform:translateY(-52%);border:0;background:#fff;color:#202326;font-size:34px;line-height:42px;cursor:pointer;transition:opacity .2s ease}.vehicle-gallery__thumbnail-previous{left:0;border-radius:0 26px 26px 0}.vehicle-gallery__thumbnail-next{right:0;border-radius:26px 0 0 26px}.vehicle-gallery__thumbnail-previous:disabled,.vehicle-gallery__thumbnail-next:disabled{opacity:.28;cursor:default}
  .vehicle-buy{min-width:0;padding:54px 74px 80px}.vehicle-buy__inner{width:500px;max-width:100%}.vehicle-buy h1{font-size:32px;font-weight:600;line-height:36px;letter-spacing:-.5px;margin:0 0 28px;color:#333}
  .vehicle-year label{display:block;margin:0 0 9px;font-size:14px;font-weight:600}.vehicle-select-wrap{position:relative}.vehicle-select-wrap:after{content:"⌄";position:absolute;right:16px;top:50%;transform:translateY(-57%);pointer-events:none}.vehicle-year select{appearance:none;width:100%;height:50px;border:1px solid #cfd3d5;border-radius:2px;background:#fff;padding:0 44px 0 16px;color:#333;font-size:15px}
  .vehicle-price{font-size:26px;line-height:32px;font-weight:600;margin:26px 0 20px}
  .vehicle-info-card{background:var(--soft);border-radius:12px;overflow:hidden;margin-top:8px}.vehicle-info-row{display:grid;grid-template-columns:34px 1fr 18px;gap:12px;padding:20px 26px}.vehicle-info-icon{width:28px;height:28px;color:#626669}.vehicle-info-icon svg{width:100%;height:100%;stroke:currentColor;stroke-width:1.9;fill:currentColor;stroke-linecap:round;stroke-linejoin:round}.vehicle-info-copy p{font-size:15px;line-height:22px;margin:0 0 6px}.vehicle-info-copy p:last-child{margin-bottom:0}.vehicle-info-arrow{font-size:30px;color:#555;align-self:center}
  .vehicle-features-card{margin-top:12px;border:1px solid #dfe2e4;border-radius:12px;background:#fff;box-shadow:0 4px 14px rgba(25,35,45,.05);overflow:hidden}.vehicle-features-card__heading{margin:0;padding:18px 22px 11px;color:#303233;font-size:18px;line-height:24px;font-weight:600}.vehicle-feature{display:grid;grid-template-columns:28px minmax(0,1fr);gap:14px;align-items:center;padding:11px 22px;border-top:1px solid #e2e5e7}.vehicle-feature__icon{width:27px;height:27px;color:#1c2734}.vehicle-feature__icon svg{display:block;width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}.vehicle-feature p{margin:0;color:#39424e;font-size:14px;line-height:20px}
  .vehicle-options{margin-top:34px}.vehicle-options h2{font-size:24px;line-height:30px;font-weight:600;margin:0 0 22px}.vehicle-option{position:relative;min-height:158px;border:1px solid #d4d7d9;border-radius:10px;padding:20px 22px;display:grid;grid-template-columns:120px 1fr;gap:20px;align-items:center;margin:0 0 12px;background:#fff;cursor:pointer}.vehicle-option.is-selected{border:2px solid var(--blue);padding:19px 21px}.vehicle-option input{position:absolute;opacity:0;pointer-events:none}.vehicle-option__media{width:112px;height:112px;display:grid;place-items:center;background:#f7f8f9;overflow:hidden;color:#999;font-size:12px}.vehicle-option__media img{width:100%;height:100%;object-fit:contain}.vehicle-option__copy{align-self:stretch;display:flex;flex-direction:column;justify-content:center}.vehicle-option__copy strong{display:block;font-size:18px;line-height:25px}.vehicle-option__copy b{display:block;font-size:17px;line-height:23px;margin-top:8px;font-weight:500}.vehicle-option__copy small.vehicle-option__stock{display:block;margin-top:auto;padding-top:10px;font-size:14px;line-height:18px;color:#167b42;font-weight:600}
  .vehicle-content{width:min(1348px,calc(100% - 48px));margin:0 auto}.vehicle-guide{padding:86px 0 28px;background:#fff}.vehicle-guide h2{font-size:32px;line-height:40px;text-align:center;margin:0 0 32px;font-weight:600}.vehicle-video{position:relative;aspect-ratio:16/7;background:#0a0a0a;overflow:hidden}.vehicle-video__element{width:100%;height:100%;object-fit:cover}.vehicle-video__empty{height:100%;display:grid;place-content:center;text-align:center;color:#fff}.vehicle-video__empty span{font-size:28px;font-weight:600}.vehicle-video__empty p{color:#aaa;margin:12px 0 0}.vehicle-video__sound{position:absolute;right:20px;bottom:20px;border:0;background:#fff;color:#111;padding:11px 16px;font-weight:600}
  .vehicle-posters{padding:0 0 90px;background:#fff}.vehicle-poster-grid{height:720px;display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:1fr 1fr;gap:12px}.vehicle-poster{background:#f2f4f5;overflow:hidden;display:grid;place-items:center;color:#9a9da0;font-size:14px}.vehicle-poster img{width:100%;height:100%;object-fit:cover}.vehicle-poster--1{grid-column:span 5;grid-row:span 2}.vehicle-poster--2{grid-column:span 4}.vehicle-poster--3{grid-column:span 3}.vehicle-poster--4{grid-column:span 3}.vehicle-poster--5{grid-column:span 2}.vehicle-poster--6{grid-column:span 2}
  .vehicle-fixed-buy{position:fixed;left:0;right:0;bottom:0;height:104px;background:#fff;border-top:1px solid #e3e5e7;box-shadow:0 -6px 22px rgba(0,0,0,.07);z-index:1000}.vehicle-fixed-buy__inner{width:min(1348px,calc(100% - 48px));height:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.vehicle-fixed-buy__stock{display:flex;align-items:center;gap:14px}.vehicle-fixed-buy__stock svg{width:30px;height:30px;stroke:#626669;stroke-width:1.8;fill:#626669}.vehicle-fixed-buy__stock span{display:flex;flex-direction:column;gap:5px}.vehicle-fixed-buy__stock strong{font-size:16px}.vehicle-fixed-buy__stock small{font-size:13px;color:#6c7073}.vehicle-fixed-buy__actions{display:flex;align-items:center;gap:12px}.vehicle-fixed-buy__actions>strong{font-size:23px;margin-right:14px}.vehicle-fixed-buy__actions form{margin:0}.vehicle-fixed-buy__actions button{height:50px;min-width:172px;border:0;border-radius:26px;font-size:16px;cursor:pointer}.vehicle-fixed-buy__cart{background:#e0ecff;color:var(--blue)}.vehicle-fixed-buy__now{background:var(--blue);color:#fff}.vehicle-fixed-buy__actions button:disabled{opacity:.45}
  @media(max-width:989px){.vehicle-store__product{display:block}.vehicle-gallery{position:relative;height:432px;min-height:0;padding:0 16px 20px;grid-template-rows:minmax(0,1fr) 108px;gap:12px}.vehicle-gallery__hero{padding:28px}.vehicle-buy{padding:34px 24px 64px}.vehicle-buy__inner{width:100%}.vehicle-content{width:calc(100% - 32px)}.vehicle-poster-grid{height:auto;grid-template-columns:1fr 1fr;grid-template-rows:240px 240px 240px}.vehicle-poster--1{grid-column:auto;grid-row:span 2}.vehicle-poster--2,.vehicle-poster--3,.vehicle-poster--4,.vehicle-poster--5,.vehicle-poster--6{grid-column:auto}.vehicle-fixed-buy__inner{width:calc(100% - 24px)}.vehicle-fixed-buy__stock small{display:none}.vehicle-fixed-buy__actions>strong{font-size:18px;margin-right:0}.vehicle-fixed-buy__actions button{min-width:118px;padding:0 16px}.vehicle-option{grid-template-columns:94px 1fr}.vehicle-option__media{width:88px;height:88px}}
  @media(max-width:620px){.vehicle-store{padding-bottom:118px}.vehicle-fixed-buy{height:118px}.vehicle-fixed-buy__inner{align-items:flex-start;padding:12px 0;display:grid;grid-template-columns:1fr auto}.vehicle-fixed-buy__stock{grid-row:1}.vehicle-fixed-buy__stock svg{width:23px;height:23px}.vehicle-fixed-buy__stock strong{font-size:13px}.vehicle-fixed-buy__actions{grid-column:1/3;display:grid;grid-template-columns:1fr 1fr}.vehicle-fixed-buy__actions>strong{position:absolute;right:12px;top:15px}.vehicle-fixed-buy__actions button{width:100%;min-width:0;height:48px}.vehicle-option{grid-template-columns:76px 1fr;min-height:132px;padding:15px}.vehicle-option.is-selected{padding:14px}.vehicle-option__media{width:70px;height:70px}.vehicle-option__copy strong{font-size:15px;line-height:21px}.vehicle-option__copy b{font-size:15px}.vehicle-gallery{height:392px;padding-left:12px;padding-right:12px;grid-template-rows:minmax(0,1fr) 86px}.vehicle-gallery__hero{padding:20px}.vehicle-gallery__stage-arrow{width:40px;height:40px;font-size:29px}.vehicle-gallery__stage-arrow--previous{left:12px}.vehicle-gallery__stage-arrow--next{right:12px}.vehicle-gallery__thumbnail-rail:before,.vehicle-gallery__thumbnail-rail:after{width:46px}.vehicle-gallery__thumbnails{gap:9px;padding-left:46px;padding-right:46px}.vehicle-gallery__thumbnail{flex-basis:112px;height:82px;border-radius:8px}.vehicle-gallery__thumbnail-previous,.vehicle-gallery__thumbnail-next{width:36px;height:44px;font-size:30px}.vehicle-gallery__play{width:32px;height:32px;font-size:12px}.vehicle-info-row{padding-left:18px;padding-right:18px}.vehicle-features-card__heading{padding:16px 18px 10px;font-size:17px}.vehicle-feature{grid-template-columns:26px minmax(0,1fr);gap:12px;padding:11px 18px}.vehicle-feature__icon{width:25px;height:25px}.vehicle-feature p{font-size:13px;line-height:19px}.vehicle-guide{padding-top:56px}.vehicle-guide h2{font-size:27px}.vehicle-video{aspect-ratio:16/10}.vehicle-poster-grid{grid-template-columns:1fr;grid-template-rows:repeat(6,260px)}.vehicle-poster--1{grid-row:auto}}
</style>

<script>
  (() => {
    const root = document.querySelector('[data-vehicle="{{ section.id }}"]');
    if (!root) return;
    const hero = root.querySelector('.vehicle-gallery__hero');
    const galleryEmpty = root.querySelector('[data-gallery-empty]');
    const galleryVideoWrap = root.querySelector('[data-gallery-video]');
    const galleryVideo = root.querySelector('.vehicle-gallery__video');
    const mediaItems = [...root.querySelectorAll('[data-gallery-item]')];
    const mainPrevious = root.querySelector('[data-gallery-main-previous]');
    const mainNext = root.querySelector('[data-gallery-main-next]');
    const thumbnailRail = root.querySelector('.vehicle-gallery__thumbnails');
    const thumbnailPrevious = root.querySelector('[data-gallery-scroll-previous]');
    const thumbnailNext = root.querySelector('[data-gallery-scroll-next]');
    let activeMediaIndex = mediaItems.findIndex((item) => item.classList.contains('is-active'));
    if (activeMediaIndex < 0) activeMediaIndex = 0;
    const showMedia = (item) => {
      activeMediaIndex = mediaItems.indexOf(item);
      const isVideo = item.dataset.mediaType === 'video';
      mediaItems.forEach((mediaItem) => {
        const isActive = mediaItem === item;
        mediaItem.classList.toggle('is-active', isActive);
        mediaItem.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      if (isVideo) {
        hero?.setAttribute('hidden', '');
        galleryEmpty?.setAttribute('hidden', '');
        if (galleryVideoWrap) {
          galleryVideoWrap.removeAttribute('hidden');
          galleryVideo.play().catch(() => {});
        }
        return;
      }
      if (hero && item.dataset.image) {
        hero.style.opacity = '0';
        setTimeout(() => {
          hero.src = item.dataset.image;
          hero.srcset = '';
          hero.removeAttribute('hidden');
          hero.style.opacity = '1';
        }, 130);
      }
      galleryEmpty?.removeAttribute('hidden');
      if (galleryVideoWrap) {
        galleryVideo.pause();
        galleryVideoWrap.setAttribute('hidden', '');
      }
    };
    mediaItems.forEach((item) => item.addEventListener('click', () => showMedia(item)));
    mainPrevious?.addEventListener('click', () => {
      if (mediaItems.length < 2) return;
      showMedia(mediaItems[(activeMediaIndex - 1 + mediaItems.length) % mediaItems.length]);
    });
    mainNext?.addEventListener('click', () => {
      if (mediaItems.length < 2) return;
      showMedia(mediaItems[(activeMediaIndex + 1) % mediaItems.length]);
    });
    if (mainPrevious) mainPrevious.disabled = mediaItems.length < 2;
    if (mainNext) mainNext.disabled = mediaItems.length < 2;
    const updateThumbnailNext = () => {
      if (!thumbnailRail) return;
      if (thumbnailPrevious) thumbnailPrevious.disabled = thumbnailRail.scrollLeft <= 4;
      if (thumbnailNext) thumbnailNext.disabled = thumbnailRail.scrollLeft + thumbnailRail.clientWidth >= thumbnailRail.scrollWidth - 4;
    };
    thumbnailPrevious?.addEventListener('click', () => {
      if (!thumbnailRail) return;
      thumbnailRail.scrollBy({ left: -Math.max(thumbnailRail.clientWidth * .72, 220), behavior: 'smooth' });
    });
    thumbnailNext?.addEventListener('click', () => {
      if (!thumbnailRail) return;
      thumbnailRail.scrollBy({ left: Math.max(thumbnailRail.clientWidth * .72, 220), behavior: 'smooth' });
    });
    thumbnailRail?.addEventListener('scroll', updateThumbnailNext, { passive: true });
    window.addEventListener('resize', updateThumbnailNext);
    requestAnimationFrame(updateThumbnailNext);
    root.querySelector('[data-year]')?.addEventListener('change', (event) => { window.location.href = event.target.value; });
    root.querySelectorAll('[data-option]').forEach((input) => input.addEventListener('change', () => {
      root.querySelectorAll('.vehicle-option').forEach((card) => card.classList.remove('is-selected'));
      input.closest('.vehicle-option').classList.add('is-selected');
      const available = input.dataset.available === 'true';
      root.querySelector('[data-price]').textContent = input.dataset.price;
      root.querySelector('[data-bar-price]').textContent = input.dataset.price;
      root.querySelector('[data-bar-stock]').textContent = available ? 'In Stock' : 'Out of Stock';
      root.querySelector('[data-bar-stock-detail]').textContent = available ? 'Ready to ship' : 'Currently unavailable';
      root.querySelectorAll('[data-variant]').forEach((field) => { field.value = input.value; });
      root.querySelectorAll('.vehicle-fixed-buy__actions button').forEach((button) => { button.disabled = !available; });
    }));
    const guideVideo = root.querySelector('.vehicle-video__element');
    const sound = root.querySelector('[data-sound]');
    if (guideVideo) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) { guideVideo.pause(); return; }
        guideVideo.muted = false;
        guideVideo.play().catch(() => { guideVideo.muted = true; guideVideo.play(); if (sound) sound.hidden = false; });
      }), { threshold: .45 });
      observer.observe(guideVideo);
      sound?.addEventListener('click', () => { guideVideo.muted = false; guideVideo.play(); sound.hidden = true; });
    }
  })();
</script>

