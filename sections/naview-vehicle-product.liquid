{% liquid
  assign vehicle_product = product
  assign standard_variant = vehicle_product.variants[0]
  assign install_variant = vehicle_product.variants[1] | default: standard_variant
  assign standard_price = standard_variant.price | money_with_currency
  assign install_price = install_variant.price | money_with_currency
  assign default_vehicle_image = product.featured_image | default: section.settings.fallback_image
  assign gallery_1 = section.settings.gallery_1 | default: default_vehicle_image
  assign option_1_image = section.settings.option_image_1 | default: gallery_1
  assign option_2_image = section.settings.option_image_2 | default: gallery_1
  assign vehicle_page_url = vehicle_product.url
  assign product_image_alt = vehicle_product.title | append: ' custom-fit digital rear mirror'
  assign feature_image_alt = vehicle_product.title | append: ' product feature'
%}

<section class="vehicle-store" data-vehicle="{{ section.id }}">
  <div class="vehicle-store__product">
    <div class="vehicle-gallery">
      <div class="vehicle-media-window">
        <div class="vehicle-media-panel is-active" data-media-panel="photos">
          <div class="vehicle-gallery__stage">
            {% if gallery_1 != blank %}
              {{ gallery_1 | image_url: width: 1800 | image_tag: class: 'vehicle-gallery__hero', loading: 'eager', widths: '720, 1080, 1440, 1800', sizes: '(min-width: 990px) 58vw, 100vw', alt: product_image_alt }}
            {% else %}
              <div class="vehicle-gallery__empty"><strong>{{ vehicle_product.title | escape }}</strong><span>Upload the primary product image</span></div>
            {% endif %}
            <button class="vehicle-gallery__arrow vehicle-gallery__arrow--prev" type="button" aria-label="Previous photo" data-gallery-prev>‹</button>
            <button class="vehicle-gallery__arrow vehicle-gallery__arrow--next" type="button" aria-label="Next photo" data-gallery-next>›</button>
            <div class="vehicle-gallery__dots" aria-label="Choose product photo">
              {% for i in (1..4) %}
                {% assign key = 'gallery_' | append: i %}
                {% assign gallery_image = section.settings[key] %}
                {% if i == 1 and gallery_image == blank %}{% assign gallery_image = default_vehicle_image %}{% endif %}
                {% if gallery_image != blank %}<button type="button" class="{% if i == 1 %}is-active{% endif %}" data-gallery-dot data-image="{{ gallery_image | image_url: width: 1800 }}" aria-label="Photo {{ i }}"></button>{% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="vehicle-media-panel" data-media-panel="video" hidden>
          {% if section.settings.gallery_video != blank %}
            {{ section.settings.gallery_video | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', class: 'vehicle-gallery__video' }}
          {% else %}
            <div class="vehicle-gallery__video-empty"><span>Product Video</span><small>Upload a product video in the theme editor</small></div>
          {% endif %}
        </div>
      </div>
      <div class="vehicle-media-tabs" role="tablist" aria-label="Product media">
        <button class="is-active" type="button" role="tab" aria-selected="true" data-media-tab="photos"><span class="vehicle-media-tabs__photo">▣</span> Photos</button>
        <button type="button" role="tab" aria-selected="false" data-media-tab="video"><span class="vehicle-media-tabs__play">▶</span> Video</button>
      </div>
    </div>

    <aside class="vehicle-buy">
      <div class="vehicle-buy__inner">
        <h1>{{ vehicle_product.title | escape }}</h1>

        <div class="vehicle-year">
          <label for="vehicle-year-{{ section.id }}">Select Year</label>
          <div class="vehicle-select-wrap">
            <select id="vehicle-year-{{ section.id }}" data-year>
              <option value="{{ vehicle_page_url }}">2022–2024</option>
              <option value="{% if section.settings.year_2019_product != blank %}{{ section.settings.year_2019_product.url }}{% else %}{{ vehicle_page_url }}{% endif %}">2019–2021</option>
              <option value="{% if section.settings.year_2025_product != blank %}{{ section.settings.year_2025_product.url }}{% else %}{{ vehicle_page_url }}{% endif %}">2025+</option>
            </select>
          </div>
        </div>

        <p class="vehicle-price" data-price>{{ standard_price }}</p>

        <div class="vehicle-info-card">
          <div class="vehicle-info-row vehicle-info-row--shipping">
            <div class="vehicle-info-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32"><path d="M3.5 9.5h15v11h-15zM18.5 13h5.5l4.5 5v2.5h-10z" fill="none"/><circle cx="9" cy="23" r="2.5"/><circle cx="23.5" cy="23" r="2.5"/><path d="M5.5 23h1M11.5 23h9.5M26 23h2"/></svg>
            </div>
            <div class="vehicle-info-copy"><p>Free Shipping</p><p>Up to 30-Day Returns</p></div>
            <span class="vehicle-info-arrow" aria-hidden="true">›</span>
          </div>
          <div class="vehicle-info-divider"></div>
          <div class="vehicle-info-row vehicle-info-row--specs">
            <div class="vehicle-info-icon vehicle-info-icon--chip" aria-hidden="true">
              <svg viewBox="0 0 32 32"><rect x="8" y="8" width="16" height="16" rx="1"/><rect x="12" y="12" width="8" height="8" fill="none"/><path d="M11 3v5M16 3v5M21 3v5M11 24v5M16 24v5M21 24v5M3 11h5M3 16h5M3 21h5M24 11h5M24 16h5M24 21h5"/></svg>
            </div>
            <div class="vehicle-info-copy vehicle-info-copy--specs">
              <p>9.66&quot; IPS Touchscreen With 1920 × 480 Resolution and 1,500-Nit Peak Brightness</p>
              <p>Fully Laminated Display With Touchscreen and Physical Button Controls</p>
              <p>Front 2MP Camera With Automotive-Grade MIS2031 Sensor and 140° Ultra-Wide Lens</p>
              <p>Rear 2MP Camera With Automotive-Grade MIS2031 Sensor and 140° Ultra-Wide Lens</p>
              <p>WDR, 1080P Recording at 25fps, and IP68 Waterproof Protection</p>
            </div>
          </div>
        </div>

        <div class="vehicle-options">
          <h2>Select Option</h2>
          <label class="vehicle-option is-selected">
            <input type="radio" name="vehicle-option-{{ section.id }}" value="{{ standard_variant.id }}" data-option data-price="{{ standard_price | escape }}" data-available="{{ standard_variant.available }}" checked>
            <span class="vehicle-option__media">{% if option_1_image != blank %}{{ option_1_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '' }}{% else %}<span>Photo</span>{% endif %}</span>
            <span class="vehicle-option__copy"><strong>{{ standard_variant.title | escape }}</strong><b>{{ standard_price }}</b><small class="vehicle-option__stock">{% if standard_variant.available %}In Stock{% else %}Out of Stock{% endif %}</small></span>
          </label>
          <label class="vehicle-option">
            <input type="radio" name="vehicle-option-{{ section.id }}" value="{{ install_variant.id }}" data-option data-price="{{ install_price | escape }}" data-available="{{ install_variant.available }}">
            <span class="vehicle-option__media">{% if option_2_image != blank %}{{ option_2_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '' }}{% else %}<span>Photo</span>{% endif %}</span>
            <span class="vehicle-option__copy"><strong>{{ install_variant.title | escape }}</strong><b>{{ install_price }}</b><small class="vehicle-option__stock">{% if install_variant.available %}In Stock{% else %}Out of Stock{% endif %}</small></span>
          </label>
        </div>
      </div>
    </aside>
  </div>

  <section class="vehicle-guide">
    <div class="vehicle-content">
      <h2>Installation Guide</h2>
      <div class="vehicle-video">
        {% if section.settings.installation_video != blank %}
          {{ section.settings.installation_video | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', class: 'vehicle-video__element' }}
          <button class="vehicle-video__sound" type="button" hidden data-sound>Turn Sound On</button>
        {% else %}
          <div class="vehicle-video__empty"><span>Installation Guide</span><p>Upload your Shopify-hosted installation video in the theme editor.</p></div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="vehicle-posters">
    <div class="vehicle-content vehicle-poster-grid">
      {% for i in (1..6) %}
        {% assign key = 'poster_' | append: i %}
        {% assign poster = section.settings[key] %}
        <div class="vehicle-poster vehicle-poster--{{ i }}">
          {% if poster != blank %}{{ poster | image_url: width: 1600 | image_tag: loading: 'lazy', alt: feature_image_alt }}{% else %}<span>Poster {{ i }}</span>{% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
  <div class="vehicle-fixed-buy" data-fixed-buy>
    <div class="vehicle-fixed-buy__inner">
      <div class="vehicle-fixed-buy__stock">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3.5 9.5h15v11h-15zM18.5 13h5.5l4.5 5v2.5h-10z" fill="none"/><circle cx="9" cy="23" r="2.5"/><circle cx="23.5" cy="23" r="2.5"/><path d="M5.5 23h1M11.5 23h9.5M26 23h2"/></svg>
        <span><strong data-bar-stock>{% if standard_variant.available %}In Stock{% else %}Out of Stock{% endif %}</strong><small data-bar-stock-detail>{% if standard_variant.available %}Ready to ship{% else %}Currently unavailable{% endif %}</small></span>
      </div>
      <div class="vehicle-fixed-buy__actions">
        <strong data-bar-price>{{ standard_price }}</strong>
        <form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ standard_variant.id }}" data-variant><button class="vehicle-fixed-buy__cart" type="submit" {% unless standard_variant.available %}disabled{% endunless %}>Add to Cart</button></form>
        <form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ standard_variant.id }}" data-variant><input type="hidden" name="return_to" value="/checkout"><button class="vehicle-fixed-buy__now" type="submit" {% unless standard_variant.available %}disabled{% endunless %}>Buy Now</button></form>
      </div>
    </div>
  </div>
</section>

<style>
  .vehicle-store{--blue:#0060ef;--ink:#303233;--muted:#6b6f72;--line:#dfe2e4;--soft:#f4f6f7;background:#fff;color:var(--ink);font-family:Arial,"Helvetica Neue",sans-serif;padding-bottom:104px}
  .vehicle-store *{box-sizing:border-box}
  .vehicle-store__product{width:min(1348px,100%);margin:0 auto;display:grid;grid-template-columns:minmax(0,700px) minmax(500px,648px);align-items:start}
  .vehicle-gallery{position:sticky;top:0;height:calc(100vh - 2px);min-height:720px;padding:0 28px 20px;background:#fff;display:flex;flex-direction:column}
  .vehicle-media-window{flex:1;min-height:0;background:#f4f5f6;display:grid}
  .vehicle-media-panel{height:100%;min-height:0}.vehicle-media-panel[hidden]{display:none}.vehicle-media-panel.is-active{display:block}
  .vehicle-gallery__stage{position:relative;height:100%;min-height:620px;display:grid;place-items:center;overflow:hidden;background:#f4f5f6}
  .vehicle-gallery__hero{width:100%;height:100%;padding:48px;object-fit:contain;transition:opacity .2s ease}
  .vehicle-gallery__empty{display:flex;flex-direction:column;gap:8px;text-align:center;color:#777}.vehicle-gallery__empty strong{font-size:28px;color:#333}
  .vehicle-gallery__arrow{position:absolute;top:50%;transform:translateY(-50%);width:54px;height:54px;border:0;border-radius:50%;background:rgba(67,71,82,.48);color:#fff;font-size:38px;line-height:48px;cursor:pointer;z-index:2}.vehicle-gallery__arrow--prev{left:24px}.vehicle-gallery__arrow--next{right:24px}
  .vehicle-gallery__dots{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);display:flex;gap:10px}.vehicle-gallery__dots button{width:10px;height:10px;border:0;border-radius:50%;padding:0;background:#c9ccd0;cursor:pointer}.vehicle-gallery__dots button.is-active{background:#25272a}
  .vehicle-gallery__video,.vehicle-gallery__video-empty{width:100%;height:100%;min-height:620px;object-fit:contain;background:#0b0c0d}.vehicle-gallery__video-empty{display:grid;place-content:center;text-align:center;color:#fff;gap:9px}.vehicle-gallery__video-empty span{font-size:24px}.vehicle-gallery__video-empty small{color:#a9adb0}
  .vehicle-media-tabs{height:74px;display:flex;align-items:center;justify-content:center;gap:18px;background:#fff}.vehicle-media-tabs button{height:46px;border:0;border-radius:25px;background:transparent;color:#3a3d40;padding:0 22px;font-size:17px;display:flex;align-items:center;gap:9px;cursor:pointer}.vehicle-media-tabs button.is-active{background:#242628;color:#fff}.vehicle-media-tabs__play{font-size:14px}
  .vehicle-buy{min-width:0;padding:54px 74px 80px}.vehicle-buy__inner{width:500px;max-width:100%}.vehicle-buy h1{font-size:32px;font-weight:600;line-height:36px;letter-spacing:-.5px;margin:0 0 28px;color:#333}
  .vehicle-year label{display:block;margin:0 0 9px;font-size:14px;font-weight:600}.vehicle-select-wrap{position:relative}.vehicle-select-wrap:after{content:"⌄";position:absolute;right:16px;top:50%;transform:translateY(-57%);pointer-events:none}.vehicle-year select{appearance:none;width:100%;height:50px;border:1px solid #cfd3d5;border-radius:2px;background:#fff;padding:0 44px 0 16px;color:#333;font-size:15px}
  .vehicle-price{font-size:26px;line-height:32px;font-weight:600;margin:26px 0 20px}
  .vehicle-info-card{background:var(--soft);border-radius:12px;overflow:hidden;margin-top:8px}.vehicle-info-row{display:grid;grid-template-columns:34px 1fr 18px;gap:12px;padding:20px 26px}.vehicle-info-row--specs{grid-template-columns:34px 1fr;padding-top:22px;padding-bottom:24px}.vehicle-info-icon{width:28px;height:28px;color:#626669}.vehicle-info-icon svg{width:100%;height:100%;stroke:currentColor;stroke-width:1.9;fill:currentColor;stroke-linecap:round;stroke-linejoin:round}.vehicle-info-icon--chip svg{stroke-width:1.7}.vehicle-info-copy p{font-size:15px;line-height:22px;margin:0 0 6px}.vehicle-info-copy p:last-child{margin-bottom:0}.vehicle-info-copy--specs p{margin-bottom:9px}.vehicle-info-arrow{font-size:30px;color:#555;align-self:center}.vehicle-info-divider{height:1px;background:var(--line)}
  .vehicle-options{margin-top:34px}.vehicle-options h2{font-size:24px;line-height:30px;font-weight:600;margin:0 0 22px}.vehicle-option{position:relative;min-height:158px;border:1px solid #d4d7d9;border-radius:10px;padding:20px 22px;display:grid;grid-template-columns:120px 1fr;gap:20px;align-items:center;margin:0 0 12px;background:#fff;cursor:pointer}.vehicle-option.is-selected{border:2px solid var(--blue);padding:19px 21px}.vehicle-option input{position:absolute;opacity:0;pointer-events:none}.vehicle-option__media{width:112px;height:112px;display:grid;place-items:center;background:#f7f8f9;overflow:hidden;color:#999;font-size:12px}.vehicle-option__media img{width:100%;height:100%;object-fit:contain}.vehicle-option__copy{align-self:stretch;display:flex;flex-direction:column;justify-content:center}.vehicle-option__copy strong{display:block;font-size:18px;line-height:25px}.vehicle-option__copy b{display:block;font-size:17px;line-height:23px;margin-top:8px;font-weight:500}.vehicle-option__copy small.vehicle-option__stock{display:block;margin-top:auto;padding-top:10px;font-size:14px;line-height:18px;color:#167b42;font-weight:600}
  .vehicle-content{width:min(1348px,calc(100% - 48px));margin:0 auto}.vehicle-guide{padding:86px 0 28px;background:#fff}.vehicle-guide h2{font-size:32px;line-height:40px;text-align:center;margin:0 0 32px;font-weight:600}.vehicle-video{position:relative;aspect-ratio:16/7;background:#0a0a0a;overflow:hidden}.vehicle-video__element{width:100%;height:100%;object-fit:cover}.vehicle-video__empty{height:100%;display:grid;place-content:center;text-align:center;color:#fff}.vehicle-video__empty span{font-size:28px;font-weight:600}.vehicle-video__empty p{color:#aaa;margin:12px 0 0}.vehicle-video__sound{position:absolute;right:20px;bottom:20px;border:0;background:#fff;color:#111;padding:11px 16px;font-weight:600}
  .vehicle-posters{padding:0 0 90px;background:#fff}.vehicle-poster-grid{height:720px;display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:1fr 1fr;gap:12px}.vehicle-poster{background:#f2f4f5;overflow:hidden;display:grid;place-items:center;color:#9a9da0;font-size:14px}.vehicle-poster img{width:100%;height:100%;object-fit:cover}.vehicle-poster--1{grid-column:span 5;grid-row:span 2}.vehicle-poster--2{grid-column:span 4}.vehicle-poster--3{grid-column:span 3}.vehicle-poster--4{grid-column:span 3}.vehicle-poster--5{grid-column:span 2}.vehicle-poster--6{grid-column:span 2}
  .vehicle-fixed-buy{position:fixed;left:0;right:0;bottom:0;height:104px;background:#fff;border-top:1px solid #e3e5e7;box-shadow:0 -6px 22px rgba(0,0,0,.07);z-index:1000}.vehicle-fixed-buy__inner{width:min(1348px,calc(100% - 48px));height:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between}.vehicle-fixed-buy__stock{display:flex;align-items:center;gap:14px}.vehicle-fixed-buy__stock svg{width:30px;height:30px;stroke:#626669;stroke-width:1.8;fill:#626669}.vehicle-fixed-buy__stock span{display:flex;flex-direction:column;gap:5px}.vehicle-fixed-buy__stock strong{font-size:16px}.vehicle-fixed-buy__stock small{font-size:13px;color:#6c7073}.vehicle-fixed-buy__actions{display:flex;align-items:center;gap:12px}.vehicle-fixed-buy__actions>strong{font-size:23px;margin-right:14px}.vehicle-fixed-buy__actions form{margin:0}.vehicle-fixed-buy__actions button{height:50px;min-width:172px;border:0;border-radius:26px;font-size:16px;cursor:pointer}.vehicle-fixed-buy__cart{background:#e0ecff;color:var(--blue)}.vehicle-fixed-buy__now{background:var(--blue);color:#fff}.vehicle-fixed-buy__actions button:disabled{opacity:.45}
  @media(max-width:989px){.vehicle-store__product{display:block}.vehicle-gallery{position:relative;height:auto;min-height:534px;padding:0 16px}.vehicle-media-window{min-height:460px}.vehicle-gallery__stage,.vehicle-gallery__video,.vehicle-gallery__video-empty{min-height:460px}.vehicle-gallery__hero{padding:28px}.vehicle-buy{padding:34px 24px 64px}.vehicle-buy__inner{width:100%}.vehicle-content{width:calc(100% - 32px)}.vehicle-poster-grid{height:auto;grid-template-columns:1fr 1fr;grid-template-rows:240px 240px 240px}.vehicle-poster--1{grid-column:auto;grid-row:span 2}.vehicle-poster--2,.vehicle-poster--3,.vehicle-poster--4,.vehicle-poster--5,.vehicle-poster--6{grid-column:auto}.vehicle-fixed-buy__inner{width:calc(100% - 24px)}.vehicle-fixed-buy__stock small{display:none}.vehicle-fixed-buy__actions>strong{font-size:18px;margin-right:0}.vehicle-fixed-buy__actions button{min-width:118px;padding:0 16px}.vehicle-option{grid-template-columns:94px 1fr}.vehicle-option__media{width:88px;height:88px}}
  @media(max-width:620px){.vehicle-store{padding-bottom:118px}.vehicle-fixed-buy{height:118px}.vehicle-fixed-buy__inner{align-items:flex-start;padding:12px 0;display:grid;grid-template-columns:1fr auto}.vehicle-fixed-buy__stock{grid-row:1}.vehicle-fixed-buy__stock svg{width:23px;height:23px}.vehicle-fixed-buy__stock strong{font-size:13px}.vehicle-fixed-buy__actions{grid-column:1/3;display:grid;grid-template-columns:1fr 1fr}.vehicle-fixed-buy__actions>strong{position:absolute;right:12px;top:15px}.vehicle-fixed-buy__actions button{width:100%;min-width:0;height:48px}.vehicle-option{grid-template-columns:76px 1fr;min-height:132px;padding:15px}.vehicle-option.is-selected{padding:14px}.vehicle-option__media{width:70px;height:70px}.vehicle-option__copy strong{font-size:15px;line-height:21px}.vehicle-option__copy b{font-size:15px}.vehicle-gallery__arrow{width:44px;height:44px;font-size:30px}.vehicle-info-row{padding-left:18px;padding-right:18px}.vehicle-guide{padding-top:56px}.vehicle-guide h2{font-size:27px}.vehicle-video{aspect-ratio:16/10}.vehicle-poster-grid{grid-template-columns:1fr;grid-template-rows:repeat(6,260px)}.vehicle-poster--1{grid-row:auto}}
</style>

<script>
  (() => {
    const root = document.querySelector('[data-vehicle="{{ section.id }}"]');
    if (!root) return;
    const hero = root.querySelector('.vehicle-gallery__hero');
    const dots = [...root.querySelectorAll('[data-gallery-dot]')];
    let photoIndex = 0;
    const showPhoto = (index) => {
      if (!dots.length || !hero) return;
      photoIndex = (index + dots.length) % dots.length;
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === photoIndex));
      hero.style.opacity = '0';
      setTimeout(() => { hero.src = dots[photoIndex].dataset.image; hero.srcset = ''; hero.style.opacity = '1'; }, 130);
    };
    dots.forEach((dot, i) => dot.addEventListener('click', () => showPhoto(i)));
    root.querySelector('[data-gallery-prev]')?.addEventListener('click', () => showPhoto(photoIndex - 1));
    root.querySelector('[data-gallery-next]')?.addEventListener('click', () => showPhoto(photoIndex + 1));
    root.querySelectorAll('[data-media-tab]').forEach((tab) => tab.addEventListener('click', () => {
      const mode = tab.dataset.mediaTab;
      root.querySelectorAll('[data-media-tab]').forEach((item) => { item.classList.toggle('is-active', item === tab); item.setAttribute('aria-selected', item === tab ? 'true' : 'false'); });
      root.querySelectorAll('[data-media-panel]').forEach((panel) => { const active = panel.dataset.mediaPanel === mode; panel.hidden = !active; panel.classList.toggle('is-active', active); });
      const galleryVideo = root.querySelector('.vehicle-gallery__video');
      if (galleryVideo) { if (mode === 'video') galleryVideo.play().catch(() => {}); else galleryVideo.pause(); }
    }));
    root.querySelector('[data-year]')?.addEventListener('change', (event) => { window.location.href = event.target.value; });
    root.querySelectorAll('[data-option]').forEach((input) => input.addEventListener('change', () => {
      root.querySelectorAll('.vehicle-option').forEach((card) => card.classList.remove('is-selected'));
      input.closest('.vehicle-option').classList.add('is-selected');
      const available = input.dataset.available === 'true';
      root.querySelector('[data-price]').textContent = input.dataset.price;
      root.querySelector('[data-bar-price]').textContent = input.dataset.price;
      root.querySelector('[data-bar-stock]').textContent = available ? 'In Stock' : 'Out of Stock';
      root.querySelector('[data-bar-stock-detail]').textContent = available ? 'Ready to ship' : 'Currently unavailable';
      root.querySelectorAll('[data-variant]').forEach((field) => { field.value = input.value; });
      root.querySelectorAll('.vehicle-fixed-buy__actions button').forEach((button) => { button.disabled = !available; });
    }));
    const guideVideo = root.querySelector('.vehicle-video__element');
    const sound = root.querySelector('[data-sound]');
    if (guideVideo) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) { guideVideo.pause(); return; }
        guideVideo.muted = false;
        guideVideo.play().catch(() => { guideVideo.muted = true; guideVideo.play(); if (sound) sound.hidden = false; });
      }), { threshold: .45 });
      observer.observe(guideVideo);
      sound?.addEventListener('click', () => { guideVideo.muted = false; guideVideo.play(); sound.hidden = true; });
    }
  })();
</script>

{% schema %}
{
  "name": "Vehicle Store Product",
  "settings": [
    {"type":"image_picker","id":"fallback_image","label":"Fallback product image"},
    {"type":"product","id":"year_2019_product","label":"2019–2021 product"},
    {"type":"product","id":"year_2025_product","label":"2025+ product"},
    {"type":"image_picker","id":"gallery_1","label":"Product image 1"},
    {"type":"image_picker","id":"gallery_2","label":"Product image 2"},
    {"type":"image_picker","id":"gallery_3","label":"Product image 3"},
    {"type":"image_picker","id":"gallery_4","label":"Product image 4"},
    {"type":"video","id":"gallery_video","label":"Product gallery video"},
    {"type":"image_picker","id":"option_image_1","label":"Standard option image"},
    {"type":"image_picker","id":"option_image_2","label":"Installation option image"},
    {"type":"video","id":"installation_video","label":"Installation video"},
    {"type":"image_picker","id":"poster_1","label":"Poster 1"},
