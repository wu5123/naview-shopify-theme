{% liquid
  assign vehicle_product = product
  assign core_variant = vehicle_product.variants[0]
  assign pro_variant = vehicle_product.variants[1]
  assign max_variant = vehicle_product.variants[2]
  assign ultra_variant = vehicle_product.variants[3]
  assign installation_variant = vehicle_product.variants[4]
  assign standard_variant = core_variant
  assign standard_price = core_variant.price | money_with_currency
  assign pro_price = pro_variant.price | money_with_currency
  assign max_price = max_variant.price | money_with_currency
  assign ultra_price = ultra_variant.price | money_with_currency
  assign installation_price = installation_variant.price | money_with_currency
  assign installation_compare_price = installation_variant.compare_at_price | money_with_currency
  assign default_vehicle_image = product.featured_image | default: section.settings.fallback_image
  assign option_1_image = section.settings.option_image_1
  assign option_2_image = section.settings.option_image_2
  assign option_3_image = section.settings.option_image_3
  assign option_4_image = section.settings.option_image_4
  assign vehicle_page_url = vehicle_product.url
  assign product_image_alt = vehicle_product.title | append: ' custom-fit digital rear mirror'
  assign feature_image_alt = vehicle_product.title | append: ' product feature'
%}

<section class="vehicle-store" data-vehicle="{{ section.id }}" data-currency-code="{{ cart.currency.iso_code | default: shop.currency }}">
  <div class="vehicle-store__product">
    <div class="vehicle-gallery">
      <div class="vehicle-media-window">
        <div class="vehicle-gallery__stage">
          {% assign initial_gallery_image = section.settings.gallery_1 | default: section.settings.option_main_image_1 | default: default_vehicle_image %}
          {% if initial_gallery_image != blank %}
            {{ initial_gallery_image | image_url: width: 1800 | image_tag: class: 'vehicle-gallery__hero', loading: 'eager', widths: '720, 1080, 1440, 1800', sizes: '(min-width: 990px) 50vw, 100vw', alt: product_image_alt }}
          {% else %}
            <img class="vehicle-gallery__hero" src="{{ 'cleardrive-option-17-pro-e-main.png' | asset_url }}" width="1254" height="1254" loading="eager" alt="{{ product_image_alt | escape }}">
          {% endif %}
          {% if section.settings.gallery_video != blank %}
            <div class="vehicle-gallery__video-wrap" data-gallery-video hidden>
              {{ section.settings.gallery_video | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', class: 'vehicle-gallery__video' }}
            </div>
          {% endif %}
          <button class="vehicle-gallery__stage-arrow vehicle-gallery__stage-arrow--previous" type="button" aria-label="Previous product media" data-gallery-main-previous>‹</button>
          <button class="vehicle-gallery__stage-arrow vehicle-gallery__stage-arrow--next" type="button" aria-label="Next product media" data-gallery-main-next>›</button>
        </div>
      </div>
      <div class="vehicle-gallery__thumbnail-rail">
        <button class="vehicle-gallery__thumbnail-previous" type="button" aria-label="Show previous product media" data-gallery-scroll-previous>‹</button>
        <div class="vehicle-gallery__thumbnails" role="tablist" aria-label="Choose product media">
          {% for option_index in (1..4) %}
            {% liquid
              case option_index
                when 1
                  assign gallery_group = 'core'
                  assign gallery_group_label = 'Core'
                  assign gallery_main_image = section.settings.gallery_1 | default: section.settings.option_main_image_1 | default: default_vehicle_image
                  assign gallery_main_asset = 'cleardrive-option-17-pro-e-main.png'
                when 2
                  assign gallery_group = 'pro'
                  assign gallery_group_label = 'Pro'
                  assign gallery_main_image = section.settings.option_main_image_2
                  assign gallery_main_asset = 'cleardrive-option-18-pro-main.png'
                when 3
                  assign gallery_group = 'max'
                  assign gallery_group_label = 'Max'
                  assign gallery_main_image = section.settings.option_main_image_3
                  assign gallery_main_asset = 'cleardrive-option-19-ultra-max-main.png'
                when 4
                  assign gallery_group = 'ultra'
                  assign gallery_group_label = 'Ultra'
                  assign gallery_main_image = section.settings.option_main_image_4
                  assign gallery_main_asset = 'cleardrive-option-19-ultra-max-main.png'
              endcase
            %}
            <button type="button" class="vehicle-gallery__thumbnail{% if option_index == 1 %} is-active{% endif %}" role="tab" aria-selected="{% if option_index == 1 %}true{% else %}false{% endif %}" data-gallery-item data-gallery-group="{{ gallery_group }}" data-media-type="image" data-option-main="true" data-image="{% if gallery_main_image != blank %}{{ gallery_main_image | image_url: width: 1800 }}{% else %}{{ gallery_main_asset | asset_url }}{% endif %}" aria-label="View {{ gallery_group_label }} main image"{% unless option_index == 1 %} hidden{% endunless %}>
              {% if gallery_main_image != blank %}
                {{ gallery_main_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '140px', alt: product_image_alt }}
              {% else %}
                <img src="{{ gallery_main_asset | asset_url }}" width="1254" height="1254" loading="lazy" alt="{{ gallery_group_label }} {{ product_image_alt | escape }}">
              {% endif %}
            </button>
            {% for image_index in (2..4) %}
              {% if option_index == 1 %}
                {% assign image_key = 'gallery_' | append: image_index %}
              {% else %}
                {% assign image_key = gallery_group | append: '_gallery_' | append: image_index %}
              {% endif %}
              {% assign gallery_image = section.settings[image_key] %}
              {% if gallery_image != blank %}
                <button type="button" class="vehicle-gallery__thumbnail" role="tab" aria-selected="false" data-gallery-item data-gallery-group="{{ gallery_group }}" data-media-type="image" data-image="{{ gallery_image | image_url: width: 1800 }}" aria-label="View {{ gallery_group_label }} photo {{ image_index }}"{% unless option_index == 1 %} hidden{% endunless %}>
                  {{ gallery_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '140px', alt: product_image_alt }}
                </button>
              {% endif %}
            {% endfor %}
          {% endfor %}
          {% if section.settings.gallery_video != blank %}
            <button type="button" class="vehicle-gallery__thumbnail vehicle-gallery__thumbnail--video" role="tab" aria-selected="false" data-gallery-item data-gallery-group="shared" data-media-type="video" aria-label="Play product video">
              {% if section.settings.gallery_video.preview_image != blank %}
                {{ section.settings.gallery_video.preview_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '140px', alt: product_image_alt }}
              {% else %}
                <span>Product video</span>
              {% endif %}
              <span class="vehicle-gallery__play" aria-hidden="true">▶</span>
            </button>
          {% endif %}
        </div>
        <button class="vehicle-gallery__thumbnail-next" type="button" aria-label="Show more product media" data-gallery-scroll-next>›</button>
      </div>
    </div>

    <aside class="vehicle-buy">
      <div class="vehicle-buy__inner">
        <h1>
          {% if section.settings.brand_logo != blank %}
            {{
              section.settings.brand_logo
              | image_url: width: 240
              | image_tag:
                widths: '80, 120, 160, 240',
                sizes: '44px',
                loading: 'eager',
                class: 'vehicle-buy__brand-logo',
                alt: ''
            }}
          {% endif %}
          <span>{{ vehicle_product.title | escape }}</span>
        </h1>

        <div class="vehicle-year">
          <label for="vehicle-year-{{ section.id }}">Select Year</label>
          <div class="vehicle-select-wrap">
            <select id="vehicle-year-{{ section.id }}" data-year>
              <option value="{{ vehicle_page_url }}">2022–2024</option>
              <option value="{% if section.settings.year_2019_product != blank %}{{ section.settings.year_2019_product.url }}{% else %}{{ vehicle_page_url }}{% endif %}">2019–2021</option>
              <option value="{% if section.settings.year_2025_product != blank %}{{ section.settings.year_2025_product.url }}{% else %}{{ vehicle_page_url }}{% endif %}">2025+</option>
            </select>
          </div>
        </div>

        <p class="vehicle-price" data-price>{{ standard_price }}</p>

        <div class="vehicle-info-card">
          <div class="vehicle-info-row vehicle-info-row--shipping">
            <div class="vehicle-info-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32"><path d="M3.5 9.5h15v11h-15zM18.5 13h5.5l4.5 5v2.5h-10z" fill="none"/><circle cx="9" cy="23" r="2.5"/><circle cx="23.5" cy="23" r="2.5"/><path d="M5.5 23h1M11.5 23h9.5M26 23h2"/></svg>
            </div>
            <div class="vehicle-info-copy"><p>Free Shipping</p><p>Up to 30-Day Returns</p></div>
            <span class="vehicle-info-arrow" aria-hidden="true">›</span>
          </div>
        </div>

        {% if section.blocks.size > 0 %}
          <section class="vehicle-features-card" aria-label="Product features">
            <div class="vehicle-features-card__list">
              {% for block in section.blocks %}
                <div class="vehicle-feature" {{ block.shopify_attributes }}>
                  <div class="vehicle-feature__icon" aria-hidden="true">
                    {% case block.settings.icon %}
                      {% when 'display' %}
                        <svg viewBox="0 0 32 32"><rect x="5" y="6" width="22" height="16" rx="1"/><path d="M16 22v4M10 27h12"/></svg>
                      {% when 'touch' %}
                        <svg viewBox="0 0 32 32"><path d="M14 28V15.5a2 2 0 0 1 4 0v5.2l1.1-1.1a2 2 0 0 1 2.8 0l.4.4.7-.7a2 2 0 0 1 2.8 0l.8.8.4-.4a2 2 0 0 1 2.8 0l.2.2c.8.8 1.2 1.9 1.1 3L29.7 28"/><path d="M14 18.5l-2.2-2.2a2 2 0 0 0-2.8 0l-.2.2a2 2 0 0 0 0 2.8l5.2 5.2"/><path d="M7 6h8M7 10h5"/></svg>
                      {% when 'shield' %}
                        <svg viewBox="0 0 32 32"><path d="M16 3.8 26 7.6v7.2c0 6.1-4.2 10.9-10 13.4-5.8-2.5-10-7.3-10-13.4V7.6L16 3.8Z"/><path d="m11.5 15.8 3 3 6-6"/></svg>
                      {% else %}
                        <svg viewBox="0 0 32 32"><path d="M5 10h6l1.6-2.5h6.8L21 10h6v16H5Z"/><circle cx="16" cy="18" r="4.2"/></svg>
                    {% endcase %}
                  </div>
                  <p>{{ block.settings.text | escape | newline_to_br }}</p>
                </div>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <div class="vehicle-options">
          <h2>Select Option</h2>
          <label class="vehicle-option is-selected">
            <input type="radio" name="vehicle-option-{{ section.id }}" value="{{ core_variant.id }}" data-option data-price="{{ standard_price | escape }}" data-price-cents="{{ core_variant.price }}" data-available="{{ core_variant.available }}" data-gallery-group="core" checked>
            <span class="vehicle-option__media">{% if option_1_image != blank %}{{ option_1_image | image_url: width: 480 | image_tag: loading: 'lazy', alt: '' }}{% else %}<img src="{{ 'cleardrive-option-17-pro-e-preview.png' | asset_url }}" width="2048" height="768" loading="lazy" alt="17 Pro E display preview">{% endif %}</span>
            <span class="vehicle-option__copy"><strong>Core for {{ vehicle_product.title | escape }}</strong><b>{{ standard_price }}</b></span>
            <small class="vehicle-option__stock">{% if core_variant.available %}In Stock{% else %}Out of Stock{% endif %}</small>
          </label>
          <label class="vehicle-option{% if pro_variant == blank %} is-unavailable{% endif %}">
            {% if pro_variant != blank %}<input type="radio" name="vehicle-option-{{ section.id }}" value="{{ pro_variant.id }}" data-option data-price="{{ pro_price | escape }}" data-price-cents="{{ pro_variant.price }}" data-available="{{ pro_variant.available }}" data-gallery-group="pro">{% endif %}
            <span class="vehicle-option__media">{% if option_2_image != blank %}{{ option_2_image | image_url: width: 480 | image_tag: loading: 'lazy', alt: '' }}{% else %}<img src="{{ 'cleardrive-option-18-pro-preview.png' | asset_url }}" width="2149" height="732" loading="lazy" alt="18 Pro display preview">{% endif %}</span>
            <span class="vehicle-option__copy"><strong>Pro for {{ vehicle_product.title | escape }}</strong>{% if pro_variant != blank %}<b>{{ pro_price }}</b>{% else %}<b>—</b>{% endif %}</span>
            <small class="vehicle-option__stock">{% if pro_variant != blank and pro_variant.available %}In Stock{% else %}Out of Stock{% endif %}</small>
          </label>
          <label class="vehicle-option{% if max_variant == blank %} is-unavailable{% endif %}">
            {% if max_variant != blank %}<input type="radio" name="vehicle-option-{{ section.id }}" value="{{ max_variant.id }}" data-option data-price="{{ max_price | escape }}" data-price-cents="{{ max_variant.price }}" data-available="{{ max_variant.available }}" data-gallery-group="max">{% endif %}
            <span class="vehicle-option__media">{% if option_3_image != blank %}{{ option_3_image | image_url: width: 480 | image_tag: loading: 'lazy', alt: '' }}{% else %}<img src="{{ 'cleardrive-option-19-ultra-max-preview.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="19 Ultra and Max display preview">{% endif %}</span>
            <span class="vehicle-option__copy"><strong>Max for {{ vehicle_product.title | escape }}</strong>{% if max_variant != blank %}<b>{{ max_price }}</b>{% else %}<b>—</b>{% endif %}</span>
            <small class="vehicle-option__stock">{% if max_variant != blank and max_variant.available %}In Stock{% else %}Out of Stock{% endif %}</small>
          </label>
          <label class="vehicle-option{% if ultra_variant == blank %} is-unavailable{% endif %}">
            {% if ultra_variant != blank %}<input type="radio" name="vehicle-option-{{ section.id }}" value="{{ ultra_variant.id }}" data-option data-price="{{ ultra_price | escape }}" data-price-cents="{{ ultra_variant.price }}" data-available="{{ ultra_variant.available }}" data-gallery-group="ultra">{% endif %}
            <span class="vehicle-option__media">{% if option_4_image != blank %}{{ option_4_image | image_url: width: 480 | image_tag: loading: 'lazy', alt: '' }}{% else %}<img src="{{ 'cleardrive-option-19-ultra-max-preview.png' | asset_url }}" width="2172" height="724" loading="lazy" alt="19 Ultra and Max display preview">{% endif %}</span>
            <span class="vehicle-option__copy"><strong>Ultra for {{ vehicle_product.title | escape }}</strong>{% if ultra_variant != blank %}<b>{{ ultra_price }}</b>{% else %}<b>—</b>{% endif %}</span>
            <small class="vehicle-option__stock">{% if ultra_variant != blank and ultra_variant.available %}In Stock{% else %}Out of Stock{% endif %}</small>
          </label>
          <label class="vehicle-installation-option{% if installation_variant == blank or installation_variant.available == false %} is-unavailable{% endif %}">
            {% if installation_variant != blank %}<input type="checkbox" data-installation-service data-variant-id="{{ installation_variant.id }}" data-price-cents="{{ installation_variant.price }}" data-available="{{ installation_variant.available }}"{% unless installation_variant.available %} disabled{% endunless %}>{% endif %}
            <span class="vehicle-installation-option__check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12.5 9.5 18 20 6.5"/></svg></span>
            <span class="vehicle-installation-option__text">Installation Service <small>(Toronto Only)</small></span>
            <span class="vehicle-installation-option__price">
              {% if installation_variant != blank %}
                <span class="vehicle-installation-option__price-line">{% if installation_variant.compare_at_price > installation_variant.price %}<s>{{ installation_compare_price }}</s>{% endif %}<strong>{{ installation_price }}</strong></span>
                {% if installation_variant.compare_at_price > installation_variant.price %}<small><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h7l7 7-6 6-8-8V4Z"/><circle cx="7" cy="8" r="1.2"/></svg>Promotion</small>{% endif %}
              {% else %}
                —
              {% endif %}
            </span>
          </label>
        </div>
      </div>
    </aside>
  </div>

  <section class="vehicle-feature-poster" aria-label="Featured poster">
    <div class="vehicle-content">
      <div class="vehicle-feature-poster__frame">
        {% if section.settings.guide_poster != blank %}
          {{ section.settings.guide_poster | image_url: width: 2000 | image_tag: loading: 'lazy', alt: '', class: 'vehicle-feature-poster__image' }}
        {% endif %}
        <a class="vehicle-feature-poster__contact" href="https://wa.me/16137969403" target="_blank" rel="noopener noreferrer" aria-label="Contact us on WhatsApp">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="vehicle-guide">
    <div class="vehicle-content">
      <h2>Installation Guide</h2>
      <div class="vehicle-video">
        {% if section.settings.installation_video != blank %}
          {{ section.settings.installation_video | video_tag: controls: true, loop: true, playsinline: true, preload: 'metadata', class: 'vehicle-video__element' }}
          <button class="vehicle-video__sound" type="button" hidden data-sound>Turn Sound On</button>
        {% else %}
          <div class="vehicle-video__empty"><span>Installation Guide</span><p>Upload your Shopify-hosted installation video in the theme editor.</p></div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="vehicle-posters">
    <div class="vehicle-content vehicle-poster-grid">
      {% for i in (1..6) %}
        {% assign key = 'poster_' | append: i %}
        {% assign poster = section.settings[key] %}
        <div class="vehicle-poster vehicle-poster--{{ i }}">
          {% if poster != blank %}{{ poster | image_url: width: 1600 | image_tag: loading: 'lazy', alt: feature_image_alt }}{% else %}<span>Poster {{ i }}</span>{% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
  <div class="vehicle-fixed-buy" data-fixed-buy>
    <div class="vehicle-fixed-buy__inner">
      <div class="vehicle-fixed-buy__stock">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3.5 9.5h15v11h-15zM18.5 13h5.5l4.5 5v2.5h-10z" fill="none"/><circle cx="9" cy="23" r="2.5"/><circle cx="23.5" cy="23" r="2.5"/><path d="M5.5 23h1M11.5 23h9.5M26 23h2"/></svg>
        <span><strong data-bar-stock>{% if standard_variant.available %}In Stock{% else %}Out of Stock{% endif %}</strong><small data-bar-stock-detail>{% if standard_variant.available %}Ready to ship{% else %}Currently unavailable{% endif %}</small></span>
      </div>
      <div class="vehicle-fixed-buy__actions">
        <strong data-bar-price>{{ standard_price }}</strong>
        <button class="vehicle-fixed-buy__cart" type="button" value="{{ core_variant.id }}" data-variant data-purchase-action="cart" data-quantity="1" {% unless standard_variant.available %}disabled{% endunless %}>Add to Cart</button>
        <a class="vehicle-fixed-buy__now" href="{{ routes.root_url }}cart/{{ core_variant.id }}:1" data-purchase-action="checkout" data-quantity="1"{% unless standard_variant.available %} aria-disabled="true"{% endunless %}>Buy Now</a>
      </div>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap');
  .vehicle-store{--blue:#0060ef;--ink:#303233;--muted:#6b6f72;--line:#dfe2e4;--soft:#f4f6f7;background:#fff;color:var(--ink);font-family:"Open Sans",BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Helvetica,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",SimSun,sans-serif;font-size:14px;line-height:20px;letter-spacing:-.02em;padding-bottom:68px}
  .vehicle-store *{box-sizing:border-box}
  .vehicle-store :is(h1,h2,h3,h4,h5,h6){font-family:inherit}
  .vehicle-store button,.vehicle-store input,.vehicle-store select{font:inherit;letter-spacing:inherit}
  .vehicle-store__product{width:min(1920px,calc(100% - 64px));margin:0 auto;padding-top:32px;display:grid;grid-template-columns:minmax(0,1fr) minmax(500px,1fr);gap:clamp(32px,3vw,64px);align-items:start}
  .vehicle-gallery{position:sticky;top:0;aspect-ratio:1/1;height:auto;min-height:0;padding:0;background:#fff;display:block;overflow:hidden}
  .vehicle-media-window{height:100%;min-height:0;background:#fff;display:grid}
  .vehicle-gallery__stage{position:relative;width:100%;height:100%;min-height:0;display:grid;place-items:center;overflow:hidden;background:#fff}.vehicle-gallery__stage.is-option-main{background:#060709}.vehicle-gallery__stage.is-option-main .vehicle-gallery__hero{width:100%;height:100%;max-width:100%;max-height:100%;padding:0;object-fit:contain}
  .vehicle-gallery__hero{position:absolute;inset:0;width:100%;height:100%;padding:0;object-fit:contain;transition:opacity .2s ease}
  .vehicle-gallery__empty{display:flex;flex-direction:column;gap:8px;text-align:center;color:#777}.vehicle-gallery__empty strong{font-size:24px;line-height:28px;font-weight:600;letter-spacing:-.03em;color:#333}
  .vehicle-gallery__stage-arrow{position:absolute;top:50%;z-index:2;display:grid;place-items:center;width:46px;height:46px;transform:translateY(-50%);padding:0;border:0;border-radius:50%;background:rgba(35,38,42,.78);color:#fff;font-size:32px;line-height:1;cursor:pointer;transition:opacity .2s ease}.vehicle-gallery__stage-arrow--previous{left:14px}.vehicle-gallery__stage-arrow--next{right:14px}.vehicle-gallery__stage-arrow:disabled{opacity:.28;cursor:default}
  .vehicle-gallery__video-wrap{position:absolute;inset:0;background:#0b0c0d}.vehicle-gallery__video-wrap[hidden]{display:none}.vehicle-gallery__video{width:100%;height:100%;object-fit:contain;background:#0b0c0d}
  .vehicle-gallery__thumbnail-rail{position:absolute;left:50%;bottom:24px;z-index:4;width:min(calc(100% - 160px),520px);height:78px;transform:translateX(-50%);overflow:hidden;isolation:isolate;border:1px solid rgba(255,255,255,.48);border-radius:14px;background:rgba(255,255,255,.7);box-shadow:0 12px 30px rgba(15,18,22,.16);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}.vehicle-gallery__thumbnail-rail:before,.vehicle-gallery__thumbnail-rail:after{display:none}.vehicle-gallery__thumbnails{position:relative;z-index:1;height:100%;display:flex;align-items:center;gap:10px;overflow-x:auto;padding:8px 44px;scroll-snap-type:x proximity;scrollbar-width:none}.vehicle-gallery__thumbnails::-webkit-scrollbar{display:none}
  .vehicle-gallery__thumbnail{position:relative;flex:0 0 82px;height:60px;padding:0;border:2px solid transparent;border-radius:8px;overflow:hidden;background:#f4f5f6;opacity:.7;cursor:pointer;scroll-snap-align:start;transition:opacity .2s ease,border-color .2s ease,transform .2s ease}.vehicle-gallery__thumbnail[hidden]{display:none}.vehicle-gallery__thumbnail:hover,.vehicle-gallery__thumbnail:focus-visible{opacity:1}.vehicle-gallery__thumbnail.is-active{border-color:var(--blue);opacity:1;transform:translateY(-1px)}.vehicle-gallery__thumbnail img{display:block;width:100%;height:100%;object-fit:cover}.vehicle-gallery__thumbnail--video{display:grid;place-items:center;color:#fff;background:#0b0c0d;font-size:12px;line-height:16px;letter-spacing:-.02em}.vehicle-gallery__thumbnail--video img{opacity:.75}.vehicle-gallery__play{position:absolute;left:50%;top:50%;display:grid;place-items:center;width:30px;height:30px;transform:translate(-50%,-50%);border-radius:50%;background:rgba(22,24,27,.84);color:#fff;font-size:11px;line-height:14px;letter-spacing:-.02em;text-indent:2px}
  .vehicle-gallery__thumbnail-previous,.vehicle-gallery__thumbnail-next{position:absolute;top:50%;z-index:3;width:38px;height:50px;transform:translateY(-50%);border:0;background:rgba(255,255,255,.74);color:#202326;font-size:28px;line-height:38px;cursor:pointer;transition:opacity .2s ease}.vehicle-gallery__thumbnail-previous{left:0;border-radius:0 25px 25px 0}.vehicle-gallery__thumbnail-next{right:0;border-radius:25px 0 0 25px}.vehicle-gallery__thumbnail-previous:disabled,.vehicle-gallery__thumbnail-next:disabled{opacity:.24;cursor:default}
  .vehicle-buy{min-width:0;padding:54px clamp(44px,4vw,76px) 80px}.vehicle-buy__inner{width:620px;max-width:100%}.vehicle-buy h1{font-size:24px;font-weight:600;line-height:28px;letter-spacing:-.03em;margin:0 0 28px;color:#333}
