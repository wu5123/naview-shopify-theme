{% comment %}Cleardrive rear-view visibility comparison poster.{% endcomment %}

<section class="cleardrive-visibility-poster" aria-label="Digital rear-view visibility comparison">
  <div class="cleardrive-visibility-poster__header">
    <div class="cleardrive-visibility-poster__container">
      <h2 class="cleardrive-visibility-poster__heading">Why choose us</h2>
    </div>
  </div>

  <div class="cleardrive-visibility-poster__media">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset="{{ 'cleardrive-rearview-visibility-comparison-mobile.png' | asset_url }}"
        width="1122"
        height="1402"
      >
      <img
        class="cleardrive-visibility-poster__image"
        src="{{ 'cleardrive-rearview-visibility-comparison.png' | asset_url }}"
        alt="Digital rear-view mirror with a clear rear-camera view compared with obstructed conventional mirror views"
        width="2172"
        height="724"
        loading="eager"
      >
    </picture>

    <div class="cleardrive-visibility-poster__copy">
      <h3 class="cleardrive-visibility-poster__title">{{ section.settings.poster_title | escape }}</h3>
      <p class="cleardrive-visibility-poster__text">{{ section.settings.poster_text | escape | newline_to_br }}</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .cleardrive-visibility-poster {
    width: 100%;
    margin: 0;
    overflow: hidden;
    background: #ffffff;
    font-family:
      "Open Sans",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Arial,
      sans-serif;
  }

  .cleardrive-visibility-poster__header {
    padding: 32px 24px 32px;
  }

  .cleardrive-visibility-poster__container {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }

  .cleardrive-visibility-poster__heading {
    margin: 0;
    color: #071b3e;
    font-size: clamp(34px, 3vw, 40px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
    text-align: left;
  }

  .cleardrive-visibility-poster__media {
    position: relative;
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto 16px;
    aspect-ratio: 3 / 1;
    overflow: hidden;
    background: #050505;
  }

  .cleardrive-visibility-poster picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cleardrive-visibility-poster__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cleardrive-visibility-poster__copy {
    position: absolute;
    z-index: 1;
    bottom: clamp(20px, 2.5vw, 34px);
    left: clamp(20px, 3vw, 42px);
    width: min(42%, 430px);
    color: #ffffff;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.72);
  }

  .cleardrive-visibility-poster__title {
    margin: 0;
    font-size: clamp(24px, 2.35vw, 38px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .cleardrive-visibility-poster__text {
    margin: 14px 0 0;
    font-size: clamp(13px, 1.1vw, 17px);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  @media screen and (max-width: 767px) {
    .cleardrive-visibility-poster__header {
      padding: 16px 20px 24px;
    }

    .cleardrive-visibility-poster__heading {
      font-size: 30px;
    }

    .cleardrive-visibility-poster__media {
      aspect-ratio: 4 / 5;
    }

    .cleardrive-visibility-poster__copy {
      top: 30%;
      right: 20px;
      bottom: auto;
      left: 20px;
      width: auto;
    }

    .cleardrive-visibility-poster__title {
      font-size: clamp(18px, 5vw, 20px);
      line-height: 1;
      letter-spacing: -0.065em;
      white-space: nowrap;
    }

    .cleardrive-visibility-poster__text {
      margin-top: 10px;
      font-size: 14px;
      line-height: 1.4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cleardrive view poster",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "poster_title",
      "label": "Poster title",
      "default": "FULL CARGO. FULL REAR VIEW."
    },
    {
      "type": "textarea",
      "id": "poster_text",
      "label": "Poster description",
      "default": "See the road behind you—even when your rear window is blocked by car seats, tools, or cargo."
    }
  ],
  "presets": [
    {
      "name": "Cleardrive view poster"
    }
  ]
}
{% endschema %}
