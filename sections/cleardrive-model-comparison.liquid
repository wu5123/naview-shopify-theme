<section class="cleardrive-comparison" aria-labelledby="comparison-title-{{ section.id }}">
  <header class="cleardrive-comparison__header">
    <h1 id="comparison-title-{{ section.id }}">{{ section.settings.heading | default: page.title | escape }}</h1>
    {% if section.settings.intro != blank %}<div class="cleardrive-comparison__intro">{{ section.settings.intro }}</div>{% endif %}
  </header>

  <div class="cleardrive-comparison__models" aria-label="ClearDrive models">
    {% assign model_names = 'Pro,Max,Ultra' | split: ',' %}
    {% for model_name in model_names %}
      {% assign model_key = model_name | downcase %}
      {% assign image_key = model_key | append: '_image' %}
      <div class="cleardrive-comparison__model">
        {% if section.settings[image_key] != blank %}
          {{ section.settings[image_key] | image_url: width: 900 | image_tag: widths: '240, 480, 900', sizes: '(min-width: 750px) 280px, 28vw', alt: model_name, loading: 'lazy' }}
        {% else %}
          {% if model_key == 'pro' %}{% assign model_asset = 'cleardrive-family-pro.webp' %}{% else %}{% assign model_asset = 'cleardrive-family-max-ultra.webp' %}{% endif %}
          <img src="{{ model_asset | asset_url }}" width="1000" height="{{ model_key | replace: 'pro', '341' | replace: 'max', '333' | replace: 'ultra', '333' }}" alt="ClearDrive {{ model_name }}" loading="lazy">
        {% endif %}
        <h2>ClearDrive {{ model_name }}</h2>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="cleardrive-comparison__table-wrap" role="region" aria-label="Model specification comparison" tabindex="0">
      <table>
        <caption class="visually-hidden">Compare ClearDrive Pro, Max and Ultra</caption>
        <thead><tr><th scope="col">Feature</th><th scope="col">Pro</th><th scope="col">Max</th><th scope="col">Ultra</th></tr></thead>
        <tbody>
          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label | escape }}</th>
              <td>{{ block.settings.pro | escape | newline_to_br }}</td>
              <td>{{ block.settings.max | escape | newline_to_br }}</td>
              <td>{{ block.settings.ultra | escape | newline_to_br }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
  {% if page.content != blank %}<div class="cleardrive-comparison__content rte">{{ page.content }}</div>{% endif %}
  {% if section.settings.additional_content != blank %}<div class="cleardrive-comparison__content rte">{{ section.settings.additional_content }}</div>{% endif %}
</section>

{% stylesheet %}
  .cleardrive-comparison{max-width:1100px;margin:0 auto;padding:60px 28px 80px;color:#1d232a}
  .cleardrive-comparison__header{text-align:center;margin-bottom:48px}
  .cleardrive-comparison h1{font-size:34px;line-height:1.25;font-weight:600;margin:0;letter-spacing:-.025em}
  .cleardrive-comparison__intro{font-size:16px;line-height:1.6;color:#636970;margin-top:14px}
  .cleardrive-comparison__intro p{margin:0}
  .cleardrive-comparison__models{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;max-width:900px;margin:0 auto 48px;text-align:center}
  .cleardrive-comparison__model img{display:block;width:100%;height:auto;aspect-ratio:2.7/1;object-fit:contain}
  .cleardrive-comparison__model h2{font-size:18px;line-height:1.4;font-weight:500;margin:18px 0 0}
  .cleardrive-comparison__table-wrap{overflow-x:auto}
  .cleardrive-comparison table{border-collapse:collapse;width:100%;table-layout:fixed;font-size:14px;line-height:1.6}
  .cleardrive-comparison th,.cleardrive-comparison td{padding:20px 16px;border-bottom:1px solid #e5e7e9;text-align:center;vertical-align:top;overflow-wrap:anywhere}
  .cleardrive-comparison thead th{background:#f6f7f8;font-weight:600}
  .cleardrive-comparison tbody th{text-align:left;font-weight:500}
  .cleardrive-comparison__content{margin-top:36px;font-size:15px;line-height:1.75}
  @media(max-width:749px){.cleardrive-comparison{padding:36px 18px 52px}.cleardrive-comparison h1{font-size:26px}.cleardrive-comparison__header{margin-bottom:36px}.cleardrive-comparison__models{gap:12px;margin-bottom:32px}.cleardrive-comparison__model h2{font-size:13px;margin-top:12px}.cleardrive-comparison__intro{font-size:14px}.cleardrive-comparison table{min-width:580px}.cleardrive-comparison th,.cleardrive-comparison td{padding:16px 12px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Compare three models",
  "max_blocks": 24,
  "settings": [
    {"type":"text","id":"heading","label":"Page heading","default":"Compare ClearDrive models"},
    {"type":"richtext","id":"intro","label":"Introduction","default":"<p>Explore Pro, Max and Ultra.</p>"},
    {"type":"image_picker","id":"pro_image","label":"Pro image"},
    {"type":"image_picker","id":"max_image","label":"Max image"},
    {"type":"image_picker","id":"ultra_image","label":"Ultra image"},
    {"type":"richtext","id":"additional_content","label":"Additional content"}
  ],
  "blocks": [{
    "type":"comparison_row",
    "name":"Comparison row",
    "settings":[
      {"type":"text","id":"label","label":"Feature name","default":"Feature"},
      {"type":"textarea","id":"pro","label":"Pro"},
      {"type":"textarea","id":"max","label":"Max"},
      {"type":"textarea","id":"ultra","label":"Ultra"}
    ]
  }],
  "presets":[{"name":"Compare three models"}]
}
{% endschema %}
