        "step_prepare": {
          "type":"step",
          "settings":{
            "phase":"prepare",
            "step_number":"1",
            "title":"Prepare the vehicle",
            "body":"<ol><li>Park on a level surface, switch the ignition off, apply the parking brake, and open the liftgate.</li><li>Disconnect the negative 12-V battery terminal and wait at least 3 minutes before working near overhead trim or SRS components.</li><li>Protect the windshield, dashboard, and trim with a clean cloth. Confirm all supplied parts are present.</li></ol>",
            "image_alt":"ClearDrive mirror ready for installation",
            "fallback_asset":"self-install-crv-mirror.png",
            "show_wiring_diagram":false
          }
        },
        "step_remove_mirror": {
          "type":"step",
          "settings":{
            "phase":"prepare",
            "step_number":"2",
            "title":"Remove the original rearview mirror",
            "body":"<ol><li>Release the trim shroud around the original mirror base with a plastic trim tool.</li><li>Support the mirror, loosen the mount fastener with the correct driver or bit, then slide the mirror off the windshield mount.</li><li>Disconnect any factory mirror connector by its locking tab, never by pulling the wires.</li></ol>",
            "warning":"Do not twist the mirror or pry against the windshield glass.",
            "image_alt":"Removing the original Honda CR-V rearview mirror",
            "fallback_asset":"self-install-crv-remove-mirror.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_install_mirror": {
          "type":"step",
          "settings":{
            "phase":"mirror",
            "step_number":"3",
            "title":"Install the ClearDrive mirror and front camera housing",
            "body":"<ol><li>Position the vehicle-specific mount and front camera housing at the factory mirror location.</li><li>Slide the ClearDrive mirror onto the mount and tighten the retaining fastener until secure.</li><li>Route the mirror leads upward behind the housing, leaving enough slack for normal mirror adjustment.</li></ol>",
            "warning":"Tighten only enough to secure the mirror. Overtightening can damage the mount or windshield.",
            "image_alt":"Installing the ClearDrive mirror and front camera housing",
            "fallback_asset":"self-install-crv-install-mirror.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_console": {
          "type":"step",
          "settings":{
            "phase":"mirror",
            "step_number":"4",
            "title":"Lower the overhead console",
            "body":"<ol><li>Open the sunglass holder and use a plastic trim tool to release the overhead console clips.</li><li>Support the console as it lowers.</li><li>Press the locking tab to disconnect the factory plug.</li></ol>",
            "warning":"Never pull on the factory wires when releasing a connector.",
            "image_alt":"Releasing the Honda CR-V overhead console",
            "fallback_asset":"self-install-crv-lower-console.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_harness": {
          "type":"step",
          "settings":{
            "phase":"mirror",
            "step_number":"5",
            "title":"Install the vehicle-specific power harness",
            "body":"<ol><li>Insert the ClearDrive T-harness between the factory roof connector and the overhead console connector.</li><li>Connect the dedicated mirror power lead. Match keyed plugs by shape and color and do not force a connector.</li><li>Confirm that every locking tab is fully seated.</li></ol><p>No factory wire cutting or splicing is required.</p>",
            "show_wiring_diagram":true
          }
        },
        "step_connect_extension": {
          "type":"step",
          "settings":{
            "phase":"mirror",
            "step_number":"6",
            "title":"Connect the rear camera extension cable",
            "body":"<ol><li>Join the matching mirror and video extension connectors until fully seated.</li><li>Secure the connection so it cannot rattle, then place the excess harness above the headliner without pinching it.</li><li>Reconnect and press the overhead console into place until every clip is seated.</li></ol>",
            "image_alt":"Connecting the ClearDrive rear camera extension cable",
            "fallback_asset":"self-install-crv-connect-cable.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_front_headliner": {
          "type":"step",
          "settings":{
            "phase":"cable",
            "step_number":"7",
            "title":"Hide the cable at the front headliner",
            "body":"<ol><li>Leave a small service loop at the mirror so it can be adjusted without pulling the cable.</li><li>Use a plastic trim tool to tuck the extension cable above the front edge of the headliner.</li><li>Keep the cable clear of the windshield camera, sensors, and sun visor hardware.</li></ol>",
            "image_alt":"ClearDrive cable routed at the front headliner",
            "fallback_asset":"self-install-crv-front-headliner.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_roofline": {
          "type":"step",
          "settings":{
            "phase":"cable",
            "step_number":"8",
            "title":"Route along the passenger-side roofline",
            "body":"<ol><li>Continue the cable rearward behind the headliner and upper door seals.</li><li>Use existing factory harness paths where possible and secure loose sections with fabric tape or cable ties.</li><li>Avoid sharp edges, moving trim, and all side-curtain airbag deployment paths.</li></ol>",
            "warning":"Route behind the airbag path, never between an airbag and the occupant.",
            "image_alt":"Cable routing along the Honda CR-V passenger-side roofline",
            "fallback_asset":"self-install-crv-roofline.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_liftgate_entry": {
          "type":"step",
          "settings":{
            "phase":"cable",
            "step_number":"9",
            "title":"Bring the extension cable to the liftgate",
            "body":"<ol><li>At the rear headliner, pull back only enough weatherstrip to access the factory cable route.</li><li>Guide the extension cable into the upper liftgate area. Use a fish tape if needed and protect the connector while pulling.</li><li>Confirm the cable is not trapped under the weatherstrip or trim clips.</li></ol>",
            "image_alt":"Guiding the rear camera cable into the Honda CR-V liftgate",
            "fallback_asset":"self-install-crv-liftgate-entry.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_upper_trim": {
          "type":"step",
          "settings":{
            "phase":"rear",
            "step_number":"10",
            "title":"Access the upper liftgate",
            "body":"<ol><li>Open and support the liftgate.</li><li>Release the upper interior trim panel with a plastic trim tool, working evenly from one end to the other.</li><li>Set the panel on a clean surface and identify the factory route to the third brake light.</li></ol>",
            "image_alt":"Removing the upper Honda CR-V liftgate trim",
            "fallback_asset":"self-install-crv-upper-trim.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_feed_liftgate": {
          "type":"step",
          "settings":{
            "phase":"rear",
            "step_number":"11",
            "title":"Feed the camera cable through the liftgate",
            "body":"<ol><li>Route the video extension through the factory liftgate opening or rubber wiring boot.</li><li>Pull only from the protected cable body. Never pull directly on a connector or bend it sharply.</li><li>Reseat the rubber boot or grommet completely to preserve the water seal.</li></ol>",
            "warning":"A loose grommet can allow water into the liftgate. Inspect the complete sealing lip.",
            "image_alt":"Feeding the ClearDrive camera cable through the liftgate",
            "fallback_asset":"self-install-crv-feed-liftgate.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_remove_light": {
          "type":"step",
          "settings":{
            "phase":"rear",
            "step_number":"12",
            "title":"Remove the original third brake light",
            "body":"<ol><li>Remove the factory brake-light fasteners from inside the liftgate and retain them for reuse.</li><li>Press the locking tab and disconnect the original brake-light plug.</li><li>From outside the vehicle, support and remove the lamp assembly without scratching the painted spoiler.</li></ol>",
            "image_alt":"Removing the original Honda CR-V third brake light",
            "fallback_asset":"self-install-crv-remove-brake-light.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_camera_light": {
          "type":"step",
          "settings":{
            "phase":"rear",
            "step_number":"13",
            "title":"Install the ClearDrive camera brake light",
            "body":"<ol><li>Clean the mounting surface and confirm the supplied seal is correctly positioned.</li><li>Connect the factory brake-light plug and the ClearDrive camera lead.</li><li>Position the assembly in the original opening and install the retained fasteners evenly.</li></ol>",
            "warning":"Do not overtighten plastic mounting points.",
            "image_alt":"Installing the ClearDrive third brake light camera",
            "fallback_asset":"self-install-crv-install-camera-light.jpg",
            "show_wiring_diagram":false
          }
        },
        "step_test": {
          "type":"step",
          "settings":{
            "phase":"rear",
            "step_number":"14",
            "title":"Reassemble and test the system",
            "body":"<ol><li>Secure all cable slack away from hinges, gas struts, clips, and latch mechanisms, then reinstall every trim panel and weatherstrip.</li><li>Reconnect the negative battery terminal and switch the ignition to ACC.</li><li>Verify front and rear camera views, confirm the third brake light illuminates, and make sure the rear image is level and unobstructed.</li></ol>",
            "image_alt":"ClearDrive rear camera image after installation",
            "fallback_asset":"self-install-crv-test-image.jpg",
            "show_wiring_diagram":false
          }
        },

